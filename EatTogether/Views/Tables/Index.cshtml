@model IEnumerable<EatTogether.Models.DTOs.TableDto>
@using EatTogether.Models.DTOs
@{
    ViewData["Title"] = "桌位管理";
    var pendingReservations = ViewBag.PendingReservations as List<ReservationDto> ?? new List<ReservationDto>();
    var pendingWalkIns      = ViewBag.PendingWalkIns      as List<WalkInQueueDto> ?? new List<WalkInQueueDto>();
    int pendingTotal = pendingReservations.Count + pendingWalkIns.Count;
}

<div class="container-fluid px-4">
    <h1 class="mt-4">桌位管理</h1>

    <!-- ═══ 今日待安排區塊 ═══ -->
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-clock me-1"></i>
                <strong>今日待安排</strong>
                @if (pendingTotal > 0)
                {
                    <span class="badge bg-danger ms-2">@pendingTotal</span>
                }
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Reservations" asp-action="Index" class="btn btn-sm btn-outline-dark">
                    <i class="fas fa-calendar-check me-1"></i>訂位管理
                </a>
                <a asp-controller="WalkInQueues" asp-action="Index" class="btn btn-sm btn-dark">
                    <i class="fas fa-walking me-1"></i>候位管理
                </a>
            </div>
        </div>
        <div class="card-body p-3">
            @if (pendingTotal == 0)
            {
                <div class="text-center text-muted py-2">
                    <i class="fas fa-check-circle me-1 text-success"></i>目前沒有待安排的訂位或候位
                </div>
            }
            else
            {
                <div class="row g-2">
                    @* ── 訂位 ── *@
                    @foreach (var r in pendingReservations)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="card h-100 border-start border-primary border-3">
                                <div class="card-body py-2 px-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="badge bg-primary">訂位</span>
                                        <small class="text-muted">@r.ReservationDate.ToString("HH:mm")</small>
                                    </div>
                                    <div class="fw-semibold mt-1">@r.Name</div>
                                    <div class="small text-muted">
                                        <i class="fas fa-users me-1"></i>@(r.AdultsCount + r.ChildrenCount) 人
                                        @if (r.ChildrenCount > 0)
                                        {
                                            <span class="ms-1">(大 @r.AdultsCount 小 @r.ChildrenCount)</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(r.Remark))
                                    {
                                        <div class="small text-secondary text-truncate" title="@r.Remark">
                                            <i class="fas fa-comment-alt me-1"></i>@r.Remark
                                        </div>
                                    }
                                    <div class="small text-muted mt-1">
                                        <i class="fas fa-hashtag me-1"></i>@r.BookingNumber
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @* ── 候位 ── *@
                    @foreach (var w in pendingWalkIns)
                    {
                        var cardColor = w.Status == 0 ? "success" : "warning";
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="card h-100 border-start border-@cardColor border-3">
                                <div class="card-body py-2 px-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="badge @w.StatusBadgeClass">候位 @w.QueueNumber</span>
                                        <small class="text-muted">登記 @w.RegisteredAt.ToString("HH:mm")</small>
                                    </div>
                                    <div class="fw-semibold mt-1">@w.Name</div>
                                    <div class="small text-muted">
                                        <i class="fas fa-users me-1"></i>@w.TotalCount 人
                                        @if (w.ChildrenCount > 0)
                                        {
                                            <span class="ms-1">(大 @w.AdultsCount 小 @w.ChildrenCount)</span>
                                        }
                                    </div>
                                    @if (w.Status == 1 && w.CalledAt.HasValue)
                                    {
                                        <div class="small text-warning fw-semibold">
                                            <i class="fas fa-bell me-1"></i>已叫號 @w.CalledAt.Value.ToString("HH:mm")
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(w.Remark))
                                    {
                                        <div class="small text-secondary text-truncate" title="@w.Remark">
                                            <i class="fas fa-comment-alt me-1"></i>@w.Remark
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- 統計卡片 -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div><div class="small">桌位總數</div><div class="fs-4 fw-bold">@Model.Count()</div></div>
                    <i class="fas fa-border-all fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div><div class="small">空桌</div><div class="fs-4 fw-bold">@Model.Count(t => t.Status == 0)</div></div>
                    <i class="fas fa-check-circle fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark mb-4">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div><div class="small">用餐中</div><div class="fs-4 fw-bold">@Model.Count(t => t.Status == 1)</div></div>
                    <i class="fas fa-utensils fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-secondary text-white mb-4">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div><div class="small">保留中</div><div class="fs-4 fw-bold">@Model.Count(t => t.Status == 2)</div></div>
                    <i class="fas fa-lock fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- 篩選 + 新增 -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fas fa-filter me-1"></i>篩選桌位</div>
            <a asp-action="Create" class="btn btn-success btn-sm">
                <i class="fas fa-plus me-1"></i>新增桌位
            </a>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-auto"><label class="col-form-label">狀態</label></div>
                <div class="col-auto">
                    <select class="form-select form-select-sm" id="statusFilter" onchange="filterTiles()">
                        <option value="">全部</option>
                        <option value="0">空桌</option>
                        <option value="1">用餐中</option>
                        <option value="2">保留</option>
                    </select>
                </div>
                <div class="col-auto"><label class="col-form-label">座位數</label></div>
                <div class="col-auto">
                    <select class="form-select form-select-sm" id="seatFilter" onchange="filterTiles()">
                        <option value="">全部</option>
                        <option value="2">2 人桌</option>
                        <option value="4">4 人桌</option>
                        <option value="6">6 人桌</option>
                        <option value="10">10 人包廂</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- 桌位磚塊 -->
    <div id="alertBox"></div>
    <div class="row row-cols-xl-5 row-cols-lg-4 row-cols-md-3 row-cols-sm-2 g-3" id="tileGrid">
        @foreach (var table in Model)
        {
            var borderColor = table.Status == 0 ? "success" : table.Status == 1 ? "warning" : "secondary";
            <div class="col table-tile" data-status="@table.Status" data-seats="@table.SeatCount">
                <div class="card h-100 border-@borderColor" style="border-top: 4px solid;">
                    <div class="card-body text-center p-3">

                        <!-- 桌位標題 -->
                        <div class="fs-4 fw-bold text-dark">@table.TableName</div>
                        <div class="small text-muted mb-2">@table.SeatCount 人桌</div>
                        <span class="badge @table.StatusBadgeClass mb-3 align-self-center">@table.StatusText</span>

                        <!-- 固定四格，每格高度相同 -->
                        <div class="d-flex flex-column gap-1">

                            <!-- 第1格：設為用餐中 / 結帳 -->
                            <div style="height:34px;">
                                @if (table.Status == 0)
                                {
                                    <button class="btn btn-warning btn-sm w-100 h-100"
                                            onclick="updateStatus(@table.Id, 1)">
                                        <i class="fas fa-utensils me-1"></i>設為用餐中
                                    </button>
                                }
                                else if (table.Status == 1)
                                {
                                    <a asp-controller="Payments" asp-action="Create"
                                       asp-route-tableId="@table.Id"
                                       class="btn btn-success btn-sm w-100 h-100">
                                        <i class="fas fa-cash-register me-1"></i>結帳
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-warning btn-sm w-100 h-100"
                                            onclick="updateStatus(@table.Id, 1)">
                                        <i class="fas fa-utensils me-1"></i>設為用餐中
                                    </button>
                                }
                            </div>

                            <!-- 第2格：設為保留 / 取消保留（空桌）-->
                            <div style="height:34px;">
                                @if (table.Status == 0)
                                {
                                    <button class="btn btn-outline-secondary btn-sm w-100 h-100"
                                            onclick="openReserveModal(@table.Id, '@table.TableName')">
                                        <i class="fas fa-lock me-1"></i>設為保留
                                    </button>
                                }
                                else if (table.Status == 1)
                                {
                                    <!-- 用餐中：第2格空白 -->
                                    <div class="w-100 h-100"></div>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm w-100 h-100"
                                            onclick="updateStatus(@table.Id, 0)">
                                        <i class="fas fa-unlock me-1"></i>取消保留（空桌）
                                    </button>
                                }
                            </div>

                            <!-- 第3格：保留原因（固定高度，有內容才顯示文字） -->
                            <div style="height:34px; overflow:hidden;">
                                @if (table.Status == 2 && !string.IsNullOrEmpty(table.Remark))
                                {
                                    <div class="small text-muted text-center px-1 h-100 d-flex align-items-center justify-content-center"
                                         style="overflow:hidden; white-space:nowrap; text-overflow:ellipsis;"
                                         title="@table.Remark">
                                        <span style="overflow:hidden; text-overflow:ellipsis;">@table.Remark</span>
                                    </div>
                                }
                            </div>

                            <!-- 第4格：編輯 / 刪除 -->
                            <div style="height:34px;">
                                <a asp-action="Edit" asp-route-id="@table.Id"
                                   class="btn btn-outline-primary btn-sm w-100 h-100">
                                    <i class="fas fa-edit me-1"></i>編輯
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- 設為保留 Modal -->
<div class="modal fade" id="reserveModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">
                    <i class="fas fa-lock me-1"></i>設為保留
                    <span id="reserveTableName" class="text-muted small ms-1"></span>
                </h6>
                <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <label class="form-label small fw-semibold">
                    保留說明 <span class="text-muted fw-normal">（選填）</span>
                </label>
                <textarea id="reserveRemarkInput" class="form-control form-control-sm" rows="3"
                          placeholder="如：設備維修中、留給晚宴、天氣因素暫停..."></textarea>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="confirmReserve()">確認設為保留</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let _reserveTableId = null;
        const reserveModal = new bootstrap.Modal(document.getElementById('reserveModal'));

        function openReserveModal(id, name) {
            _reserveTableId = id;
            document.getElementById('reserveTableName').textContent = name;
            document.getElementById('reserveRemarkInput').value = '';
            reserveModal.show();
        }

        function confirmReserve() {
            const remark = document.getElementById('reserveRemarkInput').value.trim() || null;
            reserveModal.hide();
            postUpdateStatus(_reserveTableId, 2, remark);
        }

        function updateStatus(id, status) {
            const confirms = { 0: '確認恢復空桌？', 1: '確認設為用餐中？' };
            if (!confirm(confirms[status])) return;
            postUpdateStatus(id, status, null);
        }

        function postUpdateStatus(id, status, remark) {
            fetch('/Tables/UpdateStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                },
                body: JSON.stringify({ id, status, remark })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showAlert('success', '狀態更新成功');
                    setTimeout(() => location.reload(), 800);
                } else {
                    showAlert('danger', data.message);
                }
            });
        }

        function filterTiles() {
            const status = document.getElementById('statusFilter').value;
            const seats  = document.getElementById('seatFilter').value;
            document.querySelectorAll('#tileGrid .table-tile').forEach(tile => {
                const sMatch  = !status || tile.dataset.status === status;
                const seMatch = !seats  || tile.dataset.seats  === seats;
                tile.style.display = (sMatch && seMatch) ? '' : 'none';
            });
        }

        function showAlert(type, message) {
            document.getElementById('alertBox').innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-triangle'} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
        }
    </script>
}
