@using EatTogether.Models.ViewModels
@model SchedulerDetailViewModel
@{
    ViewData["Title"] = "排程執行詳情";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h4 class="mb-0 fw-bold">排程執行詳情</h4>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>返回列表
        </a>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex gap-4 flex-wrap">
            <div>
                <div class="text-muted small">執行時間</div>
                <div class="fw-semibold">@Model.Log.ExecutedAt.ToString("yyyy/MM/dd HH:mm:ss")</div>
            </div>
            <div>
                <div class="text-muted small">觸發類型</div>
                <div>
                    @if (Model.Log.TriggerType == "手動")
                    {
                        <span class="badge rounded-pill" style="background-color:#fd7e14">手動</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-primary">自動</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-success bg-opacity-10 border-0">
                    <span class="fw-semibold text-success"><i class="bi bi-arrow-up-circle me-1"></i>餐點上架（@Model.DishesEnabled.Count）</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.DishesEnabled.Any())
                    {
                        <p class="text-muted text-center py-4 mb-0">無</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var name in Model.DishesEnabled)
                            {
                                <li class="list-group-item px-3">@name</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-danger bg-opacity-10 border-0">
                    <span class="fw-semibold text-danger"><i class="bi bi-arrow-down-circle me-1"></i>餐點下架（@Model.DishesDisabled.Count）</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.DishesDisabled.Any())
                    {
                        <p class="text-muted text-center py-4 mb-0">無</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var name in Model.DishesDisabled)
                            {
                                <li class="list-group-item px-3">@name</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-success bg-opacity-10 border-0">
                    <span class="fw-semibold text-success"><i class="bi bi-arrow-up-circle me-1"></i>套餐上架（@Model.MealsEnabled.Count）</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.MealsEnabled.Any())
                    {
                        <p class="text-muted text-center py-4 mb-0">無</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var name in Model.MealsEnabled)
                            {
                                <li class="list-group-item px-3">@name</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-danger bg-opacity-10 border-0">
                    <span class="fw-semibold text-danger"><i class="bi bi-arrow-down-circle me-1"></i>套餐下架（@Model.MealsDisabled.Count）</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.MealsDisabled.Any())
                    {
                        <p class="text-muted text-center py-4 mb-0">無</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var name in Model.MealsDisabled)
                            {
                                <li class="list-group-item px-3">@name</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
