@model IEnumerable<EatTogether.Models.ViewModels.ReviewManageViewModel>
@{
    ViewData["Title"] = "餐點留言管理";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">餐點留言管理</h1>

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@ViewBag.Success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 搜尋列 -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body py-3">
            <form method="get" action="/Reviews" class="d-flex align-items-center gap-2">
                <div class="input-group" style="max-width:340px;">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control border-start-0 ps-0"
                           placeholder="依餐點名稱搜尋…" />
                </div>
                <button type="submit" class="btn btn-primary px-4">搜尋</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a href="/Reviews" class="btn btn-outline-secondary">清除</a>
                }
            </form>
        </div>
    </div>

    <!-- 統計 -->
    <div class="d-flex gap-3 mb-4">
        <div class="card border-0 text-white flex-fill" style="background:#3b82f6; border-radius:10px;">
            <div class="card-body d-flex align-items-center justify-content-between py-3">
                <div>
                    <div style="font-size:11px; font-weight:600; opacity:.75; text-transform:uppercase; letter-spacing:.05em;">留言總筆數</div>
                    <div style="font-size:2rem; font-weight:700; margin-top:4px;">@Model.Count()</div>
                </div>
                <i class="fas fa-comments fa-2x" style="opacity:.35;"></i>
            </div>
        </div>
    </div>

    <!-- 留言列表 -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-dark text-white d-flex align-items-center py-3">
            <i class="fas fa-comments me-2"></i>
            <span class="fw-semibold">留言列表</span>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <span class="badge bg-info ms-2">篩選：@ViewBag.Search</span>
            }
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                    <span>目前沒有符合條件的留言</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:180px;">餐點名稱</th>
                                <th style="width:120px;">暱稱</th>
                                <th>留言內容</th>
                                <th style="width:170px;">留言時間</th>
                                <th style="width:80px;" class="text-center">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">@r.DishName</span>
                                    </td>
                                    <td>@r.Nickname</td>
                                    <td class="text-break">@r.Content</td>
                                    <td class="text-muted small">@r.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td class="text-center">
                                        <form method="post" action="/Reviews/Delete/@r.Id"
                                              onsubmit="return confirmDelete(event)">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="刪除此留言">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(e) {
            e.preventDefault();
            const form = e.currentTarget;
            Swal.fire({
                title: '確定刪除？',
                text: '此留言刪除後無法復原。',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '確定刪除',
                cancelButtonText: '取消'
            }).then(result => {
                if (result.isConfirmed) form.submit();
            });
            return false;
        }
    </script>
}
