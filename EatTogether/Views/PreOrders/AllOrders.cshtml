@model EatTogether.Models.ViewModels.PreOrderListQueryViewModel

@{
    ViewData["Title"] = "所有訂單";
}

<style>
    /* ── 整體佔滿視窗 ── */
    .ao-page {
        display: flex;
        flex-direction: column;
        height: 88.2vh;
        overflow: hidden;
        background: #f4f6f9;
    }

    /* ── 頂部標頭 ── */
    .ao-topbar {
        display: flex;
        align-items: center;
        padding: 12px 24px;
        background: #fff;
        border-bottom: 1px solid #e8e8e8;
        flex-shrink: 0;
    }

    .ao-topbar-title {
        font-size: 1.2rem;
        font-weight: 800;
        color: #1a1a1a;
    }

    /* ── 主體：左欄 + 右欄 ── */
    .ao-body {
        display: grid;
        grid-template-columns: 200px 1fr;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    /* ════ 左欄：搜尋篩選 ════ */
    .ao-filter-col {
        background: #fff;
        border-right: 1.5px solid #e8e8e8;
        overflow-y: auto;
        padding: 20px 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .filter-section-title {
        font-size: 0.7rem;
        font-weight: 800;
        color: #c0c0c0;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 2px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .filter-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: #bbb;
        text-transform: uppercase;
        letter-spacing: 0.07em;
    }

    .filter-input,
    .filter-select {
        width: 100%;
        padding: 8px 10px;
        border: 1.5px solid #ddd;
        border-radius: 9px;
        font-size: 0.88rem;
        font-family: inherit;
        color: #333;
        outline: none;
        transition: border-color 0.15s;
        background: #fff;
        box-sizing: border-box;
    }

        .filter-input:focus,
        .filter-select:focus {
            border-color: #c0392b;
        }

    .filter-sep {
        border: none;
        border-top: 1px solid #f0f0f0;
        margin: 0;
    }

    /* 狀態選項 */
    .status-option-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .status-option {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 9px;
        border: 1.5px solid #e8e8e8;
        background: #fff;
        font-size: 0.88rem;
        font-weight: 500;
        color: #666;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s;
    }

        .status-option:hover {
            border-color: #ccc;
            background: #f8f8f8;
        }

        .status-option.s-all    { border-color: #1a1a1a; background: #1a1a1a; color: #fff; font-weight: 700; }
        .status-option.s-0      { border-color: #e67e22; background: #fef9f0; color: #e67e22; font-weight: 700; }
        .status-option.s-1      { border-color: #27ae60; background: #f0fff4; color: #27ae60; font-weight: 700; }
        .status-option.s-2      { border-color: #e74c3c; background: #fff5f5; color: #e74c3c; font-weight: 700; }

    .btn-search {
        width: 100%;
        padding: 9px;
        background: #c0392b;
        color: #fff;
        border: none;
        border-radius: 9px;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s;
    }

        .btn-search:hover { background: #a93226; }

    .btn-reset {
        width: 100%;
        padding: 9px;
        background: #fff;
        color: #888;
        border: 1.5px solid #ddd;
        border-radius: 9px;
        font-family: inherit;
        font-size: 0.88rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s;
        text-decoration: none;
        text-align: center;
        display: block;
        box-sizing: border-box;
    }

        .btn-reset:hover { border-color: #aaa; color: #444; }

    /* ════ 右欄 ════ */
    .ao-right-col {
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
        padding: 16px 20px;
        gap: 10px;
    }

    /* 右欄標頭列 */
    .ao-right-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-shrink: 0;
    }

    .ao-right-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a1a;
    }

    .ao-result-count {
        font-size: 0.82rem;
        color: #aaa;
    }

    /* 表格卡片 */
    .ao-table-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #ebebeb;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
    }

    .ao-table-scroll {
        overflow-y: auto;
        flex: 1;
        min-height: 0;
    }

    .ao-table {
        width: 100%;
        border-collapse: collapse;
    }

        .ao-table thead th {
            padding: 8px 8px;
            background: #f8f9fa;
            font-size: 0.7rem;
            font-weight: 700;
            color: #bbb;
            text-align: left;
            letter-spacing: 0.04em;
            border-bottom: 1px solid #efefef;
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 1;
        }

            .ao-table thead th:last-child { text-align: center; }

        .ao-table tbody td {
            padding: 8px 8px;
            font-size: 0.8rem;
            color: #333;
            border-bottom: 1px solid #f6f6f6;
            vertical-align: middle;
            white-space: nowrap;
        }

        .ao-table tbody tr:last-child td { border-bottom: none; }

        .ao-table tbody tr:hover td { background: #fafafa; }

    .order-num-cell {
        font-weight: 700;
        color: #1a1a1a;
        font-size: 0.8rem;
    }

    .tag {
        display: inline-block;
        padding: 1px 7px;
        border-radius: 8px;
        font-size: 0.74rem;
        font-weight: 600;
    }

    .tag-dine    { background: #eaf0fb; color: #2561a8; }
    .tag-takeout { background: #f0f0f0; color: #666; }

    .pay-text { font-size: 0.75rem; color: #888; }

    .badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-pending { background: #fff3cd; color: #856404; }
    .badge-done    { background: #d1f5e0; color: #1a6b3a; }
    .badge-cancel  { background: #f8d7da; color: #842029; }

    .amount-main   { font-weight: 700; color: #1a1a1a; }
    .amount-disc   { font-size: 0.78rem; color: #27ae60; }

    .btn-detail {
        padding: 4px 10px;
        background: #fff;
        color: #c0392b;
        border: 1.5px solid #c0392b;
        border-radius: 7px;
        font-family: inherit;
        font-size: 0.74rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-detail:hover { background: #fff5f5; }

    /* 空白狀態 */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #ccc;
    }

        .empty-state .icon { font-size: 2.5rem; margin-bottom: 10px; }
        .empty-state p     { font-size: 0.9rem; }

    /* 分頁 */
    .ao-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 5px;
        padding: 10px 0 0;
        flex-shrink: 0;
    }

    .page-btn {
        padding: 6px 12px;
        border-radius: 8px;
        border: 1.5px solid #ddd;
        background: #fff;
        font-family: inherit;
        font-size: 0.85rem;
        font-weight: 500;
        color: #555;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s;
        display: inline-block;
    }

        .page-btn:hover   { border-color: #c0392b; color: #c0392b; }
        .page-btn.active  { background: #c0392b; border-color: #c0392b; color: #fff; font-weight: 700; }
        .page-btn.disabled { opacity: 0.4; pointer-events: none; }
</style>

<div class="ao-page">

    @* ── 頂部標頭 *@
    <div class="ao-topbar">
        <div class="ao-topbar-title">📋 所有訂單</div>
    </div>

    @* ── 主體 *@
    <div class="ao-body">

        @* ════ 左欄：搜尋篩選 ════ *@
        <form method="get" asp-action="AllOrders" style="display:contents;">
            <div class="ao-filter-col">

                <div class="filter-section-title">搜尋</div>

                <div class="filter-group">
                    <div class="filter-label">關鍵字</div>
                    <input type="text" class="filter-input" name="Keyword"
                           placeholder="訂單編號、會員、桌號..."
                           value="@Model.Keyword" />
                </div>

                <div class="filter-group">
                    <div class="filter-label">日期起</div>
                    <input type="date" class="filter-input" name="DateFrom"
                           value="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                <div class="filter-group">
                    <div class="filter-label">日期迄</div>
                    <input type="date" class="filter-input" name="DateTo"
                           value="@Model.DateTo?.ToString("yyyy-MM-dd")"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                <hr class="filter-sep" />

                <div class="filter-section-title">狀態</div>

                <div class="status-option-list">
                    <a href="@Url.Action("AllOrders", new { DateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"), DateTo = Model.DateTo?.ToString("yyyy-MM-dd"), Keyword = Model.Keyword, Page = 1 })"
                       class="status-option @(Model.Status == null ? "s-all" : "")">全部</a>
                    <a href="@Url.Action("AllOrders", new { Status = 0, DateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"), DateTo = Model.DateTo?.ToString("yyyy-MM-dd"), Keyword = Model.Keyword, Page = 1 })"
                       class="status-option @(Model.Status == 0 ? "s-0" : "")">⏳ 未完成</a>
                    <a href="@Url.Action("AllOrders", new { Status = 1, DateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"), DateTo = Model.DateTo?.ToString("yyyy-MM-dd"), Keyword = Model.Keyword, Page = 1 })"
                       class="status-option @(Model.Status == 1 ? "s-1" : "")">✅ 已完成</a>
                    <a href="@Url.Action("AllOrders", new { Status = 2, DateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"), DateTo = Model.DateTo?.ToString("yyyy-MM-dd"), Keyword = Model.Keyword, Page = 1 })"
                       class="status-option @(Model.Status == 2 ? "s-2" : "")">❌ 已取消</a>
                </div>

                <input type="hidden" name="Status" value="@Model.Status" />
                <input type="hidden" name="Page" value="1" />

                <hr class="filter-sep" />

                <button type="submit" class="btn-search">🔍 搜尋</button>
                <a href="@Url.Action("AllOrders")" class="btn-reset">✕ 重置</a>

            </div>
        </form>

        @* ════ 右欄 ════ *@
        <div class="ao-right-col">

            <div class="ao-right-head">
                <div style="display:flex;align-items:center;gap:10px;">
                    <div class="ao-right-title">所有訂單</div>
                    <button id="sortToggleBtn" onclick="toggleSortOrder()"
                            style="padding:3px 10px;border:1.5px solid #1a77c9;border-radius:6px;
                                   background:#fff;color:#1a77c9;font-family:inherit;
                                   font-weight:600;font-size:0.78rem;cursor:pointer;
                                   transition:all 0.15s;white-space:nowrap;"
                            onmouseover="this.style.background='#eaf0fb'"
                            onmouseout="this.style.background='#fff'">
                        ↓ 最新優先
                    </button>
                </div>
                <div class="ao-result-count">共 @Model.TotalCount 筆</div>
            </div>

            <div class="ao-table-card">
                <div class="ao-table-scroll">
                    @if (!Model.Orders.Any())
                    {
                        <div class="empty-state">
                            <div class="icon">📭</div>
                            <p>沒有符合條件的訂單</p>
                        </div>
                    }
                    else
                    {
                        <table class="ao-table">
                            <thead>
                                <tr>
                                    <th>訂單編號</th>
                                    <th>下單時間</th>
                                    <th>會員</th>
                                    <th>用餐方式</th>
                                    <th>付款方式</th>
                                    <th>優惠券</th>
                                    <th>活動</th>
                                    <th>金額</th>
                                    <th>狀態</th>
                                    <th>明細</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model.Orders)
                                {
                                    <tr>
                                        <td><span class="order-num-cell">@order.OrderNumber</span></td>
                                        <td style="white-space:nowrap;">@order.OrderAt.ToString("yyyy/MM/dd HH:mm")</td>
                                        <td style="color:#666;">@(order.MemberName ?? "訪客")</td>
                                        <td>
                                            @if (order.InOrOut)
                                            {
                                                <span class="tag tag-dine">🪑 @order.TableName</span>
                                            }
                                            else
                                            {
                                                <span class="tag tag-takeout">🥡 外帶</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="pay-text">
                                                @(order.PayMethod == "Cash" ? "💵 現金"
                                                  : order.PayMethod == "Card" ? "💳 刷卡"
                                                  : "📱 行動支付")
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(order.CouponName))
                                            {
                                                <span style="display:inline-block;padding:2px 7px;border-radius:9px;background:#fff8e1;color:#b7770d;font-size:0.78rem;font-weight:600;white-space:nowrap;">🎫 @order.CouponName</span>
                                            }
                                            else
                                            {
                                                <span style="color:#ddd;">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(order.EventTitle))
                                            {
                                                <span style="display:inline-block;padding:2px 7px;border-radius:9px;background:#eafaf1;color:#1e8449;font-size:0.78rem;font-weight:600;white-space:nowrap;">🎉 @order.EventTitle</span>
                                            }
                                            else
                                            {
                                                <span style="color:#ddd;">—</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="amount-main">NT$ @order.TotalAmount</div>
                                            @if (order.DiscountAmount > 0)
                                            {
                                                <div class="amount-disc">折扣 −@order.DiscountAmount</div>
                                            }
                                        </td>
                                        <td>
                                            @if (order.DoneOrCancel == 0)
                                            {
                                                <span class="badge badge-pending">⏳ 未完成</span>
                                            }
                                            else if (order.DoneOrCancel == 1)
                                            {
                                                <span class="badge badge-done">✅ 已完成</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-cancel">❌ 已取消</span>
                                            }
                                        </td>
                                        <td style="text-align:center;">
                                            <a href="@Url.Action("Detail", new { id = order.PreOrderId })" class="btn-detail">明細</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            @* 分頁 *@
            @if (Model.TotalPages > 1)
            {
                <div class="ao-pagination">
                    <a href="@Url.Action("AllOrders", new { Page = Model.Page - 1, Status = Model.Status, DateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"), DateTo = Model.DateTo?.ToString("yyyy-MM-dd"), Keyword = Model.Keyword })"
                       class="page-btn @(Model.Page <= 1 ? "disabled" : "")">← 上一頁</a>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == 1 || i == Model.TotalPages || (i >= Model.Page - 2 && i <= Model.Page + 2))
                        {
                            <a href="@Url.Action("AllOrders", new { Page = i, Status = Model.Status, DateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"), DateTo = Model.DateTo?.ToString("yyyy-MM-dd"), Keyword = Model.Keyword })"
                               class="page-btn @(i == Model.Page ? "active" : "")">@i</a>
                        }
                        else if (i == Model.Page - 3 || i == Model.Page + 3)
                        {
                            <span style="color:#ccc;padding:0 4px;">…</span>
                        }
                    }

                    <a href="@Url.Action("AllOrders", new { Page = Model.Page + 1, Status = Model.Status, DateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"), DateTo = Model.DateTo?.ToString("yyyy-MM-dd"), Keyword = Model.Keyword })"
                       class="page-btn @(Model.Page >= Model.TotalPages ? "disabled" : "")">下一頁 →</a>
                </div>
            }

        </div>

    </div>

</div>

<script>
    let sortAsc = false; // 預設：最新優先（降序）

    function toggleSortOrder() {
        sortAsc = !sortAsc;
        const btn = document.getElementById('sortToggleBtn');
        btn.textContent = sortAsc ? '↑ 最舊優先' : '↓ 最新優先';

        const tbody = document.querySelector('.ao-table tbody');
        if (!tbody) return;
        const rows = Array.from(tbody.querySelectorAll('tr'));
        rows.reverse().forEach(r => tbody.appendChild(r));
    }
</script>
