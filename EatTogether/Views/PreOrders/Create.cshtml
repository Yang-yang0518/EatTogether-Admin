    async function openCartCouponModal() {
        const listArea = document.getElementById('cartCouponListArea');
        listArea.innerHTML = '<div style="text-align:center;color:#aaa;padding:24px;">載入中...</div>';
        document.getElementById('cartCouponClearModalBtn').style.display = cartSelectedCoupon ? '' : 'none';
        document.getElementById('cartCouponModal').classList.add('show');
