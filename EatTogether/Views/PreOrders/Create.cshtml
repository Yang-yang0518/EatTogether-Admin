    .sm-qty-val {
        min-width: 20px;
        text-align: center;
        font-weight: 700;
        font-size: 0.95rem;
        color: #1a1a1a;
    }
</style>

<div class="order-wrap">
    <form asp-action="DirectSubmit" method="post" id="orderForm"
          onkeydown="if(event.key==='Enter'&&event.target.tagName!=='TEXTAREA'){event.preventDefault();}">
        @Html.AntiForgeryToken()
        <input type="hidden" name="IsAddOrder" value="@Model.IsAddOrder.ToString().ToLower()" />
        <input type="hidden" id="hiddenMemberId"       name="MemberId"       value="" />
        <input type="hidden" id="hiddenCouponId"       name="CouponId"       value="" />
        <input type="hidden" id="hiddenEventId"        name="EventId"        value="" />
        <input type="hidden" id="hiddenDiscountAmount" name="DiscountAmount"  value="0" />
        <input type="hidden" id="hiddenItemNotesJson"  name="ItemNotesJson"  value="" />
        <input type="hidden" id="hiddenNoteField"      name="Note"           value="" />

        <!-- ── 右側購物車（先放 HTML，CSS order 讓它靠右） ── -->
        <div class="cart-panel" style="order:2;">
            <div class="cart-header" style="display:flex;align-items:center;justify-content:space-between;">
                <span>🛒 已選餐點</span>
                <div style="display:flex;align-items:center;gap:8px;">
                    <span id="cartItemCount" style="font-size:0.82rem;color:#888;font-weight:400;"></span>
                    <button type="button" id="clearCartBtn" onclick="openClearCartModal()"
                            style="display:none;padding:3px 10px;font-size:0.78rem;font-weight:700;
                                   background:#fff;border:1.5px solid #e0b4b4;border-radius:8px;
                                   color:#c0392b;cursor:pointer;transition:all 0.15s;font-family:inherit;"
                            onmouseover="this.style.background='#fff5f5'"
                            onmouseout="this.style.background='#fff'">
                        🗑️ 清除
                    </button>
                </div>
            </div>
            <div class="cart-items" id="cartItems">
                <div class="cart-empty" id="cartEmpty">尚未選擇任何餐點</div>
            </div>
            <!-- 贈品顯示列（選活動且為贈品型時顯示） -->
            <div id="cartRewardRow" style="display:none;padding:6px 12px;
                 border-top:1px dashed #b7ddb7;background:#f6fff6;">
                <div class="cart-item-row" style="border-bottom:none;padding:4px 0;">
                    <div class="cart-item-name" style="color:#27ae60;">
                        🎁 <span id="cartRewardName"></span>
                    </div>
                    <span class="cart-item-sub" style="color:#27ae60;">$0</span>
                </div>
            </div>
            <!-- 會員按鈕 -->
            <div class="cart-member-section">
                <button type="button" id="cartMemberBtn" class="cart-member-btn"
                        onclick="openCartMemberModal()">
                    👤 <span id="cartMemberBtnLabel">輸入會員</span>
                </button>
            </div>

            <!-- 優惠券按鈕（選完會員才顯示） -->
            <div class="cart-discount-section" id="cartDiscountSection">
                <div class="cart-disc-btn-row">
                    <div>
                        <button type="button" id="cartCouponBtn" class="cart-disc-btn coupon-btn"
                                onclick="openCartCouponModal()">
                            <span class="btn-label" id="cartCouponBtnLabel">🎫 選擇優惠券</span>
                            <span style="display:flex;align-items:center;gap:4px;flex-shrink:0;">
                                <span class="cart-disc-avail-badge" id="cartCouponAvailBadge"></span>
                                <span class="cart-disc-clear" id="cartCouponClearBtn"
                                      onclick="event.stopPropagation(); clearCartCoupon()" title="清除">✕</span>
                            </span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="cart-footer">
                <div id="cartDiscountRow" style="display:none;justify-content:space-between;align-items:center;
                     padding:6px 0 4px;font-size:0.88rem;color:#c0392b;border-top:1px solid #f0f0f0;">
                    <span id="cartDiscountLabel">折扣</span>
                    <span>－NT$ <span id="cartDiscountAmt">0</span></span>
                </div>
                <div class="cart-total-row">
                    <span>合計</span>
                    <span class="cart-total-amt">NT$ <span id="cartTotal">0</span></span>
                </div>
                <button type="submit" class="btn-next" id="submitOrderBtn" style="width:100%; padding:11px;">送出</button>
            </div>
        </div>

        <!-- ── 左側點餐區 ── -->
        <div class="order-right" style="order:1;">

        <!-- ① 固定上方：標題 + 分類 Tab -->
        <div class="order-top">

        @if (TempData["Error"] != null)
        {
            <div class="alert-danger">@TempData["Error"]</div>
        }

        <!-- 標題列：點餐 | 內用/外帶 | 桌號 | 人數 全部並排 -->
        <div class="page-header" style="align-items:center; flex-wrap:wrap; gap:10px;">

            <!-- 左：標題 -->
            <div style="display:flex; align-items:center; gap:10px; flex-shrink:0; margin-right:4px;">
                <div class="page-title">🍽️ 點餐</div>
                @if (Model.IsAddOrder)
                {
                    <div style="font-size:0.82rem;color:#7d5a00;font-weight:600;
                                background:#fff8e1;border:1.5px solid #f0c040;border-radius:8px;
                                padding:3px 10px;">➕ 加點中</div>
                }
            </div>

            <!-- 內用/外帶 -->
            <div class="toggle-wrap" style="margin-bottom:0; flex-shrink:0;">
                <button type="button" class="toggle-btn active" id="btn-dine-in"
                        onclick="setInOrOut(true)">
                    🪑 內用
                </button>
                <button type="button" class="toggle-btn" id="btn-take-out"
                        onclick="setInOrOut(false)">
                    🥡 外帶
                </button>
						<!-- 服務人員按鈕 -->
						<button type="button" id="staffBtn" class="cart-member-btn"
								onclick="openStaffModal()"
								style="width:auto;flex-shrink:0;padding:7px 14px;">
							🧑‍💼 <span id="staffBtnLabel">輸入服務人員</span>
						</button>
						<input type="hidden" id="hiddenUserId" name="UserId" value="" />
            </div>

            

            <!-- 桌號 + 人數（內用才顯示） -->
            <div id="tableInput" style="display:flex; align-items:center; gap:10px; margin-left:auto;">
                <label style="font-size:0.88rem; font-weight:700; color:#333; white-space:nowrap;">桌號</label>
                <div>
                    <select name="TableId" id="tableSelect" class="form-select" style="padding:8px 12px; font-size:0.9rem; width:160px;">
                        <option value="">-- 選擇桌號 --</option>
                        @foreach (var t in Model.TableOptions)
                        {
                            <option value="@t.Value">@t.Text</option>
                        }
                    </select>
                    <div id="tableError" style="display:none; color:#c0392b; font-size:0.82rem; margin-top:4px; white-space:nowrap;">⚠️ 請選擇桌號</div>
                </div>
                <label style="font-size:0.88rem; font-weight:700; color:#333; white-space:nowrap;">人數</label>
                <select name="PeopleNum" id="peopleNumSelect" class="form-select" style="padding:8px 12px; font-size:0.9rem; width:90px;">
                    @for (int n = 1; n <= 10; n++)
                    {
                        <option value="@n">@n 人</option>
                    }
                </select>
            </div>
        </div>
        <input type="hidden" name="InOrOut" id="inOrOutInput" value="true" />

        @{
            var categoryOrder = new List<string> { "套餐", "主餐", "飲料", "甜點", "湯品", "附餐" };
            var categoryIcons = new Dictionary<string, string>
            {
                ["套餐"] = "🍱",
                ["主餐"] = "🍝",
                ["飲料"] = "🥤",
                ["甜點"] = "🍮",
                ["湯品"] = "🍲",
                ["附餐"] = "🥗"
            };
            var categoryColors = new Dictionary<string, string>
            {
                ["套餐"] = "#e67e22",
                ["主餐"] = "#c0392b",
                ["飲料"] = "#2980b9",
                ["甜點"] = "#8e44ad",
                ["湯品"] = "#16a085",
                ["附餐"] = "#27ae60"
            };

            var indexedItems = Model.Items
            .Select((item, idx) => new { item, idx })
            .ToList();

            var grouped = indexedItems
            .GroupBy(x => x.item.IsSetMeal ? "套餐" : (x.item.CategoryName ?? "其他"))
            .ToList();

            var orderedGroups = grouped
            .OrderBy(g =>
            {
                int pos = categoryOrder.IndexOf(g.Key);
                return pos < 0 ? 99 : pos;
            })
            .ToList();

            var firstCat = orderedGroups.FirstOrDefault()?.Key ?? "";
        }

        <!-- 分類 Tab 按鈕 + 活動按鈕（同一行） -->
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:0;">
            <div class="cat-tabs" id="catTabs" style="margin-bottom:0;flex-wrap:wrap;">
                @foreach (var group in orderedGroups)
                {
                    var catName  = group.Key;
                    var icon     = categoryIcons.ContainsKey(catName) ? categoryIcons[catName] : "🍽️";
                    var color    = categoryColors.ContainsKey(catName) ? categoryColors[catName] : "#555";
                    var count    = group.Count();
                    var isFirst  = catName == firstCat;
                    <button type="button"
                            class="cat-tab-btn @(isFirst ? "active" : "")"
                            id="tab-@catName"
                            style="--tab-color: @color"
                            onclick="showCategory('@catName')">
                        @icon @catName
                        <span class="tab-badge">@count</span>
                    </button>
                }
            </div>

            <!-- 活動按鈕（永遠顯示，不限會員） -->
            <button type="button" id="cartEventBtn" onclick="openCartEventModal()"
                    style="display:flex;align-items:center;gap:6px;padding:8px 14px;
                           border:2px solid #27ae60;border-radius:24px;background:#fff;
                           color:#27ae60;font-family:inherit;font-weight:700;font-size:0.85rem;
                           cursor:pointer;white-space:nowrap;transition:all 0.18s;flex-shrink:0;">
                🎉 <span id="cartEventBtnLabel">選擇活動</span>
                <span id="cartEventAvailBadge"
                      style="display:none;font-size:0.78rem;font-weight:600;color:inherit;"></span>
                <span id="cartEventClearBtn" style="display:none;font-size:0.9rem;line-height:1;"
                      onclick="event.stopPropagation();clearCartEvent()" title="清除">✕</span>
            </button>
        </div>

        </div><!-- /order-top -->

        <!-- ② 可捲動菜單區 -->
        <div class="menu-scroll-area">

        <!-- 各分類餐點區塊 -->
        @foreach (var group in orderedGroups)
        {
            var catName  = group.Key;
            var icon     = categoryIcons.ContainsKey(catName) ? categoryIcons[catName] : "🍽️";
            var color    = categoryColors.ContainsKey(catName) ? categoryColors[catName] : "#555";
            var isFirst  = catName == firstCat;

            <div class="category-section" id="cat-@catName"
                 style="display: @(isFirst ? "block" : "none")">
                <div class="menu-grid">
                    @foreach (var x in group)
                    {
                        var i = x.idx;
                        var item = x.item;
                        bool isSetMeal = item.IsSetMeal;
                        <div class="menu-card @(isSetMeal ? "is-setmeal" : "")" id="card-@i"
                             style="--card-accent: @color; cursor:pointer;"
                             onclick="@(isSetMeal ? $"openSetMealModal({i}, {item.ProductId}, '{item.ProductName}', {item.UnitPrice})" : $"changeQty({i}, 1)")">
                            <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                            <input type="hidden" name="Items[@i].ProductName" value="@item.ProductName" />
                            <input type="hidden" name="Items[@i].UnitPrice" value="@item.UnitPrice" />
                            <input type="hidden" name="Items[@i].IsSetMeal" value="@isSetMeal.ToString().ToLower()" />
                            <input type="hidden" name="Items[@i].CategoryName" value="@(item.CategoryName ?? "")" />
                            <input type="hidden" name="Items[@i].ParentIndex" value="" />
                            <input type="number" id="qty-@i" name="Items[@i].Qty" value="0" min="0" style="display:none;" readonly />

                            <div class="menu-name">@item.ProductName</div>
                            <div class="menu-price">NT$ @item.UnitPrice</div>
                        </div>
                    }
                </div>
            </div>
        }

        </div><!-- /menu-scroll-area -->

        <!-- 整單備註 -->
        <div class="order-bottom" style="padding:10px 16px 14px;border-top:2px solid #e8e0d8;background:#fff;">
            <div style="flex:1;">
                <label style="font-size:0.82rem;font-weight:700;color:#555;margin-bottom:4px;display:block;">
                    📝 整單備註
                </label>
                <textarea id="orderNoteInput" rows="2"
                          placeholder="如有特殊需求請在此說明…"
                          style="width:100%;padding:8px 12px;font-size:0.88rem;font-family:inherit;
                                 border:1.5px solid #e0e0e0;border-radius:8px;color:#333;
                                 background:#fafafa;resize:none;outline:none;box-sizing:border-box;
                                 transition:border-color 0.15s;"
                          onfocus="this.style.borderColor='#c0392b';this.style.background='#fff'"
                          onblur="this.style.borderColor='#e0e0e0';this.style.background='#fafafa'"></textarea>
            </div>
        </div>

        </div><!-- /order-right -->

        <!-- 套餐子項目動態 hidden inputs 放這裡 -->
        <div id="extraItemsContainer"></div>
    </form>
</div>

<!-- 右下角近差額持久通知 -->
<!-- 多通知容器 -->
<div id="nearMissContainer" style="position:fixed;bottom:24px;right:24px;z-index:9500;
     display:flex;flex-direction:column;gap:10px;align-items:flex-end;max-width:300px;
     font-family:'Noto Sans TC',sans-serif;"></div>

