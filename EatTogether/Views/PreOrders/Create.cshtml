    // ── 購物車更新 ──────────────────────────────────────
    function refreshCart() {
        const cartItems = document.getElementById('cartItems');
        const cartEmpty = document.getElementById('cartEmpty');
        const cartTotal = document.getElementById('cartTotal');

        // 清除舊內容（保留 cartEmpty）
        [...cartItems.querySelectorAll('.cart-item-wrap, .cart-item-row, .cart-sub-items')].forEach(el => el.remove());

        let total = 0;
        let hasAny = false;
        let totalQty = 0;

        // ① 一般餐點（非套餐）
        @for (int i = 0; i < Model.Items.Count; i++)
        {
            if (!Model.Items[i].IsSetMeal && !Model.Items[i].ParentIndex.HasValue)
            {
                var escapedName = Model.Items[i].ProductName.Replace("'", "\\'");
                var jsName = System.Text.Json.JsonSerializer.Serialize(Model.Items[i].ProductName);
                <text>
                {
                    const q = parseInt(document.getElementById('qty-@(i)')?.value || 0);
                    if (q > 0) {
                        hasAny = true;
                        totalQty += q;
                        const s = q * @(Model.Items[i].UnitPrice);
                        total += s;
                        const _nk = @Html.Raw(jsName); // 品項名稱，正確 JS 字串
                        const wrap = document.createElement('div');
                        wrap.className = 'cart-item-wrap';
                        const noteVal = cartItemNotes[_nk] || '';
                        wrap.innerHTML =
                            '<div class="cart-item-row">'
                            + '<div class="cart-item-name">@(escapedName)</div>'
                            + '<div class="cart-qty-wrap">'
                            + '<button type="button" class="cart-qty-btn" onclick="changeQty(@(i),-1)">−</button>'
                            + '<span class="cart-qty-val">' + q + '</span>'
                            + '<button type="button" class="cart-qty-btn" onclick="changeQty(@(i),1)">＋</button>'
                            + '</div>'
                            + '<span class="cart-item-sub">$' + s.toLocaleString() + '</span>'
                            + '<button type="button" class="cart-item-del" onclick="changeQty(@(i),-'+q+')" title="移除">✕</button>'
                            + '</div>'
                            + '<input type="text" class="cart-item-note-input" placeholder="📝 備註（選填）"'
                            + ' value="' + noteVal.replace(/"/g,'&quot;') + '" />';
                        // 用 JS 直接設定 noteKey，避免 innerHTML HTML 編碼問題
                        const _ni = wrap.querySelector('.cart-item-note-input');
                        if (_ni) _ni.dataset.noteKey = _nk;
                        cartItems.appendChild(wrap);
                    }
                }
                </text>
            }
        }

        // ② 套餐：每份獨立顯示（含細項）
        setMealServings.forEach((s, si) => {
            hasAny = true;
            totalQty += 1;
            total += s.price;

            const smWrap = document.createElement('div');
            smWrap.className = 'cart-item-wrap';
            const smNoteVal = (cartItemNotes[s.name] || '').replace(/"/g, '&quot;');
            smWrap.innerHTML = `
                <div class="cart-item-row">
                    <div class="cart-item-name">${s.name}</div>
                    <div class="cart-qty-wrap">
                        <button type="button" class="cart-qty-btn"
                                onclick="changeSetMealQty(${s.parentIdx}, -1)">−</button>
                        <span class="cart-qty-val">1</span>
                        <button type="button" class="cart-qty-btn"
                                onclick="openSetMealModal(${s.parentIdx}, 0, ${JSON.stringify(s.name)}, ${s.price})">＋</button>
                    </div>
                    <span class="cart-item-sub">$${s.price.toLocaleString()}</span>
                    <button type="button" class="cart-item-del"
                            onclick="changeSetMealQty(${s.parentIdx}, -1)" title="移除">✕</button>
                </div>
                <input type="text" class="cart-item-note-input" placeholder="📝 備註（選填）"
                       value="${smNoteVal}" />
            `;
            // 用 JS 直接設定 noteKey
            const _smNi = smWrap.querySelector('.cart-item-note-input');
            if (_smNi) _smNi.dataset.noteKey = s.name;
            cartItems.appendChild(smWrap);

            // 細項
            if (s.subItems && s.subItems.length > 0) {
                const sub = document.createElement('div');
                sub.className = 'cart-sub-items';
                sub.innerHTML = s.subItems.map(name => `<div class="cart-sub-item">${name}</div>`).join('');
                cartItems.appendChild(sub);
            }
        });

        rawCartTotal = total;
        // 共計項數
        const countEl = document.getElementById('cartItemCount');
        if (countEl) countEl.textContent = totalQty > 0 ? `共計 ${totalQty} 項` : '';
        // 清除按鈕顯示控制
        const clearBtn = document.getElementById('clearCartBtn');
        if (clearBtn) clearBtn.style.display = hasAny ? 'inline-block' : 'none';
        // 若選取的折扣在金額變動後超出範圍，refreshCartDiscounts 內部會重置
        // 先更新顯示（用舊的 selectedDiscount），refreshCartDiscounts 結束後再校正
        updateCartTotalDisplay();
        cartEmpty.style.display = hasAny ? 'none' : 'block';
        refreshCartDiscounts();
    }

    document.addEventListener('DOMContentLoaded', () => {
        @for (int i = 0; i < Model.Items.Count; i++)
        {
                    if (Model.Items[i].Qty > 0)
                    {
                                @:document.getElementById('card-@i').classList.add('selected');
                    }
        }
        refreshEventBtn(); // 頁面載入時立即顯示進行中活動數

        // ── 備註事件委派（比 oninput 屬性更可靠，支援中文 IME） ───
        document.getElementById('cartItems').addEventListener('input', function(e) {
            const inp = e.target.closest('.cart-item-note-input');
            if (!inp) return;
            const key = inp.dataset.noteKey;
            if (!key) return;
            if (inp.value.trim()) {
                cartItemNotes[key] = inp.value.trim();
            } else {
                delete cartItemNotes[key];
            }
        });

        // ── AJAX 送出 ─────────────────────────────────────────
        document.getElementById('orderForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            // ── 桌號驗證（內用必填） ─────────────────────────────
            const isIn = document.getElementById('inOrOutInput').value === 'true';
            if (isIn) {
                const tableVal = document.getElementById('tableSelect').value;
                if (!tableVal) {
                    document.getElementById('tableRequiredModal').style.display = 'flex';
                    return;
                }
            }

            const btn = document.getElementById('submitOrderBtn');
            btn.disabled = true;
            btn.textContent = '處理中…';

            // 直接從 DOM 讀取備註（最可靠，不依賴 cartItemNotes 是否同步）
            const notesFiltered = {};
            document.querySelectorAll('#cartItems .cart-item-note-input').forEach(inp => {
                const key = inp.dataset.noteKey;
                const val = inp.value.trim();
                if (key && val) notesFiltered[key] = val;
            });
            const itemNotesJson = Object.keys(notesFiltered).length ? JSON.stringify(notesFiltered) : '';
            document.getElementById('hiddenItemNotesJson').value = itemNotesJson;

            // ── 組合 Note 欄位：個別備註 + 整單備註 → 存入 PreOrders.Note ──
            const orderNote = document.getElementById('orderNoteInput').value.trim();
            const noteParts = [];
            // 個別餐點備註
            if (Object.keys(notesFiltered).length) {
                const itemLines = Object.entries(notesFiltered)
                    .map(([name, note]) => `【${name}】${note}`)
                    .join('；');
                noteParts.push('餐點備註：' + itemLines);
            }
            // 整單備註
            if (orderNote) {
                noteParts.push('整單備註：' + orderNote);
            }
            document.getElementById('hiddenNoteField').value = noteParts.join('\n');

            const formData = new FormData(this);

            try {
                const resp = await fetch('@Url.Action("DirectSubmit", "PreOrders")', {
                    method: 'POST',
                    body: formData
                });
                const json = await resp.json();
                if (json.success) {
                    document.getElementById('successOrderNumber').textContent = json.orderNumber;
                    document.getElementById('orderSuccessModal').style.display = 'flex';
                    // 1.5 秒後自動關閉
                    setTimeout(closeOrderSuccessModal, 1500);
                } else {
                    alert(json.error || '送出失敗，請再試一次');
                    btn.disabled = false;
                    btn.textContent = '送出';
                }
            } catch {
                alert('網路錯誤，請再試一次');
                btn.disabled = false;
                btn.textContent = '送出';
            }
        });
    });

