    async function doSearchCartMember() {
        const phone  = document.getElementById('cmPhoneInput').value.trim();
        const result = document.getElementById('cmResult');

        if (!phone) {
            result.innerHTML = `<div style="color:#c0392b;font-size:0.85rem;">請先輸入電話號碼</div>`;
            return;
        }

        result.innerHTML = `<div style="color:#aaa;font-size:0.85rem;">查詢中…</div>`;

        try {
            const res  = await fetch(`/PreOrders/SearchMember?phone=${encodeURIComponent(phone)}`);
            const data = await res.json();

            if (!data.success) {
                result.innerHTML = `<div style="color:#c0392b;font-size:0.85rem;padding:8px 0;">❌ ${data.error}</div>`;
                return;
            }

            const m = data.member;
            const canBind = m.isConfirmed && !m.isBlacklisted;

            const warningHtml = m.isBlacklisted
                ? `<div style="margin-top:6px;font-size:0.78rem;color:#c0392b;font-weight:600;">⛔ 此會員已被列為黑名單，無法綁定</div>`
                : (!m.isConfirmed
                    ? `<div style="margin-top:6px;font-size:0.78rem;color:#e67e22;font-weight:600;">⚠️ 此會員尚未驗證信箱，無法綁定</div>`
                    : '');

            if (canBind) {
                // 可綁定：卡片直接可點擊帶入
                const safePhone = (m.phone ?? '').replace(/'/g, "\\'");
                const safeName  = (m.name  ?? '').replace(/'/g, "\\'");
                result.innerHTML = `
                    <div class="cm-member-card"
                         onclick="selectCartMember(${m.id}, '${safeName}', '${safePhone}')">
                        <span style="font-size:1.3rem;">👤</span>
                        <div>
                            <div style="font-weight:700;font-size:0.95rem;color:#3d1a5f;">${m.name}</div>
                            <div style="font-size:0.82rem;color:#888;">${m.phone ?? ''}</div>
                        </div>
                    </div>
                    <div class="cm-member-card-hint">點擊卡片帶入會員</div>`;
            } else {
                // 無法綁定：僅顯示資訊
                const borderColor = m.isBlacklisted ? '#e0a0a0' : '#f0c88a';
                const bgColor     = m.isBlacklisted ? '#fff5f5' : '#fffbf0';
                result.innerHTML = `
                    <div style="padding:12px 14px;border:1.5px solid ${borderColor};
                                border-radius:10px;background:${bgColor};">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <span style="font-size:1.3rem;">👤</span>
                            <div>
                                <div style="font-weight:700;font-size:0.95rem;color:#5a3a1a;">${m.name}</div>
                                <div style="font-size:0.82rem;color:#888;">${m.phone ?? ''}</div>
                            </div>
                        </div>
                        ${warningHtml}
                    </div>`;
            }

        } catch {
            result.innerHTML = `<div style="color:#c0392b;font-size:0.85rem;">查詢失敗，請重試</div>`;
        }
    }

