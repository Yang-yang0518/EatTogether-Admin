</style>

<div class="order-wrap">
    <form asp-action="Confirm" method="post" id="orderForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="IsAddOrder" value="@Model.IsAddOrder.ToString().ToLower()" />

        <!-- ── 右側購物車（先放 HTML，CSS order 讓它靠右） ── -->
        <div class="cart-panel" style="order:2;">
            <div class="cart-header">🛒 已選餐點</div>
            <div class="cart-items" id="cartItems">
                <div class="cart-empty" id="cartEmpty">尚未選擇任何餐點</div>
            </div>
            <!-- 會員按鈕 -->
            <div class="cart-member-section">
                <button type="button" id="cartMemberBtn" class="cart-member-btn"
                        onclick="openCartMemberModal()">
                    👤 <span id="cartMemberBtnLabel">輸入會員</span>
                </button>
            </div>

            <!-- 活動 / 優惠券按鈕 -->
            <div class="cart-discount-section" id="cartDiscountSection">
                <div class="cart-disc-btn-row">
                    <div>
                        <button type="button" id="cartEventBtn" class="cart-disc-btn event-btn"
                                onclick="openCartEventModal()">
                            <span class="btn-label" id="cartEventBtnLabel">🎉 選擇活動</span>
                            <span style="display:flex;align-items:center;gap:4px;flex-shrink:0;">
                                <span class="cart-disc-avail-badge" id="cartEventAvailBadge"></span>
                                <span class="cart-disc-clear" id="cartEventClearBtn"
                                      onclick="event.stopPropagation(); clearCartEvent()" title="清除">✕</span>
                            </span>
                        </button>
                        <div class="cart-disc-near-miss" id="cartEventNearMiss"></div>
                    </div>
                    <div>
                        <button type="button" id="cartCouponBtn" class="cart-disc-btn coupon-btn"
                                onclick="openCartCouponModal()">
                            <span class="btn-label" id="cartCouponBtnLabel">🎫 選擇優惠券</span>
                            <span style="display:flex;align-items:center;gap:4px;flex-shrink:0;">
                                <span class="cart-disc-avail-badge" id="cartCouponAvailBadge"></span>
                                <span class="cart-disc-clear" id="cartCouponClearBtn"
                                      onclick="event.stopPropagation(); clearCartCoupon()" title="清除">✕</span>
                            </span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="cart-footer">
                <div class="cart-total-row">
                    <span>合計</span>
                    <span class="cart-total-amt">NT$ <span id="cartTotal">0</span></span>
                </div>
                <button type="submit" class="btn-next" style="width:100%; padding:11px;">下一步 →</button>
            </div>
        </div>

        <!-- ── 左側點餐區 ── -->
        <div class="order-right" style="order:1;">

        <!-- ① 固定上方：標題 + 分類 Tab -->
        <div class="order-top">

        @if (TempData["Error"] != null)
        {
            <div class="alert-danger">@TempData["Error"]</div>
        }

        <!-- 標題列：點餐 | 內用/外帶 | 桌號 | 人數 全部並排 -->
        <div class="page-header" style="align-items:center; flex-wrap:wrap; gap:10px;">

            <!-- 左：標題 -->
            <div style="display:flex; align-items:center; gap:10px; flex-shrink:0; margin-right:4px;">
                <div class="page-title">🍽️ 點餐</div>
                @if (Model.IsAddOrder)
                {
                    <div style="font-size:0.82rem;color:#7d5a00;font-weight:600;
                                background:#fff8e1;border:1.5px solid #f0c040;border-radius:8px;
                                padding:3px 10px;">➕ 加點中</div>
                }
            </div>

            <!-- 內用/外帶 -->
            <div class="toggle-wrap" style="margin-bottom:0; flex-shrink:0;">
                <button type="button" class="toggle-btn active" id="btn-dine-in"
                        onclick="setInOrOut(true)">
                    🪑 內用
                </button>
                <button type="button" class="toggle-btn" id="btn-take-out"
                        onclick="setInOrOut(false)">
                    🥡 外帶
                </button>
            </div>

            <!-- 桌號 + 人數（內用才顯示） -->
            <div id="tableInput" style="display:flex; align-items:center; gap:10px; margin-left:auto;">
                <label style="font-size:0.88rem; font-weight:700; color:#333; white-space:nowrap;">桌號</label>
                <div>
                    <select name="TableId" id="tableSelect" class="form-select" style="padding:8px 12px; font-size:0.9rem; width:160px;">
                        <option value="">-- 選擇桌號 --</option>
                        @foreach (var t in Model.TableOptions)
                        {
                            <option value="@t.Value">@t.Text</option>
                        }
                    </select>
                    <div id="tableError" style="display:none; color:#c0392b; font-size:0.82rem; margin-top:4px; white-space:nowrap;">⚠️ 請選擇桌號</div>
                </div>
                <label style="font-size:0.88rem; font-weight:700; color:#333; white-space:nowrap;">人數</label>
                <select name="PeopleNum" id="peopleNumSelect" class="form-select" style="padding:8px 12px; font-size:0.9rem; width:90px;">
                    @for (int n = 1; n <= 10; n++)
                    {
                        <option value="@n">@n 人</option>
                    }
                </select>
            </div>
        </div>
        <input type="hidden" name="InOrOut" id="inOrOutInput" value="true" />

        @{
            var categoryOrder = new List<string> { "套餐", "主餐", "飲料", "甜點", "湯品", "附餐" };
            var categoryIcons = new Dictionary<string, string>
            {
                ["套餐"] = "🍱",
                ["主餐"] = "🍝",
                ["飲料"] = "🥤",
                ["甜點"] = "🍮",
                ["湯品"] = "🍲",
                ["附餐"] = "🥗"
            };
            var categoryColors = new Dictionary<string, string>
            {
                ["套餐"] = "#e67e22",
                ["主餐"] = "#c0392b",
                ["飲料"] = "#2980b9",
                ["甜點"] = "#8e44ad",
                ["湯品"] = "#16a085",
                ["附餐"] = "#27ae60"
            };

            var indexedItems = Model.Items
            .Select((item, idx) => new { item, idx })
            .ToList();

            var grouped = indexedItems
            .GroupBy(x => x.item.IsSetMeal ? "套餐" : (x.item.CategoryName ?? "其他"))
            .ToList();

            var orderedGroups = grouped
            .OrderBy(g =>
            {
                int pos = categoryOrder.IndexOf(g.Key);
                return pos < 0 ? 99 : pos;
            })
            .ToList();

            var firstCat = orderedGroups.FirstOrDefault()?.Key ?? "";
        }

        <!-- 分類 Tab 按鈕（在 order-top 內） -->
        <div class="cat-tabs" id="catTabs">
            @foreach (var group in orderedGroups)
            {
                var catName  = group.Key;
                var icon     = categoryIcons.ContainsKey(catName) ? categoryIcons[catName] : "🍽️";
                var color    = categoryColors.ContainsKey(catName) ? categoryColors[catName] : "#555";
                var count    = group.Count();
                var isFirst  = catName == firstCat;
                <button type="button"
                        class="cat-tab-btn @(isFirst ? "active" : "")"
                        id="tab-@catName"
                        style="--tab-color: @color"
                        onclick="showCategory('@catName')">
                    @icon @catName
                    <span class="tab-badge">@count</span>
                </button>
            }
        </div>

        </div><!-- /order-top -->

        <!-- ② 可捲動菜單區 -->
        <div class="menu-scroll-area">

        <!-- 各分類餐點區塊 -->
        @foreach (var group in orderedGroups)
        {
            var catName  = group.Key;
            var icon     = categoryIcons.ContainsKey(catName) ? categoryIcons[catName] : "🍽️";
            var color    = categoryColors.ContainsKey(catName) ? categoryColors[catName] : "#555";
            var isFirst  = catName == firstCat;

            <div class="category-section" id="cat-@catName"
                 style="display: @(isFirst ? "block" : "none")">
                <div class="menu-grid">
                    @foreach (var x in group)
                    {
                        var i = x.idx;
                        var item = x.item;
                        bool isSetMeal = item.IsSetMeal;
                        <div class="menu-card @(isSetMeal ? "is-setmeal" : "")" id="card-@i"
                             style="--card-accent: @color; cursor:pointer;"
                             onclick="@(isSetMeal ? $"openSetMealModal({i}, {item.ProductId}, '{item.ProductName}', {item.UnitPrice})" : $"changeQty({i}, 1)")">
                            <input type="hidden" name="Items[@i].ProductId" value="@item.ProductId" />
                            <input type="hidden" name="Items[@i].ProductName" value="@item.ProductName" />
                            <input type="hidden" name="Items[@i].UnitPrice" value="@item.UnitPrice" />
                            <input type="hidden" name="Items[@i].IsSetMeal" value="@isSetMeal.ToString().ToLower()" />
                            <input type="hidden" name="Items[@i].CategoryName" value="@(item.CategoryName ?? "")" />
                            <input type="hidden" name="Items[@i].ParentIndex" value="" />
                            <input type="number" id="qty-@i" name="Items[@i].Qty" value="0" min="0" style="display:none;" readonly />

                            <div class="menu-name">@item.ProductName</div>
                            <div class="menu-price">NT$ @item.UnitPrice</div>
                        </div>
                    }
                </div>
            </div>
        }

        </div><!-- /menu-scroll-area -->

        <!-- ③ 固定底部：備註 -->
        <div class="order-bottom">
            <div class="note-wrap">
                <textarea class="form-control" name="Note" placeholder="備註（可不填）" style="min-height:44px;"></textarea>
            </div>
        </div>

        </div><!-- /order-right -->

        <!-- 套餐子項目動態 hidden inputs 放這裡 -->
        <div id="extraItemsContainer"></div>
    </form>
</div>

