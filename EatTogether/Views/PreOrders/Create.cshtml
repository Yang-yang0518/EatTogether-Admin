    function applyStaff(id, name) {
        staffUserId   = id;
        staffUserName = name;
        document.getElementById('hiddenUserId').value = id;
        document.getElementById('staffBtnLabel').textContent = name;
        document.getElementById('staffBtn').classList.add('has-member');
        closeStaffModal();
    }

    function clearStaff() {
        staffUserId   = null;
        staffUserName = null;
        document.getElementById('hiddenUserId').value = '';
        document.getElementById('staffBtnLabel').textContent = '輸入服務人員';
        document.getElementById('staffBtn').classList.remove('has-member');
        document.getElementById('staffClearBtn').style.display = 'none';
        document.getElementById('smStaffCurrentInfo').style.display = 'none';
    }

    function closeOrderSuccessModal() {
        document.getElementById('orderSuccessModal').style.display = 'none';
        // 清除購物車數量
        document.querySelectorAll('.menu-card.selected').forEach(c => c.classList.remove('selected'));
        document.querySelectorAll('input[name^="Items["][name$=".Qty"]').forEach(i => i.value = 0);
        rawCartTotal = 0;
        cartItemNotes = {};
        document.getElementById('hiddenItemNotesJson').value = '';
        // 清除通知
        _nearMissDismissed.clear();
        clearNearMissNotifications();
        // 清除優惠券
        clearCartCoupon();
        // 清除活動
        clearCartEvent();
        // 清除會員
        clearCartMember();
        // 清除服務人員
        clearStaff();
        document.getElementById('hiddenDiscountAmount').value = '0';
        document.getElementById('cartRewardRow').style.display = 'none';
        // 清除整單備註
        const noteInput = document.getElementById('orderNoteInput');
        if (noteInput) noteInput.value = '';
        document.getElementById('hiddenNoteField').value = '';
        refreshCart();
        refreshEventBtn();
        // 清除桌號 & 人數
        const tableSelect = document.getElementById('tableSelect');
        if (tableSelect) tableSelect.value = '';
        const peopleNumSelect = document.getElementById('peopleNumSelect');
        if (peopleNumSelect) peopleNumSelect.value = '1';
        // 跳回第一個分類（套餐起始畫面）
        const firstTab = document.querySelector('.cat-tab-btn');
        if (firstTab) firstTab.click();
        // 重置為內用
        setInOrOut(true);
        // 重置送出按鈕
        const btn = document.getElementById('submitOrderBtn');
        btn.disabled = false;
        btn.textContent = '送出';
    }
</script>

