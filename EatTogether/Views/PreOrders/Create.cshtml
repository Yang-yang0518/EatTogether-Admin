    function applyCartCoupon(id) {
        const c = _cartCouponsCache.find(x => x.id === id);
        if (!c) return;
        const disc = (c.discountType === 0 || c.discountType === 'Fixed')
            ? (c.discountValue ?? 0)
            : Math.floor(rawCartTotal * (c.discountValue ?? 0) / 100);
        cartSelectedCoupon = { id: c.id, name: c.name ?? '', disc };
        document.getElementById('hiddenCouponId').value = id;
        closeCartCouponModal();
