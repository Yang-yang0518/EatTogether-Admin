    let rawCartTotal      = 0;    // 原始金額（不含折扣）
    let cartSelectedEvent  = null; // { id, title, discount }
    let cartSelectedCoupon = null; // { id, name, disc }

    // ── 折扣合計顯示 ──────────────────────────────────────
    function updateCartTotalDisplay() {
        const evDisc  = cartSelectedEvent  ? (cartSelectedEvent.discount  || 0) : 0;
        const cpDisc  = cartSelectedCoupon ? (cartSelectedCoupon.disc     || 0) : 0;
        const disc    = evDisc + cpDisc;
        const finalAmt = Math.max(0, rawCartTotal - disc);
        const totalSpan = document.getElementById('cartTotal');
        if (disc > 0) {
            totalSpan.innerHTML = `<span style="text-decoration:line-through;color:#bbb;font-size:0.85em;">${rawCartTotal.toLocaleString()}</span> ${finalAmt.toLocaleString()}`;
        } else {
            totalSpan.textContent = rawCartTotal.toLocaleString();
        }
    }

    // ── 折扣按鈕列更新 ─────────────────────────────────────
    async function refreshCartDiscounts() {
        const section = document.getElementById('cartDiscountSection');

        if (!cartMemberId) {
            section.style.display = 'none';
            if (cartSelectedEvent || cartSelectedCoupon) {
                cartSelectedEvent = cartSelectedCoupon = null;
                updateCartTotalDisplay();
            }
            return;
        }

        try {
            const [evRes, cpRes] = await Promise.all([
                fetch(`/PreOrders/GetCartEvents?amount=${rawCartTotal}`),
                fetch(`/PreOrders/GetCartCoupons?amount=${rawCartTotal}&memberId=${cartMemberId}`)
            ]);
            const events  = (await evRes.json()) || [];
            const coupons = (await cpRes.json()) || [];

            // 驗證已選是否仍有效
            if (cartSelectedEvent) {
                if (!events.find(e => e.isEligible && e.id === cartSelectedEvent.id))
                    { cartSelectedEvent = null; updateCartTotalDisplay(); }
            }
            if (cartSelectedCoupon) {
                if (!coupons.find(c => c.isClaimed && !c.isUsedByMember && c.isEligible && c.id === cartSelectedCoupon.id))
                    { cartSelectedCoupon = null; updateCartTotalDisplay(); }
            }

            // 更新活動按鈕
            const evAvail    = events.filter(e => e.isEligible).length;
            const evBadge    = document.getElementById('cartEventAvailBadge');
            const evClear    = document.getElementById('cartEventClearBtn');
            const evBtn      = document.getElementById('cartEventBtn');
            const evLabel    = document.getElementById('cartEventBtnLabel');
            const evNearMiss = document.getElementById('cartEventNearMiss');
            if (cartSelectedEvent) {
                evLabel.textContent = `🎉 ${cartSelectedEvent.title}`;
                evBadge.style.display = 'none';
                evClear.style.display = '';
                evBtn.classList.add('selected');
                evNearMiss.style.display = 'none';
            } else {
                evLabel.textContent = '🎉 選擇活動';
                evClear.style.display = 'none';
                evBtn.classList.remove('selected');
                if (evAvail > 0) { evBadge.textContent = `${evAvail} 可用`; evBadge.style.display = ''; }
                else evBadge.style.display = 'none';

                // 近差額提示：找最近、差額 ≤ 200 的活動
                const nearEv = events
                    .filter(e => !e.isEligible && (e.minSpend - rawCartTotal) > 0 && (e.minSpend - rawCartTotal) <= 200)
                    .sort((a, b) => (a.minSpend - rawCartTotal) - (b.minSpend - rawCartTotal))[0];
                if (nearEv) {
                    evNearMiss.textContent = `📌 再消費 NT$ ${(nearEv.minSpend - rawCartTotal).toLocaleString()} 可享活動`;
                    evNearMiss.style.display = '';
                } else {
                    evNearMiss.style.display = 'none';
                }
            }

            // 更新優惠券按鈕
            const cpAvail = coupons.filter(c => c.isClaimed && !c.isUsedByMember && c.isEligible).length;
            const cpBadge = document.getElementById('cartCouponAvailBadge');
            const cpClear = document.getElementById('cartCouponClearBtn');
            const cpBtn   = document.getElementById('cartCouponBtn');
            const cpLabel = document.getElementById('cartCouponBtnLabel');
            if (cartSelectedCoupon) {
                cpLabel.textContent = `🎫 ${cartSelectedCoupon.name}`;
                cpBadge.style.display = 'none';
                cpClear.style.display = '';
                cpBtn.classList.add('selected');
            } else {
                cpLabel.textContent = '🎫 選擇優惠券';
                cpClear.style.display = 'none';
                cpBtn.classList.remove('selected');
                if (cpAvail > 0) { cpBadge.textContent = `${cpAvail} 可用`; cpBadge.style.display = ''; }
                else cpBadge.style.display = 'none';
            }

            section.style.display = 'block';
        } catch {
            section.style.display = 'none';
        }
    }

    // ── 活動 Modal ────────────────────────────────────────
    async function openCartEventModal() {
        const listArea = document.getElementById('cartEventListArea');
        listArea.innerHTML = '<div style="text-align:center;color:#aaa;padding:24px;">載入中...</div>';
        document.getElementById('cartEventClearModalBtn').style.display = cartSelectedEvent ? '' : 'none';
        document.getElementById('cartEventModal').classList.add('show');
        try {
            const res    = await fetch(`/PreOrders/GetCartEvents?amount=${rawCartTotal}`);
            const events = (await res.json()) || [];
            _renderCartEventList(events);
        } catch {
            listArea.innerHTML = '<div style="text-align:center;color:#c0392b;padding:24px;">載入失敗</div>';
        }
