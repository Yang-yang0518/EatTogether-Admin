    // ── 購物車更新 ──────────────────────────────────────
    function refreshCart() {
        const cartItems = document.getElementById('cartItems');
        const cartEmpty = document.getElementById('cartEmpty');
        const cartTotal = document.getElementById('cartTotal');

        // 清除舊內容（保留 cartEmpty）
        [...cartItems.querySelectorAll('.cart-item-row, .cart-sub-items')].forEach(el => el.remove());

        let total = 0;
        let hasAny = false;

        // ① 一般餐點（非套餐）
        @for (int i = 0; i < Model.Items.Count; i++)
        {
            if (!Model.Items[i].IsSetMeal && !Model.Items[i].ParentIndex.HasValue)
            {
                var escapedName = Model.Items[i].ProductName.Replace("'", "\\'");
                <text>
                {
                    const q = parseInt(document.getElementById('qty-@(i)')?.value || 0);
                    if (q > 0) {
                        hasAny = true;
                        const s = q * @(Model.Items[i].UnitPrice);
                        total += s;
                        const el = document.createElement('div');
                        el.className = 'cart-item-row';
                        el.innerHTML = '<div class="cart-item-name">@(escapedName)</div>'
                            + '<div class="cart-qty-wrap">'
                            + '<button type="button" class="cart-qty-btn" onclick="changeQty(@(i),-1)">−</button>'
                            + '<span class="cart-qty-val">' + q + '</span>'
                            + '<button type="button" class="cart-qty-btn" onclick="changeQty(@(i),1)">＋</button>'
                            + '</div>'
                            + '<span class="cart-item-sub">$' + s.toLocaleString() + '</span>'
                            + '<button type="button" class="cart-item-del" onclick="changeQty(@(i),-'+q+')" title="移除">✕</button>';
                        cartItems.appendChild(el);
                    }
                }
                </text>
            }
        }

        // ② 套餐：每份獨立顯示（含細項）
        setMealServings.forEach((s, si) => {
            hasAny = true;
            total += s.price;

            const row = document.createElement('div');
            row.className = 'cart-item-row';
            row.innerHTML = `
                <div class="cart-item-name">${s.name}</div>
                <div class="cart-qty-wrap">
                    <button type="button" class="cart-qty-btn"
                            onclick="changeSetMealQty(${s.parentIdx}, -1)">−</button>
                    <span class="cart-qty-val">1</span>
                    <button type="button" class="cart-qty-btn"
                            onclick="openSetMealModal(${s.parentIdx}, 0, ${JSON.stringify(s.name)}, ${s.price})">＋</button>
                </div>
                <span class="cart-item-sub">$${s.price.toLocaleString()}</span>
                <button type="button" class="cart-item-del"
                        onclick="changeSetMealQty(${s.parentIdx}, -1)" title="移除">✕</button>
            `;
            cartItems.appendChild(row);

            // 細項
            if (s.subItems && s.subItems.length > 0) {
                const sub = document.createElement('div');
                sub.className = 'cart-sub-items';
                sub.innerHTML = s.subItems.map(name => `<div class="cart-sub-item">${name}</div>`).join('');
                cartItems.appendChild(sub);
            }
        });

        rawCartTotal = total;
        // 若選取的折扣在金額變動後超出範圍，refreshCartDiscounts 內部會重置
        // 先更新顯示（用舊的 selectedDiscount），refreshCartDiscounts 結束後再校正
        updateCartTotalDisplay();
        cartEmpty.style.display = hasAny ? 'none' : 'block';
        refreshCartDiscounts();
    }

    document.addEventListener('DOMContentLoaded', () => {
        @for (int i = 0; i < Model.Items.Count; i++)
        {
                    if (Model.Items[i].Qty > 0)
                    {
                                @:document.getElementById('card-@i').classList.add('selected');
                    }
        }
    });
</script>

