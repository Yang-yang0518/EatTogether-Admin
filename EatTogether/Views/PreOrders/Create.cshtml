    function closeCartEventModal() {
        document.getElementById('cartEventModal').classList.remove('show');
    }

    function _renderCartEventList(events) {
        const rawTotal  = rawCartTotal;
        const NEAR_MISS = 200;
        const listArea  = document.getElementById('cartEventListArea');
        if (!events.length) {
            listArea.innerHTML = '<div style="text-align:center;color:#aaa;padding:24px;">暫無可用活動</div>';
            return;
        }
        listArea.innerHTML = events.map(e => {
            const eligible = e.isEligible;
            const inUse    = cartSelectedEvent && cartSelectedEvent.id === e.id;
            const gap      = e.minSpend - rawTotal;
            const nearMiss = !eligible && gap > 0 && gap <= NEAR_MISS;
            const border   = inUse ? '#1e8449' : '#e8e8e8';
            const bg       = inUse ? '#f0fdf4' : '#fff';
            const opacity  = eligible ? '1' : '0.45';
            const cursor   = eligible ? 'pointer' : 'default';
            const safeName = e.title.replace(/'/g, "\\'");
            const clickA   = eligible
                ? `onclick="applyCartEvent(${e.id},'${safeName}',${e.calculatedDiscount})"
                   onmouseover="this.style.background='#f0fdf4'"
                   onmouseout="this.style.background='${bg}'"` : '';
            const nearHtml = nearMiss
                ? `<div style="font-size:0.75rem;color:#e67e22;font-weight:700;margin-top:4px;">📌 再消費 NT$ ${gap.toLocaleString()} 可享此優惠</div>` : '';
            return `<div ${clickA} style="padding:12px 14px;border:2px solid ${border};border-radius:10px;
                         margin-bottom:8px;cursor:${cursor};transition:all 0.15s;background:${bg};opacity:${opacity};user-select:none;">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;">
                    <span style="font-weight:700;font-size:0.92rem;color:#1a1a1a;">${e.title}</span>
                    ${inUse ? '<span style="font-size:0.7rem;background:#27ae60;color:#fff;padding:1px 8px;border-radius:20px;font-weight:700;">使用中</span>' : ''}
                    ${!eligible && !nearMiss ? '<span style="font-size:0.7rem;background:#e0e0e0;color:#999;padding:1px 8px;border-radius:20px;font-weight:600;">不符合</span>' : ''}
                </div>
                <div style="font-size:0.83rem;color:#27ae60;font-weight:600;">${e.discountDescription}</div>
                <div style="font-size:0.74rem;color:#bbb;margin-top:3px;">最低消費 NT$ ${e.minSpend.toLocaleString()}</div>
                ${nearHtml}
            </div>`;
        }).join('');
    }

