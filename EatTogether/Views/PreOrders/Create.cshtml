    let rawCartTotal       = 0;
    let cartSelectedEvent  = null; // { id, title, discount }
    let cartItemNotes      = {};   // { productName: noteText }
    let cartSelectedCoupon = null; // { id, name, disc }

    // ── 折扣合計顯示 ──────────────────────────────────────
    function updateCartTotalDisplay() {
        const evDisc  = cartSelectedEvent  ? (cartSelectedEvent.discount  || 0) : 0;
        const cpDisc  = cartSelectedCoupon ? (cartSelectedCoupon.disc     || 0) : 0;
        const disc    = evDisc + cpDisc;
        const finalAmt = Math.max(0, rawCartTotal - disc);

        // 合計欄
        const totalSpan = document.getElementById('cartTotal');
        if (disc > 0) {
            totalSpan.innerHTML = `<span style="text-decoration:line-through;color:#bbb;font-size:0.85em;">${rawCartTotal.toLocaleString()}</span> ${finalAmt.toLocaleString()}`;
        } else {
            totalSpan.textContent = rawCartTotal.toLocaleString();
        }

        // 折扣列
        const discRow = document.getElementById('cartDiscountRow');
        if (disc > 0) {
            const parts = [];
            if (evDisc > 0 && cartSelectedEvent)  parts.push(`活動 -${evDisc}`);
            if (cpDisc > 0 && cartSelectedCoupon) parts.push(`優惠券 -${cpDisc}`);
            document.getElementById('cartDiscountLabel').textContent = parts.join('　');
            document.getElementById('cartDiscountAmt').textContent   = disc.toLocaleString();
            discRow.style.display = 'flex';
        } else {
            discRow.style.display = 'none';
        }

        document.getElementById('hiddenDiscountAmount').value = disc;
    }

    // ── 多通知系統 ────────────────────────────────────────
    const _nearMissDismissed = new Set(); // 已手動關閉的活動 id

    function renderNearMissNotifications(notifyList) {
        const container = document.getElementById('nearMissContainer');
        const newIds = new Set(notifyList.map(n => n.ev.id));

        // 移除不再需要的
        container.querySelectorAll('[data-ev-id]').forEach(el => {
            if (!newIds.has(parseInt(el.dataset.evId))) el.remove();
        });

        notifyList.forEach(({ ev, isEligible }) => {
            const gap = isEligible ? 0 : (ev.minSpend - rawCartTotal);
            const existing = container.querySelector(`[data-ev-id="${ev.id}"]`);

            if (existing) {
                if (existing.dataset.eligible === String(isEligible)) {
                    // 資格沒變：若仍未達門檻，只更新差額文字（不重建卡，不閃爍）
                    if (!isEligible) {
                        const gapEl = existing.querySelector('.near-miss-gap');
                        if (gapEl) gapEl.textContent = `NT$ ${gap.toLocaleString()}`;
                        existing.dataset.gap = String(gap);
                    }
                    return;
                }
                existing.remove(); // 資格改變 → 重建
            }

            const msg = isEligible
                ? `金額已達門檻，可參加<br>「<strong>${ev.title ?? ''}</strong>」活動！`
                : `再消費 <strong class="near-miss-gap">NT$ ${gap.toLocaleString()}</strong> 即可參加<br>「${ev.title ?? ''}」活動！`;

            const card = document.createElement('div');
            card.dataset.evId  = ev.id;
            card.dataset.eligible = String(isEligible);
            card.dataset.gap   = String(gap);
            const borderColor = isEligible ? '#27ae60' : '#e67e22';
            const textColor   = isEligible ? '#1a5c2e' : '#7d5a00';
            const icon        = isEligible ? '🎉' : '📌';
            card.style.cssText = `background:#fff;border:2px solid ${borderColor};border-radius:14px;` +
                'padding:12px 14px 12px 12px;box-shadow:0 6px 24px rgba(0,0,0,0.15);' +
                'animation:smIn 0.2s cubic-bezier(0.34,1.56,0.64,1);width:300px;';
            card.innerHTML =
                '<div style="display:flex;align-items:flex-start;gap:10px;">' +
                  `<span style="font-size:1.2rem;flex-shrink:0;">${icon}</span>` +
                  `<div style="font-size:0.88rem;color:${textColor};font-weight:600;line-height:1.6;flex:1;">` + msg + '</div>' +
                  '<button onclick="dismissNearMissById(' + ev.id + ')" title="關閉" ' +
                  'style="flex-shrink:0;border:none;background:none;font-size:1.1rem;color:#bbb;' +
                  'cursor:pointer;padding:0;line-height:1;margin-top:-2px;">✕</button>' +
                '</div>';
            container.appendChild(card);
        });
    }

    function dismissNearMissById(evId) {
        _nearMissDismissed.add(evId);
        const card = document.querySelector(`#nearMissContainer [data-ev-id="${evId}"]`);
        if (card) card.remove();
    }

    function clearNearMissNotifications() {
        document.getElementById('nearMissContainer').innerHTML = '';
    }

    // ── 活動按鈕獨立更新（永遠執行） ──────────────────────
    async function refreshEventBtn() {
        try {
            const res    = await fetch(`/PreOrders/GetCartEvents?amount=${rawCartTotal}`);
            const data   = await res.json();
            const events = Array.isArray(data) ? data : [];
            _cartEventsCache = events;

            // 若已選活動不再符合，清除
            if (cartSelectedEvent && !events.find(e => e.isEligible && e.id === cartSelectedEvent.id)) {
                cartSelectedEvent = null;
                document.getElementById('hiddenEventId').value = '';
                updateCartTotalDisplay();
            }

            const evBadge = document.getElementById('cartEventAvailBadge');
            const evClear = document.getElementById('cartEventClearBtn');
            const evBtn   = document.getElementById('cartEventBtn');
            const evLabel = document.getElementById('cartEventBtnLabel');

            if (cartSelectedEvent) {
                evLabel.textContent = cartSelectedEvent.title;
                evBadge.style.display = 'none';
                evClear.style.display = '';
                evBtn.style.borderColor = '#1e8449';
                evBtn.style.background  = '#f0fdf4';
                evBtn.style.color       = '#1e8449';
            } else {
                evLabel.textContent = '選擇活動';
                evClear.style.display = 'none';
                evBtn.style.borderColor = '#27ae60';
                evBtn.style.background  = '#fff';
                evBtn.style.color       = '#27ae60';
                if (events.length > 0) {
                    evBadge.textContent = `進行中的活動(${events.length}個)`;
                    evBadge.style.display = '';
                } else {
                    evBadge.style.display = 'none';
                }
            }

            // ── 多通知：已選活動時不顯示任何通知 ──────────────
            const notifyList = [];

            if (!cartSelectedEvent) {
                // 已達門檻但尚未選擇
                events.filter(e => e.isEligible)
                    .forEach(e => {
                        if (!_nearMissDismissed.has(e.id))
                            notifyList.push({ ev: e, isEligible: true });
                    });

                // 差距 ≤200 且尚未達門檻
                events.filter(e => !e.isEligible && (e.minSpend - rawCartTotal) > 0 && (e.minSpend - rawCartTotal) <= 200)
                    .forEach(e => {
                        if (!_nearMissDismissed.has(e.id))
                            notifyList.push({ ev: e, isEligible: false });
                    });
            }

            if (notifyList.length > 0) {
                renderNearMissNotifications(notifyList);
            } else {
                clearNearMissNotifications();
            }
        } catch(err) {
            console.error('[refreshEventBtn]', err);
        }
    }

    // ── 優惠券按鈕更新（選完會員才顯示） ─────────────────
    async function refreshCartDiscounts() {
        const section = document.getElementById('cartDiscountSection');

        // 活動按鈕永遠更新
        refreshEventBtn();

        if (!cartMemberId) {
            section.style.display = 'none';
            if (cartSelectedCoupon) {
                cartSelectedCoupon = null;
                document.getElementById('hiddenCouponId').value = '';
                updateCartTotalDisplay();
            }
            return;
        }

        try {
            const cpRes   = await fetch(`/PreOrders/GetCartCoupons?amount=${rawCartTotal}&memberId=${cartMemberId}`);
            const cpData  = await cpRes.json();
            const coupons = Array.isArray(cpData) ? cpData : [];

            if (cartSelectedCoupon && !coupons.find(c => c.isClaimed && !c.isUsedByMember && c.isEligible && c.id === cartSelectedCoupon.id)) {
                cartSelectedCoupon = null;
                document.getElementById('hiddenCouponId').value = '';
                updateCartTotalDisplay();
            }

            const cpAvail = coupons.filter(c => c.isClaimed && !c.isUsedByMember && c.isEligible).length;
            const cpBadge = document.getElementById('cartCouponAvailBadge');
            const cpClear = document.getElementById('cartCouponClearBtn');
            const cpBtn   = document.getElementById('cartCouponBtn');
            const cpLabel = document.getElementById('cartCouponBtnLabel');
            if (cartSelectedCoupon) {
                cpLabel.textContent = `🎫 ${cartSelectedCoupon.name}`;
                cpBadge.style.display = 'none';
                cpClear.style.display = '';
                cpBtn.classList.add('selected');
            } else {
                cpLabel.textContent = '🎫 選擇優惠券';
                cpClear.style.display = 'none';
                cpBtn.classList.remove('selected');
                if (cpAvail > 0) { cpBadge.textContent = `${cpAvail} 可用`; cpBadge.style.display = ''; }
                else cpBadge.style.display = 'none';
            }

            section.style.display = 'block';
        } catch(err) {
            console.error('[refreshCartDiscounts]', err);
            section.style.display = 'block';
        }
    }

