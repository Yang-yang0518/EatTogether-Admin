    .sm-qty-btn {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 2px solid #ddd;
        background: #fff;
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        transition: all 0.15s;
        line-height: 1;
        flex-shrink: 0;
    }

