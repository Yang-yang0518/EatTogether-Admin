    }

    function _renderCartCouponList(coupons) {
        const rawTotal  = rawCartTotal;
        const NEAR_MISS = 200;
        const listArea  = document.getElementById('cartCouponListArea');
        const showable  = coupons.filter(c => c.isClaimed && !c.isUsedByMember);
        if (!showable.length) {
            listArea.innerHTML = '<div style="text-align:center;color:#aaa;padding:24px;">暫無可用優惠券</div>';
            return;
        }
        listArea.innerHTML = showable.map(c => {
            const eligible = c.isEligible;
            const inUse    = cartSelectedCoupon && cartSelectedCoupon.id === c.id;
            const gap      = c.minSpend - rawTotal;
            const nearMiss = !eligible && gap > 0 && gap <= NEAR_MISS;
            const disc     = c.discountType === 0 ? c.discountValue : Math.floor(rawTotal * c.discountValue / 100);
            const border   = inUse ? '#92610b' : '#e8e8e8';
            const bg       = inUse ? '#fffbeb' : '#fff';
            const opacity  = eligible ? '1' : '0.45';
            const cursor   = eligible ? 'pointer' : 'default';
            const safeName = c.name.replace(/'/g, "\\'");
            const clickA   = eligible
                ? `onclick="applyCartCoupon(${c.id},'${safeName}',${disc})"
                   onmouseover="this.style.background='#fffbeb'"
                   onmouseout="this.style.background='${bg}'"` : '';
            const nearHtml = nearMiss
                ? `<div style="font-size:0.75rem;color:#e67e22;font-weight:700;margin-top:4px;">📌 再消費 NT$ ${gap.toLocaleString()} 可用此優惠券</div>` : '';
            return `<div ${clickA} style="padding:12px 14px;border:2px solid ${border};border-radius:10px;
                         margin-bottom:8px;cursor:${cursor};transition:all 0.15s;background:${bg};opacity:${opacity};user-select:none;">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;">
                    <span style="font-weight:700;font-size:0.92rem;color:#1a1a1a;">${c.name}</span>
                    <span style="font-size:0.78rem;color:#888;font-weight:500;">${c.code}</span>
                    ${inUse ? '<span style="font-size:0.7rem;background:#b7770d;color:#fff;padding:1px 8px;border-radius:20px;font-weight:700;">使用中</span>' : ''}
                    ${!eligible && !nearMiss ? '<span style="font-size:0.7rem;background:#e0e0e0;color:#999;padding:1px 8px;border-radius:20px;font-weight:600;">不符合</span>' : ''}
                </div>
                <div style="font-size:0.83rem;color:#b7770d;font-weight:600;">${c.discountDescription}</div>
                <div style="font-size:0.74rem;color:#bbb;margin-top:3px;">最低消費 NT$ ${c.minSpend.toLocaleString()}</div>
                ${nearHtml}
            </div>`;
        }).join('');
    }

