@model EatTogether.Models.ViewModels.CreatePreOrderViewModel

@{
    ViewData["Title"] = "Create";
}

<style>
    .order-wrap {
        margin: 0;
        padding: 0;
        height: 88.2vh;
        overflow: hidden;
    }

    /* form = 橫向 flex：左購物車 + 右點餐區 */
    #orderForm {
        display: flex;
        flex-direction: row;
        height: 100%;
        overflow: hidden;
    }

    /* ── 左側購物車 ── */
    .cart-panel {
        width: 300px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        border-left: 2px solid #e8e0d8;
        background: #fafafa;
        overflow: hidden;
    }

    .cart-header {
        padding: 14px 16px 10px;
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a1a;
        border-bottom: 1px solid #e8e0d8;
        flex-shrink: 0;
    }

    .cart-items {
        flex: 1;
        overflow-y: auto;
        padding: 8px 12px;
        min-height: 0;
    }

    .cart-empty {
        text-align: center;
        color: #bbb;
        font-size: 0.85rem;
        padding: 32px 0;
    }

    .cart-item-row {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 4px;
        border-bottom: 1px solid #f0f0f0;
        font-size: 0.85rem;
    }

    .cart-item-name {
        flex: 1;
        font-weight: 600;
        color: #1a1a1a;
        line-height: 1.3;
        word-break: break-all;
    }

    .cart-item-sub {
        font-weight: 700;
        color: #c0392b;
        white-space: nowrap;
        font-size: 0.82rem;
        min-width: 52px;
        text-align: right;
    }

    .cart-item-del {
        background: none;
        border: none;
        color: #ccc;
        cursor: pointer;
        font-size: 0.9rem;
        padding: 0 2px;
        line-height: 1;
        flex-shrink: 0;
        transition: color 0.15s;
    }

        .cart-item-del:hover { color: #c0392b; }

    .cart-sub-items {
        padding: 3px 4px 6px 8px;
        border-bottom: 1px solid #f0f0f0;
    }

    .cart-sub-item {
        font-size: 0.76rem;
        color: #888;
        line-height: 1.6;
    }

        .cart-sub-item::before { content: '• '; }

    .cart-qty-wrap {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-shrink: 0;
    }

    .cart-qty-btn {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 1.5px solid #ddd;
        background: #fff;
        font-size: 0.95rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        transition: all 0.15s;
        line-height: 1;
        padding: 0;
        flex-shrink: 0;
    }

        .cart-qty-btn:hover {
            border-color: #c0392b;
            color: #c0392b;
        }

    .cart-qty-val {
        min-width: 18px;
        text-align: center;
        font-weight: 700;
        font-size: 0.88rem;
        color: #1a1a1a;
    }

    /* ── 購物車：會員按鈕 ── */
    .cart-member-section {
        flex-shrink: 0;
        padding: 10px 12px 8px;
        border-top: 1px solid #e8e0d8;
        background: #fff;
    }

    .cart-member-btn {
        width: 100%;
        padding: 8px 12px;
        border: 1.5px solid #8e44ad;
        border-radius: 9px;
        background: #fff;
        color: #8e44ad;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.15s;
        text-align: left;
        white-space: nowrap;
        overflow: hidden;
    }

        .cart-member-btn:hover { background: #f5eeff; }

        .cart-member-btn.has-member {
            border-color: #6c2ba0;
            background: #f5eeff;
            color: #5b2d8e;
        }

    /* ── 會員搜尋 Modal ── */
    .cm-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 10000;
        align-items: center;
        justify-content: center;
    }

        .cm-overlay.show { display: flex; }

    .cm-box {
        background: #fff;
        border-radius: 16px;
        padding: 24px 24px 20px;
        width: 380px;
        max-width: 92vw;
        box-shadow: 0 12px 40px rgba(0,0,0,0.2);
        font-family: 'Noto Sans TC', sans-serif;
        animation: smIn 0.18s cubic-bezier(0.34,1.56,0.64,1);
    }

    .cm-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 14px;
    }

    .cm-current {
        display: none;
        margin-bottom: 12px;
        padding: 10px 14px;
        background: #f5eeff;
        border: 1.5px solid #c39be0;
        border-radius: 10px;
        font-size: 0.88rem;
    }

    .cm-current-label {
        font-weight: 700;
        color: #6c2ba0;
        margin-bottom: 2px;
        font-size: 0.8rem;
    }

    .cm-current-name { color: #3d1a5f; font-weight: 600; }

    .cm-search-row {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
    }

    .cm-phone-input {
        flex: 1;
        padding: 9px 13px;
        border: 1.5px solid #ddd;
        border-radius: 8px;
        font-family: inherit;
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.15s;
    }

        .cm-phone-input:focus { border-color: #8e44ad; }

    .cm-search-btn {
        padding: 9px 16px;
        background: #8e44ad;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.15s;
    }

        .cm-search-btn:hover { background: #732d91; }

    .cm-result { min-height: 48px; margin-bottom: 14px; }

    .cm-actions {
        display: flex;
        gap: 8px;
        margin-top: 4px;
    }

    .cm-btn {
        flex: 1;
        padding: 10px;
        border-radius: 9px;
        border: none;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        transition: background 0.15s;
    }

    .cm-btn-cancel  { background: #f0f0f0; color: #555; }
    .cm-btn-cancel:hover { background: #e0e0e0; }
    .cm-btn-clear   { background: #888; color: #fff; display:none; }
    .cm-btn-clear:hover { background: #666; }

    /* 搜尋結果卡片（可點擊帶入） */
    .cm-member-card {
        padding: 12px 14px;
        border: 1.5px solid #c39be0;
        border-radius: 10px;
        background: #faf5ff;
        cursor: pointer;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 4px;
    }

        .cm-member-card:hover {
            border-color: #8e44ad;
            background: #ede0ff;
        }

    .cm-member-card-hint {
        font-size: 0.75rem;
        color: #aaa;
        text-align: center;
        margin-top: 4px;
    }

    /* ── 購物車：折扣按鈕列 ── */
    .cart-discount-section {
        flex-shrink: 0;
        padding: 8px 12px;
        border-top: 1px solid #e8e0d8;
        background: #fff;
        display: none;
    }

    .cart-disc-btn-row {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .cart-disc-btn {
        width: 100%;
        padding: 7px 10px;
        border-radius: 9px;
        border: 1.5px solid;
        background: #fff;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.82rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 5px;
        transition: all 0.15s;
        overflow: hidden;
        white-space: nowrap;
        min-width: 0;
    }

    .cart-disc-near-miss {
        display: none;
        font-size: 0.73rem;
        color: #e67e22;
        font-weight: 600;
        padding: 2px 2px 0;
    }

    .cart-disc-btn.event-btn  { border-color: #27ae60; color: #27ae60; }
    .cart-disc-btn.coupon-btn { border-color: #b7770d; color: #b7770d; }

    .cart-disc-btn.event-btn:hover  { background: #f0fdf4; }
    .cart-disc-btn.coupon-btn:hover { background: #fffbeb; }

    .cart-disc-btn.event-btn.selected  { background: #f0fdf4; border-color: #1e8449; }
    .cart-disc-btn.coupon-btn.selected { background: #fffbeb; border-color: #92610b; }

    .cart-disc-btn .btn-label {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        min-width: 0;
        flex: 1;
        text-align: left;
    }

    .cart-disc-avail-badge {
        display: none;
        flex-shrink: 0;
        font-size: 0.65rem;
        font-weight: 700;
        border-radius: 20px;
        padding: 1px 6px;
        line-height: 1.5;
        color: #fff;
    }

    .event-btn  .cart-disc-avail-badge { background: #27ae60; }
    .coupon-btn .cart-disc-avail-badge { background: #b7770d; }

    .cart-disc-clear {
        display: none;
        flex-shrink: 0;
        font-size: 0.95rem;
        line-height: 1;
        margin-left: 1px;
    }

    .cart-footer {
        flex-shrink: 0;
        border-top: 2px solid #e8e0d8;
        padding: 10px 16px 12px;
        background: #fff;
    }

    .cart-total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 10px;
    }

    .cart-total-amt {
        font-size: 1.2rem;
        color: #c0392b;
    }

    /* ── 右側點餐區 ── */
    .order-right {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-width: 0;
    }

    .order-top {
        flex-shrink: 0;
        padding: 10px 16px 0;
    }

    .menu-scroll-area {
        flex: 1;
        overflow-y: auto;
        padding: 8px 16px;
        min-height: 0;
    }

    .order-bottom {
        flex-shrink: 0;
        padding: 10px 16px 14px;
        border-top: 2px solid #e8e0d8;
        background: #fff;
        display: flex;
        align-items: flex-end;
        gap: 12px;
    }

    .order-bottom .note-wrap {
        flex: 1;
        margin-bottom: 0;
    }

    .order-bottom .btn-next {
        flex-shrink: 0;
        width: auto;
        padding: 12px 32px;
        white-space: nowrap;
    }

    .page-header {
        display: flex;
        align-items: flex-end;
        gap: 16px;
        margin-bottom: 10px;
        padding-bottom: 10px;
        border-bottom: 2px solid #e8e0d8;
    }

    .page-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: #1a1a1a;
        letter-spacing: -0.02em;
    }

    .page-sub {
        color: #999;
        font-size: 0.9rem;
        padding-bottom: 4px;
    }

    /* ── 內用/外帶 ── */
    .section-title {
        font-weight: 700;
        font-size: 1rem;
        color: #333;
        margin-bottom: 12px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .toggle-wrap {
        display: flex;
        gap: 12px;
        margin-bottom: 10px;
    }

    .toggle-btn {
        flex: 1;
        padding: 10px 20px;
        border: 2px solid #ddd;
        border-radius: 12px;
        background: #fff;
        cursor: pointer;
        font-size: 1rem;
        font-family: inherit;
        font-weight: 500;
        color: #555;
        white-space: nowrap;
        transition: all 0.2s;
        text-align: center;
    }

        .toggle-btn.active {
            border-color: #c0392b;
            background: #fff5f5;
            color: #c0392b;
            font-weight: 700;
        }

    .form-select, .form-control {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #ddd;
        border-radius: 10px;
        font-size: 0.95rem;
        font-family: inherit;
        background: #fff;
        color: #333;
        outline: none;
        transition: border-color 0.2s;
    }

        .form-select:focus, .form-control:focus {
            border-color: #c0392b;
        }

    /* ── 分類區塊 ── */
    .category-section {
        margin-bottom: 36px;
    }

    .category-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
    }

    .category-icon {
        font-size: 1.4rem;
        line-height: 1;
    }

    .category-name {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--cat-color);
        letter-spacing: 0.06em;
        white-space: nowrap;
    }

    .category-line {
        flex: 1;
        height: 2px;
        background: linear-gradient(to right, var(--cat-color), transparent);
        opacity: 0.3;
        border-radius: 2px;
    }

    /* ── 菜單卡片升級 ── */
    .menu-card {
        background: #fff;
        border-radius: 12px;
        padding: 12px 14px;
        border: 2px solid #eee;
        transition: all 0.2s;
        position: relative;
        overflow: hidden;
    }

        .menu-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--card-accent, #ccc);
            opacity: 0;
            transition: opacity 0.2s;
        }

        .menu-card:hover {
            border-color: var(--card-accent, #c0392b);
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
            transform: translateY(-2px);
        }

            .menu-card:hover::before {
                opacity: 1;
            }

        .menu-card.selected {
            border-color: var(--card-accent, #c0392b);
            background: #fffaf8;
        }

            .menu-card.selected::before {
                opacity: 1;
            }


    /* ── 菜單 ── */
    .menu-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 10px;
        margin-bottom: 0;
    }

    .menu-name {
        font-weight: 700;
        font-size: 0.88rem;
        color: #1a1a1a;
        margin-bottom: 2px;
        line-height: 1.4;
    }

    .menu-price {
        color: var(--card-accent, #c0392b);
        font-weight: 700;
        font-size: 0.85rem;
        margin-bottom: 10px;
    }

    .qty-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .qty-btn {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 2px solid #ddd;
        background: #fff;
        font-size: 1.1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        transition: all 0.15s;
        line-height: 1;
    }

        .qty-btn:hover {
            border-color: #c0392b;
            color: #c0392b;
        }

    .qty-input {
        width: 36px;
        text-align: center;
        border: 2px solid #ddd;
        border-radius: 6px;
        padding: 3px;
        font-size: 0.95rem;
        font-family: inherit;
        outline: none;
    }

        .qty-input:focus {
            border-color: #c0392b;
        }

    /* ── 備註 ── */
    .note-wrap {
        margin-bottom: 16px;
    }

    textarea.form-control {
        resize: vertical;
        min-height: 52px;
        font-size: 0.88rem;
        padding: 8px 12px;
    }

    /* ── 送出 ── */
    .btn-next {
        display: block;
        width: 100%;
        padding: 16px;
        background: #c0392b;
        color: #fff;
        border: none;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition: background 0.2s;
        letter-spacing: 0.05em;
    }

        .btn-next:hover {
            background: #a93226;
        }

    .alert-danger {
        background: #fff5f5;
        border: 1px solid #f5c6cb;
        color: #721c24;
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 0.9rem;
    }


    /* ── 套餐 Modal ── */
    /* ── 分類 Tab ── */
    .cat-tabs {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .cat-tab-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 18px;
        border-radius: 24px;
        border: 2px solid #e0e0e0;
        background: #fff;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 600;
        color: #666;
        cursor: pointer;
        transition: all 0.18s;
        white-space: nowrap;
        position: relative;
    }

        .cat-tab-btn:hover {
            border-color: var(--tab-color);
            color: var(--tab-color);
            background: color-mix(in srgb, var(--tab-color) 8%, #fff);
        }

        .cat-tab-btn.active {
            border-color: var(--tab-color);
            background: var(--tab-color);
            color: #fff;
            box-shadow: 0 3px 10px color-mix(in srgb, var(--tab-color) 40%, transparent);
        }

        .cat-tab-btn .tab-badge {
            font-size: 0.72rem;
            background: rgba(0,0,0,0.18);
            color: inherit;
            padding: 1px 6px;
            border-radius: 20px;
            font-weight: 700;
        }

        .cat-tab-btn.active .tab-badge {
            background: rgba(255,255,255,0.3);
            color: #fff;
        }

    .setmeal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        .setmeal-overlay.show {
            display: flex;
        }

    .setmeal-box {
        background: #fff;
        border-radius: 20px;
        padding: 28px;
        width: 480px;
        max-width: 92vw;
        max-height: 80vh;
        overflow-y: auto;
        box-shadow: 0 16px 48px rgba(0,0,0,0.2);
        font-family: 'Noto Sans TC', sans-serif;
        animation: smIn 0.2s cubic-bezier(0.34,1.56,0.64,1);
        position: relative;
    }

    @@keyframes smIn {
        from {
            transform: scale(0.88);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .setmeal-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 4px;
    }

    .setmeal-price {
        font-size: 0.88rem;
        color: #c0392b;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .setmeal-group {
        margin-bottom: 18px;
    }

    .setmeal-group-title {
        font-size: 0.8rem;
        font-weight: 700;
        color: #888;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 10px;
        padding-bottom: 6px;
        border-bottom: 1px solid #f0f0f0;
    }

    .setmeal-option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 12px;
        border-radius: 10px;
        border: 2px solid #eee;
        margin-bottom: 7px;
        cursor: pointer;
        transition: all 0.15s;
        font-size: 0.92rem;
    }

        .setmeal-option:hover {
            border-color: #e67e22;
            background: #fef9f0;
        }

        .setmeal-option.selected {
            border-color: #e67e22;
            background: #fef9f0;
        }

        .setmeal-option.dimmed {
            opacity: 0.35;
            pointer-events: none;
        }

        .setmeal-option input[type=checkbox],
        .setmeal-option input[type=radio] {
            accent-color: #e67e22;
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

    .sm-hint {
        font-size: 0.8rem;
        margin-bottom: 8px;
        font-weight: 600;
    }

        .sm-hint.neutral {
            color: #888;
        }

        .sm-hint.progress {
            color: #e67e22;
        }

        .sm-hint.done {
            color: #27ae60;
        }

    .setmeal-fixed-item {
        padding: 7px 12px;
        border-radius: 8px;
        background: #f8f8f8;
        font-size: 0.88rem;
        color: #555;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .setmeal-actions {
        display: flex;
        gap: 10px;
        margin-top: 22px;
    }

    .setmeal-btn-cancel {
        flex: 1;
        padding: 11px;
        border: 2px solid #ddd;
        border-radius: 10px;
        background: #fff;
        color: #555;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.92rem;
        cursor: pointer;
    }

    .setmeal-btn-confirm {
        flex: 1;
        padding: 11px;
        border: none;
        border-radius: 10px;
        background: #e67e22;
        color: #fff;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.92rem;
        cursor: pointer;
        transition: background 0.2s;
    }

        .setmeal-btn-confirm:hover {
            background: #d35400;
        }

    .setmeal-error {
        color: #c0392b;
        font-size: 0.82rem;
        margin-top: 4px;
