<script>
        let currentPreOrderId = null;
    let currentPayMethod  = null;
    let currentTotal      = 0;
    let currentTableId    = null;

    function switchTab(tab) {
        const isDine = tab === 'dine';
        document.querySelectorAll('.tab-btn').forEach((b, i) =>
            b.classList.toggle('active', isDine ? i === 0 : i === 1));
        document.getElementById('dineGrid').style.display = isDine ? 'grid' : 'none';
        document.getElementById('takeList').style.display = isDine ? 'none' : 'block';

        if (isDine) {
            // 切回內用 → 右側顯示「請選擇桌號」
            closeDetail();
            document.getElementById('emptyRightIcon').textContent = '🪑';
            document.getElementById('emptyRightText').textContent = '請選擇桌號';
        } else {
            // 切到外帶 → 自動載入第一筆外帶訂單
            const firstItem = document.querySelector('#takeList .takeout-item');
            if (firstItem) {
                const pid = parseInt(firstItem.dataset.preOrderId);
                if (pid) loadDetail(pid, firstItem);
            } else {
                closeDetail();
                document.getElementById('emptyRightIcon').textContent = '🥡';
                document.getElementById('emptyRightText').textContent = '目前沒有外帶訂單';
            }
        }
    }

    async function loadDetail(preOrderId, el) {
        const tableId = el?.dataset?.tableId;
        const url = tableId
            ? `/Payments/GetDetailByTable?tableId=${tableId}`
            : `/Payments/GetDetail?preOrderId=${preOrderId}`;

        const res  = await fetch(url);
        const data = await res.json();

        // 記錄當前 tableId 或 preOrderId
        currentPreOrderId = preOrderId;
        currentTableId    = tableId ? parseInt(tableId) : null;

        // 高亮選中
        document.querySelectorAll('.table-btn, .takeout-item')
                .forEach(b => b.classList.remove('active-selected'));
        el?.classList.add('active-selected');

        renderDetail(data);
    }

        function renderDetail(data) {
        // 1. 基礎防錯檢查：確保後端回傳的是有效物件
        if (!data || typeof data !== 'object') {
            console.error("後端未回傳有效的訂單資料", data);
            showAlert("資料讀取異常，請重新整理頁面。", '❌ 錯誤');
            return;
        }

        // 切換訂單時若拆單模式仍開啟，先關閉
        if (splitMode) exitSplitMode();

        // 2. 切換右側顯示狀態（隱藏空狀態，顯示結帳內容）
        document.getElementById('emptyRight').style.display = 'none';
        document.getElementById('checkoutContent').style.display = 'flex';

        // 3. 設定標題與副標題 (桌號/外帶、訂單編號)
        document.getElementById('rightTitle').textContent =
            data.inOrOut ? `🪑 ${data.tableName || ''}` : `🥡 外帶`;

        // 3b. 取餐時間列（外帶 + 有具體時間才顯示）
        const pickupBar  = document.getElementById('pickupTimeBar');
        const pickupText = document.getElementById('pickupTimeText');
        if (pickupBar && pickupText) {
            let pickupVal = '';
            if (!data.inOrOut && data.note) {
                // 解析 JSON 格式的 Note
                let orderPart = data.note;
                try {
                    const parsed = JSON.parse(data.note);
                    orderPart = parsed.order || '';
                } catch (e) { /* 舊格式純文字直接用 */ }
                // 找 "取餐時間：" 行
                for (const line of orderPart.split('\n')) {
                    const t = line.trim();
                    if (t.startsWith('取餐時間：')) {
                        pickupVal = t.substring('取餐時間：'.length).trim();
                        break;
                    }
                }
            }
            const show = pickupVal && pickupVal !== '即時取餐' && pickupVal !== '即時';
            pickupBar.style.display = show ? '' : 'none';
            pickupText.textContent  = show ? pickupVal : '';
        }

        // 副標題：多筆訂單 → 下拉選單；單筆 → 純文字
        const subtitleDiv  = document.getElementById('rightSubtitle');
        const orderSelect  = document.getElementById('orderSelect');
        const subOrders    = data.subOrders || [];
        if (subOrders.length > 1) {
            subtitleDiv.style.display  = 'none';
            orderSelect.style.display  = '';
            orderSelect.innerHTML =
                `<option value="">全部訂單（${subOrders.length} 筆）</option>` +
                subOrders.map(o =>
                    `<option value="${o.preOrderId}">${o.orderNumber}</option>`
                ).join('');
            orderSelect.value = '';   // 預設全部
        } else {
            subtitleDiv.style.display  = '';
            orderSelect.style.display  = 'none';
            subtitleDiv.textContent    = data.orderNumber || '-';
        }

        // 4. 判斷是否有「已出餐」的餐點（含套餐子項目）
        const hasServedItems = data.items &&
            data.items.some(item => !item.isBilled && item.status === 1);

        const warningArea = document.getElementById('unservedWarning');
        const warningText = warningArea.querySelector('p');
        const confirmBtn = warningArea.querySelector('.btn-yes');
        const checkoutBtn = document.getElementById('checkoutBtn');
        const cancelOrderBtn = document.getElementById('cancelOrderBtn');

        // 5. 處理「未出餐警告區塊」與「結帳按鈕」的顯示邏輯
        if (data.hasUnserved) {
            warningArea.style.display = 'block';
            checkoutBtn.classList.remove('show'); // 有未出餐時，隱藏正式結帳鈕

            if (!hasServedItems) {
                // 情況 A：整單都沒有已出餐的餐點 → 隱藏 header 整單取消（unservedWarning 已有）
                warningText.textContent = "⚠️ 此訂單所有餐點皆尚未出餐，確定要整單取消嗎？";
                confirmBtn.textContent = "是，整單取消";
                if (cancelOrderBtn) cancelOrderBtn.style.display = 'none';
            } else {
                // 情況 B：部分已出餐，部分未出餐 → 顯示 header 整單取消
                warningText.textContent = "⚠️ 有餐點尚未出餐完成，確定要結帳嗎？";
                confirmBtn.textContent = "是，取消未出餐並結帳";
                if (cancelOrderBtn) cancelOrderBtn.style.display = '';
            }
        } else {
            warningArea.style.display = 'none';
            checkoutBtn.classList.add('show'); // 全部出餐完畢，顯示正式結帳鈕
            // 全部出餐完畢仍可整單取消（例如客人反悔）
            if (cancelOrderBtn) cancelOrderBtn.style.display = '';
        }

        // 5b. 依據餐點完成狀態控制 更換桌位 的顯示；整單取消由 section 5 決定
        //     allCompleted = 所有父層餐點均已取消(2) 或已結帳(isBilled)，才真正「完成」
        const topLevelItems = data.items ? data.items.filter(i => !i.parentDetailId) : [];
        const allCompleted = topLevelItems.length > 0 &&
            topLevelItems.every(item => item.status === 2 || item.isBilled === true);

        const editTableBtn = document.getElementById('editTableBtn');
        const memberBtn    = document.getElementById('memberBtn');
        if (allCompleted) {
            // 全部已取消或已結帳 → 隱藏整單取消和更換桌位
            if (cancelOrderBtn) cancelOrderBtn.style.display = 'none';
            if (editTableBtn)   editTableBtn.style.display   = 'none';
            if (memberBtn)      memberBtn.style.display       = 'none';
        } else {
            // 尚有可操作餐點 → 顯示按鈕；整單取消由上方 section 5 的狀態決定，不在此覆蓋
            if (editTableBtn) editTableBtn.style.display = '';
            if (memberBtn)    memberBtn.style.display    = '';
        }

        // 更新會員按鈕標籤
        updateMemberBtnDisplay(data);


        const splitModeBtn = document.getElementById('splitModeBtn');
        if (splitModeBtn) {
            // 外帶不顯示拆單，內用且無待處理餐點才顯示
            splitModeBtn.style.display = (data.inOrOut && !data.hasUnserved) ? '' : 'none';
        }

        // 6. 渲染餐點明細表格
        currentData = data;
        renderItemsTable(data.items);

        // 8. 更新金額資訊（全部訂單模式）
        renderAmounts(data.items, data);

        // 8b. 優惠按鈕列
        renderDiscountBtns(data);

        // 9. 更新全域變數與付款狀態
        currentTotal     = data.totalAmount;
        currentPayMethod = data.payMethod;

        selectPayMethod(data.payMethod);
        document.getElementById('cashInput').value = '';
        document.getElementById('changeDisplay').textContent = '-';

        // 10. 設定 Hidden Input 給 Form 使用
        const checkoutTableIdInput = document.getElementById('checkoutTableId');
        if (currentTableId) {
            document.getElementById('checkoutForm').action = '/Payments/CheckoutByTable';
            checkoutTableIdInput.name = 'tableId';
            checkoutTableIdInput.value = currentTableId;
        } else {
            document.getElementById('checkoutForm').action = '/Payments/Checkout';
            checkoutTableIdInput.name = 'preOrderId';
            checkoutTableIdInput.value = data.preOrderId;
        }
    }

    // ── 修改訂單桌位／內外帶 ──
    let editIsInOrOut = true;
    let editOriginalTableId = null;

    async function openEditOrderModal() {
        // 初始化目前狀態
        editIsInOrOut      = !!currentTableId; // 有 tableId 就是內用
        editOriginalTableId = currentTableId;
        setEditMode(editIsInOrOut);

        // 載入空桌清單
        const select = document.getElementById('editTableSelect');
        select.innerHTML = '<option value="">載入中...</option>';
        try {
            const res  = await fetch('/Payments/AvailableTables');
            const data = await res.json();

            select.innerHTML = '';
            // 若目前是內用，先加回目前桌位（保持不換）
            if (currentTableId) {
                const currentTableName = document.getElementById('rightTitle').textContent.replace('🪑 ', '');
                select.innerHTML += `<option value="${currentTableId}">${currentTableName}（目前）</option>`;
            }
            if (data.length === 0 && !currentTableId) {
                select.innerHTML = '<option value="">目前沒有空桌</option>';
            } else {
                data.forEach(t => {
                    select.innerHTML += `<option value="${t.tableId}">${t.tableName}</option>`;
                });
            }
        } catch {
            select.innerHTML = '<option value="">載入失敗，請重試</option>';
        }

        document.getElementById('editOrderModal').classList.add('show');
    }

    function setEditMode(isDine) {
        editIsInOrOut = isDine;
        const dineBtn    = document.getElementById('editBtnDine');
        const takeoutBtn = document.getElementById('editBtnTakeout');
        const tableSection = document.getElementById('editTableSection');

        dineBtn.style.border    = isDine ? '2px solid #2c3e50' : '2px solid #ddd';
        dineBtn.style.background = isDine ? '#eaf0fb' : '#fff';
        dineBtn.style.color      = isDine ? '#2c3e50' : '#888';
        takeoutBtn.style.border    = !isDine ? '2px solid #7f8c8d' : '2px solid #ddd';
        takeoutBtn.style.background = !isDine ? '#f0f0f0' : '#fff';
        takeoutBtn.style.color      = !isDine ? '#555' : '#888';
        tableSection.style.display  = isDine ? '' : 'none';
    }

    async function submitEditOrder() {
        const tableId = editIsInOrOut
            ? parseInt(document.getElementById('editTableSelect').value) || null
            : null;

        if (editIsInOrOut && !tableId) {
            showAlert('請選擇桌位', '⚠️ 提示');
            return;
        }

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const res = await fetch('/Payments/UpdateOrderTable', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `preOrderId=${currentPreOrderId}&tableId=${tableId ?? ''}&inOrOut=${editIsInOrOut}`
            });
            if (!res.ok) throw new Error();
            const data = await res.json();

            document.getElementById('editOrderModal').classList.remove('show');

            // 先取舊桌資訊（renderDetail 之前讀取）
            const orderBtn = document.getElementById('tbtn-' + currentPreOrderId);
            const oldTableId = editOriginalTableId;
            const oldTableName = orderBtn?.querySelector('.table-name')?.textContent || '';

            // 更新右側 header 顯示
            currentTableId = tableId;
            renderDetail(data);

            // 更新左側桌位格子
            const wasDineIn = !!oldTableId;
            const nowDineIn = !!tableId;

            if (wasDineIn && nowDineIn && tableId !== oldTableId) {
                // 內用換桌：將訂單按鈕移到新桌位，舊桌位還原為空桌
                orderBtn.dataset.tableId = tableId;
                const nameSpan = orderBtn.querySelector('.table-name');
                if (nameSpan) nameSpan.textContent = data.tableName || '';

                const newTableDiv = document.querySelector(`[data-tableid="${tableId}"]`);
                if (newTableDiv) {
                    const orderBtnNext  = orderBtn.nextSibling;
                    const newTableDivNext = newTableDiv.nextSibling;
                    const grid = orderBtn.parentNode;

                    if (newTableDivNext) grid.insertBefore(orderBtn, newTableDivNext);
                    else grid.appendChild(orderBtn);

                    newTableDiv.dataset.tableid = oldTableId;
                    newTableDiv.setAttribute('onclick', `selectTable(${oldTableId})`);
                    const oldNameSpan = newTableDiv.querySelector('.table-name');
                    if (oldNameSpan) oldNameSpan.textContent = oldTableName;

                    if (orderBtnNext) grid.insertBefore(newTableDiv, orderBtnNext);
                    else grid.appendChild(newTableDiv);
                }
            } else if (wasDineIn !== nowDineIn) {
                // 內用↔外帶切換：DOM 結構差異大，整頁重載
                window.location.href = '/Payments/Create';
            }
            // 同桌位不換：不需更新左側
        } catch {
            showAlert('修改失敗，請重試。', '❌ 錯誤');
        }
    }

    // ── 自訂 alert 對話框 ──
    function showAlert(message, title = '提示') {
        document.getElementById('alertTitle').textContent = title;
        document.getElementById('alertBody').textContent  = message;
        const overlay = document.getElementById('customAlertModal');
        overlay.classList.add('show');
        overlay.addEventListener('click', e => {
            if (e.target === overlay) overlay.classList.remove('show');
        }, { once: true });
    }

    // ── 自訂 confirm 對話框 ──
    function showConfirm(message, onConfirm, title = '確認操作', confirmLabel = '確認', cancelLabel = '返回') {
        document.getElementById('modalTitle').textContent = title;
        const bodyEl = document.getElementById('modalBody');
        bodyEl.textContent  = message;
        bodyEl.style.display = message ? '' : 'none';
        const overlay     = document.getElementById('customConfirmModal');
        const confirmBtn  = document.getElementById('modalConfirmBtn');
        const cancelBtn   = document.getElementById('modalCancelBtn');
        overlay.classList.add('show');
        // 移除舊的 listener
        const newConfirm = confirmBtn.cloneNode(true);
        const newCancel  = cancelBtn.cloneNode(true);
        newConfirm.textContent = confirmLabel;
        newCancel.textContent  = cancelLabel;
        confirmBtn.replaceWith(newConfirm);
        cancelBtn.replaceWith(newCancel);
        newConfirm.addEventListener('click', () => {
            overlay.classList.remove('show');
            onConfirm();
        });
        newCancel.addEventListener('click', () => overlay.classList.remove('show'));
        overlay.addEventListener('click', e => {
            if (e.target === overlay) overlay.classList.remove('show');
        }, { once: true });
    }

    async function confirmCancelUnserved() {
        const confirmBtn = document.querySelector('.btn-yes');
        const actionText = confirmBtn.textContent;

        const isFullCancel = actionText === '是，整單取消';

        // 整單取消 + 多筆訂單 → 開啟選擇哪一單的 Modal
        if (isFullCancel && currentTableId && currentData?.subOrders?.length > 1) {
            openCancelOrderModal();
            return;
        }

        const title   = isFullCancel ? '確定要整單取消嗎？' : '確定要取消未出餐並結帳嗎？';
        const message = isFullCancel ? '所有餐點都會取消，此操作無法復原。' : '未出餐的餐點將會取消，已完成的餐點會正常結帳。';
        const label   = isFullCancel ? '整單取消' : '確認';

        showConfirm(message, () => _doCancelUnserved(actionText), title, label, '返回');
    }

    async function _doCancelUnserved(actionText) {
        const isFullCancel = actionText === "是，整單取消";

        // 整單取消：內用 → CancelAllByTable（取消整桌所有訂單）；外帶 → CancelOrder（取消單筆）
        // 取消未出餐並結帳 → /Payments/CancelUnservedByTable 或 /Payments/CancelUnserved
        const url  = isFullCancel
            ? (currentTableId ? '/PreOrders/CancelAllByTable' : '/PreOrders/CancelOrder')
            : (currentTableId ? '/Payments/CancelUnservedByTable' : '/Payments/CancelUnserved');
        const body = isFullCancel
            ? (currentTableId ? `tableId=${currentTableId}` : `preOrderId=${currentPreOrderId}`)
            : (currentTableId ? `tableId=${currentTableId}` : `preOrderId=${currentPreOrderId}`);

        try {
            const res = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body
            });

            if (!res.ok) throw new Error("伺服器回應錯誤");

            const data = await res.json();

            if (isFullCancel) {
                const tbody = document.getElementById('detailBody');
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" style="text-align:center; padding:40px; color:#27ae60; font-size:1.1rem; font-weight:700; background-color:#f4fdf7;">
                            ✅ 訂單已整單取消成功
                        </td>
                    </tr>`;
                document.getElementById('amtOriginal').textContent = '-';
                document.getElementById('amtDiscount').textContent = '-';
                document.getElementById('amtTotal').textContent = '-';
                document.getElementById('unservedWarning').style.display = 'none';
                document.getElementById('checkoutBtn').classList.remove('show');
                setTimeout(() => window.location.href = "/Payments/Create", 1500);
            } else {
                // 取消未出餐並結帳，正常重新渲染明細
                renderDetail(data);
            }
        } catch (err) {
            console.error(err);
            showAlert("執行失敗，請檢查網路連線。", '❌ 錯誤');
        }
    }

    // 開啟「選擇取消哪一單」的 Modal（多筆）或直接取消（單筆 / 外帶）
    function openCancelOrderModal() {
        // 外帶訂單或只有一筆 → 直接整單取消
        if (!currentTableId || !currentData?.subOrders || currentData.subOrders.length <= 1) {
            cancelEntireOrderAll();
            return;
        }

        // 多筆訂單 → 顯示選擇 Modal
        const area = document.getElementById('cancelOrderListArea');
        area.innerHTML = currentData.subOrders.map(o => {
            const unservedBadge = o.hasUnserved
                ? `<span style="font-size:0.75rem;background:#fff3cd;color:#856404;
                              border-radius:8px;padding:2px 8px;margin-left:6px;font-weight:700;">未出餐</span>`
                : '';
            return `
            <div style="display:flex;align-items:center;justify-content:space-between;
                         padding:12px 14px;border:1.5px solid #e8e8e8;border-radius:10px;
                         margin-bottom:8px;background:#fff;">
                <div>
                    <div style="font-weight:700;font-size:0.92rem;color:#1a1a1a;">
                        ${o.orderNumber}${unservedBadge}
                    </div>
                    <div style="font-size:0.82rem;color:#888;margin-top:3px;">
                        NT$ ${o.amount.toLocaleString()}
                    </div>
                </div>
                <button type="button"
                        onclick="cancelSingleOrder(${o.preOrderId})"
                        style="padding:6px 14px;border:1.5px solid #c0392b;border-radius:8px;
                               background:#fff;color:#c0392b;font-family:inherit;
                               font-weight:700;font-size:0.82rem;cursor:pointer;">
                    取消此單
                </button>
            </div>`;
        }).join('');

        document.getElementById('cancelOrderSelectModal').classList.add('show');
    }

    // 取消單一 PreOrder，取消後若桌上還有其他訂單則重新渲染；否則重整頁面
    function cancelSingleOrder(preOrderId) {
        document.getElementById('cancelOrderSelectModal').classList.remove('show');
        showConfirm(
            '此筆訂單的所有餐點都會取消，此操作無法復原。',
            async () => {
                try {
                    const res = await fetch('/PreOrders/CancelOrder', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: `preOrderId=${preOrderId}`
                    });
                    if (!res.ok) throw new Error();
                    const result = await res.json();
                    if (!result.success) throw new Error();

                    // 重新載入該桌資料
                    const fresh = await fetch(`/Payments/GetDetailByTable?tableId=${currentTableId}`);
                    if (fresh.ok) {
                        const data = await fresh.json();
                        currentData = data;
                        renderDetail(data);
                    } else {
                        // 已無剩餘訂單
                        setTimeout(() => window.location.href = '/Payments/Create', 500);
                    }
                } catch {
                    showAlert('執行失敗，請檢查網路連線。', '❌ 錯誤');
                }
            },
            '確定要取消此筆訂單嗎？',
            '取消此單',
            '返回'
        );
    }

    // 取消整桌（或外帶單筆）所有訂單
    function cancelEntireOrderAll() {
        document.getElementById('cancelOrderSelectModal').classList.remove('show');
        showConfirm(
            '所有餐點（包含已完成）都會取消，此操作無法復原。',
            async () => {
                try {
                    const url  = currentTableId ? '/PreOrders/CancelAllByTable' : '/PreOrders/CancelOrder';
                    const body = currentTableId ? `tableId=${currentTableId}` : `preOrderId=${currentPreOrderId}`;
                    const res = await fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body
                    });
                    if (!res.ok) throw new Error();
                    const data = await res.json();
                    if (!data.success) throw new Error();

                    const tbody = document.getElementById('detailBody');
                    tbody.innerHTML = `
                        <tr><td colspan="5" style="text-align:center;padding:40px;color:#27ae60;
                            font-size:1.1rem;font-weight:700;background:#f4fdf7;">
                            ✅ 訂單已整單取消成功
                        </td></tr>`;
                    document.getElementById('amtOriginal').textContent = '-';
                    document.getElementById('amtDiscount').textContent = '-';
                    document.getElementById('amtTotal').textContent    = '-';
                    document.getElementById('unservedWarning').style.display = 'none';
                    document.getElementById('checkoutBtn').classList.remove('show');
                        const cancelOrderBtn = document.getElementById('cancelOrderBtn');
                    if (cancelOrderBtn) cancelOrderBtn.style.display = 'none';
                    setTimeout(() => window.location.href = "/Payments/Create", 1500);
                } catch {
                    showAlert('執行失敗，請檢查網路連線。', '❌ 錯誤');
                }
            },
            '確定要整桌全部取消嗎？',
            '整桌取消',
            '返回'
        );
    }

    function closeDetail() {
        document.getElementById('checkoutContent').style.display = 'none';
        document.getElementById('emptyRight').style.display      = 'flex';
        document.getElementById('emptyRightIcon').textContent    = '👈';
        document.getElementById('emptyRightText').textContent    = '請選擇訂單';
        const cancelOrderBtn = document.getElementById('cancelOrderBtn');
        if (cancelOrderBtn) cancelOrderBtn.style.display = 'none';
        const memberBtn = document.getElementById('memberBtn');
        if (memberBtn) { memberBtn.style.display = 'none'; }
        document.querySelectorAll('.table-btn, .takeout-item').forEach(b =>
            b.classList.remove('active-selected'));
        currentPreOrderId = null;
        currentTableId    = null;
    }

    function selectPayMethod(method) {
        currentPayMethod = method;
        const sel = document.getElementById('payMethodSelect');
        if (sel) sel.value = method;

        const isCash       = method === 'Cash';
        const methodField  = document.getElementById('payMethodField');
        const cashGroup    = document.getElementById('cashInputGroup');
        const changeGroup  = document.getElementById('changeGroup');

        if (methodField) methodField.style.flex = '1';
        if (cashGroup)   cashGroup.style.display  = isCash ? '' : 'none';
        if (changeGroup) changeGroup.style.display = isCash ? '' : 'none';

        if (!isCash) {
            const ci = document.getElementById('cashInput');
            if (ci) ci.value = '';
            document.getElementById('changeDisplay').textContent = '-';
        }

        // 把選擇的付款方式帶入 form
        let input = document.getElementById('checkoutPayMethod');
        if (!input) {
            input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'payMethod';
            input.id   = 'checkoutPayMethod';
            document.getElementById('checkoutForm').appendChild(input);
        }
        input.value = method;
    }

