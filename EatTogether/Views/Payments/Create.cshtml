        document.getElementById('splitChangeAmt').textContent = '-';
        splitPayMethod = 'Cash';
        document.getElementById('splitPaySelect').value = 'Cash';
        onSplitPayChange('Cash');

        // 拆單期間隱藏活動／優惠券按鈕列
        const discountRow = document.getElementById('discountBtnRow');
        if (discountRow) discountRow.style.display = 'none';


        document.getElementById('splitModal').classList.add('show');
    }

    function onSplitCheck(cb) {
        // 高亮列
        const row = document.getElementById('srow-' + cb.dataset.detailId);
        if (row) row.classList.toggle('checked', cb.checked);

        // 更新小計
        let total = 0, count = 0;
        document.querySelectorAll('.split-check-input:checked').forEach(c => {
            total += parseInt(c.dataset.subtotal || 0);
            count++;
        });
        document.getElementById('splitCount').textContent    = count;
        document.getElementById('splitSubtotal').textContent = total.toLocaleString();
        document.getElementById('splitConfirmBtn').disabled  = count === 0;

        // 清找零
        document.getElementById('splitCashInput').value       = '';
        document.getElementById('splitChangeAmt').textContent = '-';
    }

    function onSplitPayChange(method) {
        splitPayMethod = method;
        const isCash = method === 'Cash';
        document.getElementById('splitPayMethodWrap').style.flex = isCash ? '1' : '1 1 100%';
        document.getElementById('splitCashWrap').style.display   = isCash ? '' : 'none';
        document.getElementById('splitChangeWrap').style.display = isCash ? '' : 'none';
        if (!isCash) {
            document.getElementById('splitCashInput').value       = '';
            document.getElementById('splitChangeAmt').textContent = '-';
        }
    }

    function onSplitCashInput() {
        const paid  = parseInt(document.getElementById('splitCashInput').value || 0);
        const total = parseInt(document.getElementById('splitSubtotal').textContent.replace(/,/g, '') || 0);
        const diff  = paid - total;
        document.getElementById('splitChangeAmt').textContent =
            paid >= total ? diff.toLocaleString() : '金額不足';
    }

    async function doSplitCheckout() {
        // 收集 detailIds（含套餐子項目）
        const checked   = [...document.querySelectorAll('.split-check-inline:checked')];
        const detailIds = checked.map(c => parseInt(c.dataset.detailId));
        checked.filter(c => c.dataset.isSetmeal === 'true').forEach(c => {
            const pid = parseInt(c.dataset.detailId);
            (currentData.items || [])
                .filter(i => i.parentDetailId === pid)
                .forEach(i => detailIds.push(i.detailId));
        });

        if (!detailIds.length) { showAlert('請先勾選要結帳的餐點'); return; }

        // 刷卡 / 行動支付 → 走綠界
        if (splitPayMethod === 'Card' || splitPayMethod === 'LinePay') {
            await initiateSplitEcPayCheckout(detailIds);
            return;
        }

        const btn = document.getElementById('splitConfirmBtnInline');
        btn.disabled    = true;
        btn.textContent = '處理中...';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const res   = await fetch('/Payments/SplitCheckout', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({
                    tableId:  currentTableId,
                    detailIds,
                    payMethod: splitPayMethod,
                    memberId:  splitMemberId  ?? null,
                    couponId:  splitCouponId  ?? null,
                    eventId:   splitEventId   ?? null
                })
            });
            const result = await res.json();

            if (result.success) {
                if (!result.isFullyPaid && result.remaining) {
                    // ── 部分結帳：留在拆單模式，重新渲染剩餘餐點 ──
                    currentData      = result.remaining;
                    splitOriginalAmt = 0;
                    // 重置拆單折扣狀態（新一輪可重選）
                    splitEventId = null; splitEventTitle = null; window._splitEventObj = null;
                    splitCouponId = null; splitCouponName = null; window._splitCouponObj = null;
                    document.getElementById('splitEventLabel').textContent   = '🎉 選擇活動';
                    document.getElementById('splitEventClear').style.display = 'none';
                    document.getElementById('splitCouponLabel').textContent  = '🎫 選擇優惠券';
                    document.getElementById('splitCouponClear').style.display = 'none';

                    // 更新左側桌位金額
                    const card = document.querySelector(`[data-table-id="${currentTableId}"]`);
                    if (card) {
                        const span = card.querySelector('.table-amount');
                        if (span) span.textContent = `$${result.remaining.totalAmount}`;
                    }

                    // 重新渲染餐點列（含勾選框）
                    document.getElementById('splitCountInline').textContent    = '0';
                    document.getElementById('splitSubtotalInline').textContent = '0';
                    document.getElementById('splitCashInline').value           = '';
                    document.getElementById('splitChangeInline').textContent   = '-';
                    document.getElementById('splitConfirmBtnInline').disabled  = true;
                    updateSplitAmounts();
                    renderItemsTable(result.remaining.items);

                } else {
                    // ── 全部結完：離開拆單模式，重新整理頁面 ──
                    exitSplitMode();
                    document.getElementById('detailBody').innerHTML = `
                        <tr><td colspan="4" style="text-align:center;padding:40px;
                             color:#27ae60;font-size:1.1rem;font-weight:700;">
                            ✅ 此桌已全部結帳完成
                        </td></tr>`;
                    ['amtOriginal','amtDiscount','amtTotal'].forEach(id =>
                        document.getElementById(id).textContent = '-');
                    document.getElementById('checkoutBtn').classList.remove('show');
                    document.getElementById('splitModeBtn').style.display = 'none';
                    document.getElementById('unservedWarning').style.display = 'none';
                    setTimeout(() => window.location.href = '/Payments/Create', 1500);
                }
            } else {
                showAlert('拆單失敗：' + (result.message || '未知錯誤'), '❌ 錯誤');
            }
        } catch {
            showAlert('網路錯誤，請重試', '❌ 錯誤');
        } finally {
            btn.disabled    = false;
            btn.textContent = '確認拆單結帳 ✓';
        }
    }

        // ── 結帳頁活動／優惠券選擇 ──────────────────────────────────────────────
    function getDiscountContext() {
        if (currentTableId) {
            // 內用：若下拉選了特定單，傳 preOrderId（僅套用到那筆）
            const orderSelect = document.getElementById('orderSelect');
            const selectedVal = orderSelect ? orderSelect.value : '0';
            const selectedPid = selectedVal && selectedVal !== '0' ? parseInt(selectedVal) : 0;
            if (selectedPid) return `preOrderId=${selectedPid}`;
            return `tableId=${currentTableId}`;
        }
        return `preOrderId=${currentPreOrderId}`;
    }


    // ── 訂單下拉選單切換 ───────────────────────────────────────────────────
    function onOrderSelectChange(preOrderIdStr) {
        if (!currentData) return;
        const pid = preOrderIdStr ? parseInt(preOrderIdStr) : null;

        // ── 同步更新 checkoutForm，讓現金／刷卡路徑也依選單正確結帳 ──
        const checkoutForm     = document.getElementById('checkoutForm');
        const checkoutIdInput  = document.getElementById('checkoutTableId');
        if (checkoutForm && checkoutIdInput) {
            if (pid && currentTableId) {
                // 選了特定子訂單 → POST /Payments/Checkout?preOrderId=...
                checkoutForm.action    = '/Payments/Checkout';
                checkoutIdInput.name   = 'preOrderId';
                checkoutIdInput.value  = pid;
            } else if (currentTableId) {
                // 回到「全部訂單」 → POST /Payments/CheckoutByTable?tableId=...
                checkoutForm.action    = '/Payments/CheckoutByTable';
                checkoutIdInput.name   = 'tableId';
                checkoutIdInput.value  = currentTableId;
            }
        }
        const items = pid
            ? currentData.items.filter(i => i.preOrderId === pid)
            : currentData.items;
        renderItemsTable(items);
        if (pid) {
            // 單筆篩選：用該筆的原始金額，折扣只顯示綁在該筆的部分
            const sub = (currentData.subOrders || []).find(s => s.preOrderId === pid);
            const orderOriginal = sub
                ? sub.amount
                : items.filter(i => !i.parentDetailId && i.status !== 2)
                       .reduce((s, i) => s + (i.subTotal || 0), 0);
            const orderDiscount = sub ? (sub.discountAmount || 0) : 0;
            renderAmounts(items, {
                originalAmount: orderOriginal,
                discountAmount: orderDiscount,
                totalAmount: Math.max(0, orderOriginal - orderDiscount)
            });
        } else {
            renderAmounts(items, currentData);
        }
        updateMemberBtnDisplay(currentData);

        // ── 結帳按鈕可見度：依所選訂單的出餐狀態決定 ──
        const checkoutBtn = document.getElementById('checkoutBtn');
        const warningArea = document.getElementById('unservedWarning');
        if (pid) {
            // 單筆：以那筆的頂層餐點是否有未出餐為準
            const hasUnserved = items.some(i => !i.parentDetailId && i.status === 0 && !i.isBilled);
            if (hasUnserved) {
                checkoutBtn.classList.remove('show');
            } else {
                checkoutBtn.classList.add('show');
                warningArea.style.display = 'none';
            }
        } else {
            // 全部訂單：還原整桌原始狀態
            if (currentData.hasUnserved) {
                checkoutBtn.classList.remove('show');
                warningArea.style.display = 'block';
            } else {
                checkoutBtn.classList.add('show');
                warningArea.style.display = 'none';
            }
        }

        // ── 優惠按鈕：依子單自己的會員決定顯示與否，內容用子單自己的優惠券/活動 ──
        // 規則（對應規格表）：
        //   有會員 → 顯示（未套用時顯示X個可用；已套用時顯示套用內容）
        //   沒會員 → 不顯示
        if (pid) {
            const om  = (currentData.orderMembers || []).find(m => m.preOrderId === pid);
            const sub = (currentData.subOrders    || []).find(s => s.preOrderId === pid);
            renderDiscountBtns(Object.assign({}, currentData, {
                memberId:   om  ? om.memberId         : null,
                couponId:   sub ? (sub.couponId   ?? null) : null,
                couponName: sub ? (sub.couponName ?? null) : null,
                eventId:    sub ? (sub.eventId    ?? null) : null,
                eventTitle: sub ? (sub.eventTitle ?? null) : null,
            }));
        } else {
            renderDiscountBtns(currentData);
        }
    }

    // ── 會員按鈕顯示邏輯（依目前 orderSelect 決定顯示哪位會員）─────────────
    function updateMemberBtnDisplay(data) {
        const memberBtn = document.getElementById('memberBtn');
        if (!memberBtn) return;
        const lbl = document.getElementById('memberBtnLabel');
        const orderSelect  = document.getElementById('orderSelect');
        const selectedVal  = orderSelect ? orderSelect.value : '0';
        const selectedPid  = selectedVal && selectedVal !== '0' ? parseInt(selectedVal) : 0;
        const isAllOrders  = selectedPid === 0;
        const orderMembers = data.orderMembers || [];

        let memberName = null;

        if (orderMembers.length > 0) {
            if (isAllOrders) {
                // 全部訂單：依各單會員決定
                const withMember = orderMembers.filter(m => m.memberId);
                const uniqueIds  = [...new Set(withMember.map(m => m.memberId))];
                if (uniqueIds.length === 1) {
                    memberName = withMember[0].memberName;
                } else if (uniqueIds.length > 1) {
                    // 多位不同會員
                    lbl.textContent = '請選擇會員';
                    memberBtn.style.background  = '#fff8e1';
                    memberBtn.style.borderColor = '#f39c12';
                    memberBtn.style.color       = '#e67e22';
                    return;
                }
            } else {
                // 單筆訂單：只看該筆
                const om = orderMembers.find(m => m.preOrderId === selectedPid);
                memberName = om?.memberName ?? null;
            }
        } else {
            // 外帶單筆（無 orderMembers）
            memberName = data.memberName;
        }

        if (memberName) {
            lbl.textContent = '會員：' + maskName(memberName);
            memberBtn.style.background  = '#f5eeff';
            memberBtn.style.borderColor = '#8e44ad';
            memberBtn.style.color       = '#8e44ad';
        } else {
            lbl.textContent = '輸入會員';
            memberBtn.style.background  = '#fff';
            memberBtn.style.borderColor = '#8e44ad';
            memberBtn.style.color       = '#8e44ad';
        }
    }

    // ── 金額區更新 ─────────────────────────────────────────────────────────
    // fullData = 有值時使用整桌金額；null 時依 items 自行計算（無折扣）
    function renderAmounts(items, fullData) {
        if (fullData) {
            // 全部訂單 → 用後端算好的數字（含折扣）
            document.getElementById('amtOriginal').textContent = fullData.originalAmount.toLocaleString();
            document.getElementById('amtDiscount').textContent = fullData.discountAmount.toLocaleString();
            document.getElementById('amtTotal').textContent    = fullData.totalAmount.toLocaleString();
        } else {
            // 單筆篩選 → 加總該筆餐點小計，折扣顯示 0
            const original = items
                .filter(i => !i.parentDetailId && i.status !== 2)
                .reduce((s, i) => s + (i.subTotal || 0), 0);
            document.getElementById('amtOriginal').textContent = original.toLocaleString();
            document.getElementById('amtDiscount').textContent = '0';
            document.getElementById('amtTotal').textContent    = original.toLocaleString();
        }
    }

    // ── 餐點明細表格渲染 ───────────────────────────────────────────────────
    function renderItemsTable(items) {
        const allItems = currentData ? currentData.items : items;
        const tbody = document.getElementById('detailBody');
        tbody.innerHTML = '';
        const thead = document.querySelector('.detail-table thead tr');

        // ── 拆單模式：逐項顯示含勾選框 ──────────────────────────────────
        if (splitMode) {
            if (thead) thead.innerHTML =
                '<th style="width:54px;text-align:center;white-space:nowrap;">勾選</th><th>餐點名稱</th><th>份數</th><th>金額</th>';
            const splittable = (allItems || []).filter(
                i => !i.parentDetailId && !i.isBilled && i.status !== 2
            );
            if (!splittable.length) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:20px;color:#aaa;">沒有可拆單的餐點</td></tr>';
                return;
            }
            splittable.forEach(item => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td style="text-align:center;">
                        <input type="checkbox" class="split-check-inline"
                               id="sci-${item.detailId}"
                               data-detail-id="${item.detailId}"
                               data-subtotal="${item.subTotal}"
                               data-is-setmeal="${!!item.isSetMeal}"
                               onchange="onSplitItemCheckInline(this)"
                               style="width:18px;height:18px;cursor:pointer;accent-color:#1a77c9;">
                    </td>
                    <td>${item.productName}${item.isSetMeal
                        ? '<span style="font-size:0.72rem;background:#e3f2fd;color:#1a77c9;padding:1px 6px;border-radius:8px;margin-left:4px;">套餐</span>'
                        : ''}</td>
                    <td>${item.qty}</td>
                    <td>NT$ ${item.subTotal.toLocaleString()}</td>`;
                tbody.appendChild(tr);
            });
            return;
        }

        // ── 正常模式：還原欄位標頭 ────────────────────────────────────
        if (thead) thead.innerHTML =
            '<th>餐點名稱</th><th>結帳份數</th><th>單價</th><th>金額</th>';

        const sortOrder = item => {
            if (item.status === 2) return 3;
            if (item.isBilled === true) return 2;
            if (item.status === 0) return 0;
            return 1;
        };

        const parentItems   = items.filter(i => !i.parentDetailId);
        const sortedParents = [...parentItems].sort((a, b) => sortOrder(a) - sortOrder(b));

        // 相同餐點合併顯示
        const groupMap = new Map();
        sortedParents.forEach(item => {
            if (item.isSetMeal) {
                groupMap.set('sm_' + item.detailId, { ...item });
                return;
            }
            const key = `${item.productName}|${item.unitPrice}|${item.status}|${item.isBilled}`;
            if (groupMap.has(key)) {
                const g = groupMap.get(key);
                g.qty      += 1;
                g.subTotal += item.subTotal;
            } else {
                groupMap.set(key, { ...item });
            }
        });
        const displayParents = [...groupMap.values()].sort((a, b) => sortOrder(a) - sortOrder(b));

        displayParents.forEach(item => {
            const isCancelled = item.status === 2;
            const isUnserved  = item.status === 0;
            const isBilled    = item.isBilled === true;
            const isSetMeal   = item.isSetMeal === true;

            const tr = document.createElement('tr');
            if (isCancelled) tr.classList.add('status-cancel');
            if (isBilled)    tr.classList.add('status-billed');
            if (isSetMeal)   tr.classList.add('is-setmeal-row');

            let badge = '';
            if (isSetMeal) {
                badge += `<span class="status-badge badge-setmeal">套餐</span>`;
                if (isUnserved) {
                    const childrenOfThis = allItems.filter(c => c.parentDetailId === item.detailId);
                    const anyChildServed = childrenOfThis.some(c => c.status === 1);
                    badge += anyChildServed
                        ? `<span class="status-badge badge-partial">部分出餐</span>`
                        : `<span class="status-badge badge-unserved">未出餐</span>`;
                }
            } else if (isUnserved) {
                badge += `<span class="status-badge badge-unserved">未出餐</span>`;
            }
            if (isCancelled)        badge += `<span class="status-badge badge-cancel">已取消</span>`;
            if (item.isInvalidGift) badge += `<span class="status-badge" style="background:#e74c3c;color:#fff;">⚠️ 需補差價</span>`;

            tr.innerHTML = `
                <td>${item.productName}${badge}</td>
                <td>${item.qty}</td>
                <td>NT$ ${item.unitPrice.toLocaleString()}</td>
                <td>NT$ ${item.subTotal.toLocaleString()}</td>
            `;
            tbody.appendChild(tr);

            // 套餐子項目
            if (isSetMeal) {
                const children = allItems.filter(c => c.parentDetailId === item.detailId);
                children.forEach(child => {
                    const childCancelled = child.status === 2;
                    const childServed    = child.status === 1;
                    const childTr = document.createElement('tr');
                    childTr.classList.add('child-item-row');
                    if (childCancelled) childTr.classList.add('status-cancel');
                    if (childServed)    childTr.classList.add('child-served');
                    childTr.dataset.parentId = item.detailId;
                    childTr.dataset.detailId = child.detailId;

                    const childBadge = childCancelled
                        ? `<span class="status-badge badge-cancel">已取消</span>`
                        : childServed
                            ? `<span class="status-badge badge-billed">已出餐</span>`
                            : `<span class="status-badge badge-unserved">待出餐</span>`;

                    childTr.innerHTML = `
                        <td style="padding-left:28px;">
                            <span style="color:#e67e22;margin-right:4px;">└</span>${child.productName}${childBadge}
                        </td>
                        <td>${child.qty}</td>
                        <td style="color:#ccc;">—</td>
                        <td style="color:#ccc;">—</td>
                    `;
                    tbody.appendChild(childTr);
                });
            }
        });
    }

    // ── 優惠按鈕列渲染 ─────────────────────────────────────────────────────
    function renderDiscountBtns(data) {
        const row = document.getElementById('discountBtnRow');
        if (!row) return;

        // 沒有綁定會員時隱藏活動／優惠券選擇列
        if (!data.memberId) {
            row.style.display = 'none';
            return;
        }

        row.style.display = 'flex';

        const hasEvent  = !!data.eventTitle;
        const hasCoupon = !!data.couponName;

        // ── 活動按鈕 ──
        const eventBtn   = document.getElementById('selectEventBtn');
        const eventLabel = document.getElementById('eventBtnLabel');
        const eventBadge = document.getElementById('eventAvailBadge');
        const eventClear = document.getElementById('eventClearBtn');

        eventBtn.style.display = '';

        if (hasEvent) {
            eventLabel.textContent = '🎉 ' + data.eventTitle;
            eventBtn.style.borderColor = '#27ae60';
            eventBtn.style.background  = '#f0fff4';
            eventBtn.style.color       = '#27ae60';
            eventBadge.style.display   = 'none';
            eventClear.style.display   = '';
        } else {
            eventLabel.textContent = '🎉 選擇活動';
            eventBtn.style.borderColor = '#27ae60';
            eventBtn.style.background  = '#fff';
            eventBtn.style.color       = '#27ae60';
            eventClear.style.display   = 'none';
            // 徽章：稍後 fetch 後決定；先暫時隱藏，等 modal 快取資料
            eventBadge.style.display   = 'none';
        }

        // ── 優惠券按鈕 ──
        const couponBtn   = document.getElementById('selectCouponBtn');
        const couponLabel = document.getElementById('couponBtnLabel');
        const couponBadge = document.getElementById('couponAvailBadge');
        const couponClear = document.getElementById('couponClearBtn');

        if (hasCoupon) {
            couponLabel.textContent = '🎫 ' + data.couponName;
            couponBtn.style.borderColor = '#b7770d';
            couponBtn.style.background  = '#fff8e1';
            couponBtn.style.color       = '#b7770d';
            couponBadge.style.display   = 'none';
            couponClear.style.display   = '';
        } else {
            couponLabel.textContent = '🎫 選擇優惠券';
            couponBtn.style.borderColor = '#b7770d';
            couponBtn.style.background  = '#fff';
            couponBtn.style.color       = '#b7770d';
            couponClear.style.display   = 'none';
            couponBadge.style.display   = 'none';
        }

        // 背景 fetch 可用數，更新徽章
        if (!hasEvent) fetchEventAvailBadge();
        if (!hasCoupon) fetchCouponAvailBadge();
    }

    async function fetchEventAvailBadge() {
        try {
            const res    = await fetch(`/Payments/GetManualEvents?${getDiscountContext()}`);
            const events = await res.json();
            const avail  = (events || []).filter(e => e.isEligible).length;
            const badge  = document.getElementById('eventAvailBadge');
            if (badge && avail > 0) {
                badge.textContent    = `${avail} 可用`;
                badge.style.display  = '';
            }
        } catch { /* 靜默失敗 */ }
    }

    async function fetchCouponAvailBadge() {
        try {
            const res     = await fetch(`/Payments/GetApplicableCoupons?${getDiscountContext()}`);
            const coupons = await res.json();
            const avail   = (coupons || []).filter(c => c.isEligible).length;
            const badge   = document.getElementById('couponAvailBadge');
            if (badge && avail > 0) {
                badge.textContent    = `${avail} 可用`;
                badge.style.display  = '';
            }
        } catch { /* 靜默失敗 */ }
    }

    // ── 活動 Modal ─────────────────────────────────────────────────────────
    async function openEventModal() {
        const listArea = document.getElementById('eventListArea');
        listArea.innerHTML = '<div style="text-align:center;color:#aaa;padding:24px;">載入中...</div>';
        document.getElementById('eventSelectModal').classList.add('show');

        try {
            const res    = await fetch(`/Payments/GetManualEvents?${getDiscountContext()}`);
            const events = await res.json();

            if (!events || events.length === 0) {
                listArea.innerHTML = '<div style="text-align:center;color:#aaa;padding:24px;">目前沒有進行中的活動</div>';
                return;
            }

            // 若已套用優惠券，提示活動門檻以折扣後金額判斷
            let hintHtml = '';
            if (currentData && currentData.couponName) {
                const effectiveAmt = (currentData.totalAmount || 0).toLocaleString();
                hintHtml = `<div style="margin-bottom:10px;padding:8px 12px;background:#fff8e1;border-left:3px solid #f39c12;
                                        border-radius:0 8px 8px 0;font-size:0.8rem;color:#7d6608;">
                                💡 已套用優惠券，活動門檻以折扣後金額 <strong>NT$ ${effectiveAmt}</strong> 判斷
                            </div>`;
            }

            listArea.innerHTML = hintHtml + events.map(ev => {
                const eligible = ev.isEligible;
                const inUse    = ev.isInUse;

                // 不符合資格 → 暗色、禁止點擊
                const borderColor = inUse ? '#27ae60' : (eligible ? '#e8e8e8' : '#e8e8e8');
                const bgColor     = inUse ? '#f0fff4'  : '#fff';
                const opacity     = eligible ? '1' : '0.45';
                const cursor      = eligible ? 'pointer' : 'not-allowed';
                const clickAttr   = eligible
                    ? `onclick="doApplyEvent(${ev.id})"
                       onmouseover="this.style.borderColor='#27ae60';this.style.background='#f0fff4'"
                       onmouseout="this.style.borderColor='${inUse ? '#27ae60' : '#e8e8e8'}';this.style.background='${inUse ? '#f0fff4' : '#fff'}'"`
                    : '';

                return `
                <div ${clickAttr}
                     style="padding:12px 14px; border:2px solid ${borderColor}; border-radius:10px;
                            margin-bottom:8px; cursor:${cursor}; transition:all 0.15s;
                            background:${bgColor}; opacity:${opacity}; user-select:none;">
                    <div style="display:flex; align-items:center; gap:6px; margin-bottom:3px;">
                        <span style="font-weight:700; font-size:0.92rem; color:#1a1a1a;">${ev.title}</span>
                        ${inUse  ? '<span style="font-size:0.7rem;background:#27ae60;color:#fff;padding:1px 8px;border-radius:20px;font-weight:700;">使用中</span>' : ''}
                        ${!eligible ? '<span style="font-size:0.7rem;background:#e0e0e0;color:#999;padding:1px 8px;border-radius:20px;font-weight:600;">不符合</span>' : ''}
                    </div>
                    <div style="font-size:0.83rem; color:#27ae60; font-weight:600;">${ev.discountDescription}</div>
                    ${ev.summary ? `<div style="font-size:0.78rem;color:#888;margin-top:3px;">${ev.summary}</div>` : ''}
                    <div style="font-size:0.74rem; color:#bbb; margin-top:3px;">最低消費 NT$ ${ev.minSpend.toLocaleString()}</div>
                </div>`;
            }).join('');
        } catch {
            listArea.innerHTML = '<div style="text-align:center;color:#c0392b;padding:24px;">載入失敗，請重試</div>';
        }
    }

    async function doApplyEvent(eventId) {
        document.getElementById('eventSelectModal').classList.remove('show');

        // 拆單模式：僅記錄到拆單狀態，不送後端
        if (_splitDiscountModal) {
            _splitDiscountModal = false;
            if (eventId) {
                // 從快取的清單物件找到折扣資訊（renderSplitEventModal 已渲染，不易取得）
                // 改用 fetch 再次取得
                try {
                    const res = await fetch(`/Payments/GetSplitEvents?amount=${splitOriginalAmt}`);
                    const evs = await res.json();
                    const ev  = (evs || []).find(e => e.id === eventId);
                    if (ev) {
                        splitEventId     = ev.id;
                        splitEventTitle  = ev.title;
                        window._splitEventObj = ev;
                        document.getElementById('splitEventLabel').textContent   = '🎉 ' + ev.title;
                        document.getElementById('splitEventClear').style.display = '';
                        updateSplitAmounts();
                    }
                } catch { /* 靜默 */ }
            } else {
                clearSplitEvent();
            }
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const body  = `${getDiscountContext()}&eventId=${eventId ?? ''}`;
        try {
            const res    = await fetch('/Payments/ApplyEvent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body
            });
            const result = await res.json();
            if (result.success) {
                currentData = result.data;
                renderDetail(result.data);
            } else {
                showAlert(result.error || '套用失敗', '❌ 錯誤');
            }
        } catch {
            showAlert('套用失敗，請重試', '❌ 錯誤');
        }
    }

    // ── 優惠券 Modal ───────────────────────────────────────────────────────
    async function openCouponModal() {
        const listArea = document.getElementById('couponListArea');
        listArea.innerHTML = '<div style="text-align:center;color:#aaa;padding:24px;">載入中...</div>';
        document.getElementById('couponSelectModal').classList.add('show');

        try {
            const res     = await fetch(`/Payments/GetApplicableCoupons?${getDiscountContext()}`);
            const coupons = await res.json();

            // 只顯示「會員已領取」或「目前使用中」的優惠券；未領取的不列出
            const visibleCoupons = (coupons || []).filter(c => c.isClaimed !== false || c.isInUse === true);

            if (!visibleCoupons.length) {
                listArea.innerHTML = '<div style="text-align:center;color:#aaa;padding:24px;">目前沒有可用的優惠券</div>';
                return;
            }

            // 若已套用活動，提示優惠券門檻以折扣後金額判斷
            let hintHtml = '';
            if (currentData && currentData.eventTitle) {
                const effectiveAmt = (currentData.totalAmount || 0).toLocaleString();
                hintHtml = `<div style="margin-bottom:10px;padding:8px 12px;background:#f0fff4;border-left:3px solid #27ae60;
                                        border-radius:0 8px 8px 0;font-size:0.8rem;color:#1a5c2e;">
                                💡 已套用活動，優惠券門檻以折扣後金額 <strong>NT$ ${effectiveAmt}</strong> 判斷
                            </div>`;
            }

            listArea.innerHTML = hintHtml + visibleCoupons.map(c => {
                const claimed       = c.isClaimed !== false;   // 未傳時預設已領取
                const usedByMember  = c.isUsedByMember === true;
                const eligible      = c.isEligible;
                const inUse         = c.isInUse;

                const canClick    = claimed && !usedByMember && eligible;
                const borderColor = inUse ? '#b7770d' : '#e8e8e8';
                const bgColor     = inUse ? '#fff8e1' : '#fff';
                const opacity     = canClick ? '1' : '0.45';
                const cursor      = canClick ? 'pointer' : 'not-allowed';
                const clickAttr   = canClick
                    ? `onclick="doApplyCouponById(${c.id})"
                       onmouseover="this.style.borderColor='#b7770d';this.style.background='#fff8e1'"
                       onmouseout="this.style.borderColor='${inUse ? '#b7770d' : '#e8e8e8'}';this.style.background='${inUse ? '#fff8e1' : '#fff'}'"`
                    : '';

                return `
                <div ${clickAttr}
                     style="padding:12px 14px; border:2px solid ${borderColor}; border-radius:10px;
                            margin-bottom:8px; cursor:${cursor}; transition:all 0.15s;
                            background:${bgColor}; opacity:${opacity}; user-select:none;">
                    <div style="display:flex; align-items:center; gap:6px; margin-bottom:3px;">
                        <span style="font-weight:700; font-size:0.92rem; color:#1a1a1a;">${c.name}</span>
                        <span style="font-size:0.78rem; color:#888; font-weight:500;">${c.code}</span>
                        ${inUse        ? '<span style="font-size:0.7rem;background:#b7770d;color:#fff;padding:1px 8px;border-radius:20px;font-weight:700;">使用中</span>' : ''}
                        ${!claimed     ? '<span style="font-size:0.7rem;background:#6c757d;color:#fff;padding:1px 8px;border-radius:20px;font-weight:600;">未領取</span>' : ''}
                        ${claimed && usedByMember ? '<span style="font-size:0.7rem;background:#495057;color:#fff;padding:1px 8px;border-radius:20px;font-weight:600;">已使用</span>' : ''}
                        ${claimed && !usedByMember && !eligible ? '<span style="font-size:0.7rem;background:#e0e0e0;color:#999;padding:1px 8px;border-radius:20px;font-weight:600;">不符合</span>' : ''}
                    </div>
                    <div style="font-size:0.83rem; color:#b7770d; font-weight:600;">${c.discountDescription}</div>
                    ${c.minSpend > 0 ? `<div style="font-size:0.74rem;color:#bbb;margin-top:3px;">最低消費 NT$ ${c.minSpend.toLocaleString()}</div>` : ''}
                </div>`;
            }).join('');
        } catch {
            listArea.innerHTML = '<div style="text-align:center;color:#c0392b;padding:24px;">載入失敗，請重試</div>';
        }
    }

    async function doApplyCouponById(couponId) {
        document.getElementById('couponSelectModal').classList.remove('show');

        // 拆單模式：僅記錄到拆單狀態，不送後端
        if (_splitDiscountModal) {
            _splitDiscountModal = false;
            if (couponId) {
                try {
                    const res = await fetch(`/Payments/GetSplitCoupons?amount=${splitOriginalAmt}`);
                    const cs  = await res.json();
                    const c   = (cs || []).find(x => x.id === couponId);
                    if (c) {
                        splitCouponId   = c.id;
                        splitCouponName = c.name;
                        window._splitCouponObj = c;
                        document.getElementById('splitCouponLabel').textContent   = '🎫 ' + c.name;
                        document.getElementById('splitCouponClear').style.display = '';
                        updateSplitAmounts();
                    }
                } catch { /* 靜默 */ }
            } else {
                clearSplitCoupon();
            }
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const body = `${getDiscountContext()}&couponId=${couponId ?? ''}`;
        try {
            const res = await fetch('/Payments/ApplyCouponById', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body
            });
            const result = await res.json();
            if (result.success) {
                currentData = result.data;
                renderDetail(result.data);
            } else {
                showAlert(result.error || '套用失敗', '❌ 錯誤');
            }
        } catch {
            showAlert('套用失敗，請重試', '❌ 錯誤');
        }
    }


    // ── 會員姓名遮罩：第一字 + * + 最後一字，不足兩字時全部遮 ──────────────
    function maskName(name) {
        if (!name) return '';
        if (name.length === 1) return name;
        if (name.length === 2) return name[0] + '*';
        return name[0] + '*'.repeat(name.length - 2) + name[name.length - 1];
    }

    // ── 會員搜尋 Modal ────────────────────────────────────────────────────
    let _pendingMemberId   = null;
    let _pendingMemberName = null;

    function openMemberModal() {
        // 重置
        document.getElementById('memberPhoneInput').value = '';
        document.getElementById('memberSearchResult').innerHTML = '';
        document.getElementById('confirmMemberBtn').style.display = 'none';
        _pendingMemberId = null;

        const clearBtn     = document.getElementById('clearMemberBtn');
        const curInfo      = document.getElementById('memberCurrentInfo');
        const orderSelect  = document.getElementById('orderSelect');
        const selectedVal  = orderSelect ? orderSelect.value : '0';
        const selectedPid  = selectedVal && selectedVal !== '0' ? parseInt(selectedVal) : 0;
        const isAllOrders  = selectedPid === 0;
        const orderMembers = (currentData && currentData.orderMembers) || [];

        if (isAllOrders && orderMembers.length > 0) {
            // 全部訂單模式：顯示每筆訂單的會員
            const withMember = orderMembers.filter(m => m.memberId);
            const uniqueIds  = [...new Set(withMember.map(m => m.memberId))];

            if (uniqueIds.length > 1) {
                // 多位不同會員 → 列出每筆訂單的會員
                document.getElementById('memberCurrentName').innerHTML = orderMembers.map(o =>
                    o.memberId
                    ? `<div onclick="closeMemberModal();doApplyMember(${o.memberId})"
                            style="font-size:0.85rem;margin-bottom:6px;padding:7px 12px;
                                   border:1.5px solid #c39be0;border-radius:8px;background:#faf5ff;
                                   cursor:pointer;transition:background 0.15s;"
                            onmouseover="this.style.background='#f0e5ff'"
                            onmouseout="this.style.background='#faf5ff'">
                           <span style="color:#888;font-size:0.78rem;">${o.orderNumber}　</span>
                           <strong style="color:#5b2d8e;">${o.memberName}</strong>
                           <span style="color:#aaa;font-size:0.8rem;">　${o.memberPhone ?? ''}</span>
                       </div>`
                    : `<div style="font-size:0.85rem;margin-bottom:6px;padding:7px 12px;
                                   border:1.5px solid #e0e0e0;border-radius:8px;color:#aaa;">
                           <span style="font-size:0.78rem;">${o.orderNumber}　</span>未綁定
                       </div>`
                ).join('');
                curInfo.style.display  = '';
                clearBtn.style.display = '';
            } else if (uniqueIds.length === 1) {
                const m = withMember[0];
                document.getElementById('memberCurrentName').textContent =
                    `${m.memberName}　${m.memberPhone ?? ''}`;
                curInfo.style.display  = '';
                clearBtn.style.display = '';
            } else {
                curInfo.style.display  = 'none';
                clearBtn.style.display = 'none';
            }
        } else {
            // 單筆訂單模式：從 orderMembers 找該筆，或 fallback 到 memberName
            let memberName  = null;
            let memberPhone = null;
            if (orderMembers.length > 0 && selectedPid) {
                const om = orderMembers.find(m => m.preOrderId === selectedPid);
                memberName  = om?.memberName ?? null;
                memberPhone = om?.memberPhone ?? null;
            } else if (currentData) {
                memberName  = currentData.memberName;
                memberPhone = currentData.memberPhone;
            }
            if (memberName) {
                document.getElementById('memberCurrentName').textContent =
                    `${memberName}　${memberPhone ?? ''}`;
                curInfo.style.display  = '';
                clearBtn.style.display = '';
            } else {
                curInfo.style.display  = 'none';
                clearBtn.style.display = 'none';
            }
        }

        document.getElementById('memberModal').classList.add('show');
        setTimeout(() => document.getElementById('memberPhoneInput').focus(), 100);
    }

    function closeMemberModal() {
        document.getElementById('memberModal').classList.remove('show');
    }

    async function searchMember() {
        const phone  = document.getElementById('memberPhoneInput').value.trim();
        const result = document.getElementById('memberSearchResult');

        if (!phone) {
            result.innerHTML = `<div style="color:#c0392b;font-size:0.85rem;">請先輸入電話號碼</div>`;
            return;
        }

        result.innerHTML = `<div style="color:#aaa;font-size:0.85rem;">查詢中…</div>`;
        document.getElementById('confirmMemberBtn').style.display = 'none';
        _pendingMemberId = null;

        try {
            const res  = await fetch(`/Payments/SearchMember?phone=${encodeURIComponent(phone)}`);
            const data = await res.json();

            if (!data.success) {
                result.innerHTML = `<div style="color:#c0392b;font-size:0.85rem;padding:10px 0;">❌ ${data.error}</div>`;
                return;
            }

            const m = data.member;
            const canBind = m.isConfirmed && !m.isBlacklisted;

            // 只有可綁定時才記錄 pending
            _pendingMemberId   = canBind ? m.id   : null;
            _pendingMemberName = canBind ? m.name : null;

            const warningHtml = m.isBlacklisted
                ? `<div style="margin-top:6px;font-size:0.78rem;color:#c0392b;font-weight:600;">⛔ 此會員已被列為黑名單，無法綁定</div>`
                : (!m.isConfirmed
                    ? `<div style="margin-top:6px;font-size:0.78rem;color:#e67e22;font-weight:600;">⚠️ 此會員尚未驗證信箱，無法綁定</div>`
                    : '');

            const borderColor = canBind ? '#c39be0' : (m.isBlacklisted ? '#e0a0a0' : '#f0c88a');
            const bgColor     = canBind ? '#faf5ff' : (m.isBlacklisted ? '#fff5f5' : '#fffbf0');

            result.innerHTML = `
                <div style="padding:12px 14px;border:1.5px solid ${borderColor};border-radius:10px;background:${bgColor};">
                    <div style="display:flex;align-items:center;gap:8px;">
                        <span style="font-size:1.3rem;">👤</span>
                        <div>
                            <div style="font-weight:700;font-size:0.95rem;color:#3d1a5f;">${m.name}</div>
                            <div style="font-size:0.82rem;color:#888;">${m.phone ?? ''}</div>
                        </div>
                    </div>
                    ${warningHtml}
                </div>`;

            document.getElementById('confirmMemberBtn').style.display = canBind ? '' : 'none';

        } catch {
            result.innerHTML = `<div style="color:#c0392b;font-size:0.85rem;">查詢失敗，請重試</div>`;
        }
    }

    async function confirmMember() {
        if (_pendingMemberId == null) return;
        if (_splitMemberModal) {
            _splitMemberModal = false;
            closeMemberModal();
            setSplitMember(_pendingMemberId, _pendingMemberName, null);
        } else {
            await doApplyMember(_pendingMemberId);
        }
    }

    async function doApplyMember(memberId) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const body  = `${getDiscountContext()}&memberId=${memberId ?? ''}`;
        try {
            const res    = await fetch('/Payments/ApplyMember', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body
            });
            const result = await res.json();
            closeMemberModal();
            if (result.success) {
                if (currentTableId) {
                    // 內用：重新拉整桌資料，確保 orderMembers 完整
                    const orderSelect   = document.getElementById('orderSelect');
                    const prevSelected  = orderSelect ? orderSelect.value : '0';
                    const tableRes  = await fetch(`/Payments/GetDetailByTable?tableId=${currentTableId}`);
                    const tableData = await tableRes.json();
                    currentData = tableData;
                    renderDetail(tableData);
                    // 恢復之前選取的訂單
                    if (orderSelect && prevSelected && prevSelected !== '0') {
                        orderSelect.value = prevSelected;
                        onOrderSelectChange(prevSelected);
                    }
                } else {
                    currentData = result.data;
                    renderDetail(result.data);
                }
            } else {
                showAlert(result.error || '套用失敗', '❌ 錯誤');
            }
        } catch {
            showAlert('操作失敗，請重試', '❌ 錯誤');
        }
    }

    function showDiscountToast(text) {
        const toast = document.getElementById('discountToast');
        document.getElementById('discountToastText').textContent = text;
        toast.style.display = 'block';
        // 強制 reflow 讓 transition 生效
        toast.getBoundingClientRect();
        toast.style.opacity = '1';
        clearTimeout(toast._fadeTimer);
        toast._fadeTimer = setTimeout(() => {
            toast.style.opacity = '0';
            setTimeout(() => { toast.style.display = 'none'; }, 450);
        }, 2000);
    }

</script>
