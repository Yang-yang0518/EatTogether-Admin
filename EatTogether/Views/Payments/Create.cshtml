    async function initiateEcPayCheckout() {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        // 若下拉有選特定子訂單，用 preOrderId；否則整桌用 tableId
        const orderSelect = document.getElementById('orderSelect');
        const selectedVal = orderSelect ? orderSelect.value : '0';
        const selectedPid = currentTableId && selectedVal && selectedVal !== '0' ? parseInt(selectedVal) : 0;
        const base = selectedPid
            ? `preOrderId=${selectedPid}`
            : (currentTableId ? `tableId=${currentTableId}` : `preOrderId=${currentPreOrderId}`);
        const body  = `${base}&payMethod=${encodeURIComponent(currentPayMethod)}`;

        const btn = document.getElementById('checkoutBtn');
        btn.disabled = true;
        btn.textContent = '處理中…';

        try {
            const res    = await fetch('/Payments/InitiateCardPayment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded',
                           'RequestVerificationToken': token },
                body
            });
            const result = await res.json();

            if (!result.success) {
                showAlert(result.error || '付款初始化失敗', '❌ 錯誤');
                return;
            }

            // 建立隱藏表單並自動送出到綠界
            const form = document.createElement('form');
            form.method = 'post';
            form.action = result.paymentUrl;
            form.style.display = 'none';

            for (const [key, val] of Object.entries(result.formParams)) {
                const input = document.createElement('input');
                input.type  = 'hidden';
                input.name  = key;
                input.value = val;
                form.appendChild(input);
            }

            document.body.appendChild(form);
            form.submit();
        } catch {
            showAlert('刷卡連線失敗，請重試', '❌ 錯誤');
        } finally {
            btn.disabled = false;
            btn.textContent = '結帳 ✓';
        }
    }

    async function initiateSplitEcPayCheckout(detailIds) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const btn   = document.getElementById('splitConfirmBtnInline');
        btn.disabled    = true;
        btn.textContent = '處理中…';

        try {
            const res    = await fetch('/Payments/InitiateSplitCardPayment', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json',
                           'RequestVerificationToken': token },
                body: JSON.stringify({
                    tableId:  currentTableId,
                    detailIds,
                    payMethod: splitPayMethod,   // Card 或 LinePay
                    memberId:  splitMemberId  ?? null,
                    couponId:  splitCouponId  ?? null,
                    eventId:   splitEventId   ?? null
                })
            });
            const result = await res.json();

            if (!result.success) {
                showAlert(result.error || '付款初始化失敗', '❌ 錯誤');
                return;
            }

            const form = document.createElement('form');
            form.method = 'post';
            form.action = result.paymentUrl;
            form.style.display = 'none';
            for (const [key, val] of Object.entries(result.formParams)) {
                const input = document.createElement('input');
                input.type  = 'hidden';
                input.name  = key;
                input.value = val;
                form.appendChild(input);
            }
            document.body.appendChild(form);
            form.submit();
        } catch {
            showAlert('刷卡連線失敗，請重試', '❌ 錯誤');
