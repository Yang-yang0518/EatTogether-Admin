    // ── 拆單項目勾選 ─────────────────────────────────────────────────────
    function onSplitItemCheckInline(cb) {
        const row = cb.closest('tr');
        if (row) row.classList.toggle('checked', cb.checked);
        let total = 0, count = 0;
        document.querySelectorAll('.split-check-inline:checked').forEach(c => {
            total += parseInt(c.dataset.subtotal || 0);
            count++;
        });
        document.getElementById('splitCountInline').textContent    = count;
        document.getElementById('splitSubtotalInline').textContent = total.toLocaleString();
        document.getElementById('splitCashInline').value           = '';
        document.getElementById('splitChangeInline').textContent   = '-';
        splitOriginalAmt = total;
        updateSplitAmounts();
        document.getElementById('splitConfirmBtnInline').disabled  = count === 0;
    }

    function updateSplitAmounts() {
        // 計算折扣（前端簡易估算，後端結帳時會再算一次）
        const orig = splitOriginalAmt;
        let disc = 0;
        // coupon
        if (splitCouponId && window._splitCouponObj) {
            const c = window._splitCouponObj;
            if (c.discountType === 0) disc += c.discountValue;
            else disc += Math.floor(orig * c.discountValue / 100);
        }
        // event
        if (splitEventId && window._splitEventObj) {
            const e = window._splitEventObj;
            if (e.discountType === 'FixedAmount') disc += Math.floor(e.discountValue);
            else if (e.discountType === 'Percentage') disc += Math.floor(orig * e.discountValue / 100);
        }
        disc = Math.min(disc, orig);
        const total = Math.max(1, orig - disc);
        document.getElementById('splitAmtOriginal').textContent = orig.toLocaleString();
        document.getElementById('splitAmtDiscount').textContent = disc.toLocaleString();
        document.getElementById('splitAmtTotal').textContent    = total.toLocaleString();
        document.getElementById('splitCashInline').value        = '';
        document.getElementById('splitChangeInline').textContent = '-';
    }

