@model EatTogether.Models.ViewModels.SetMealViewModel
@{
    ViewData["Title"] = "新增套餐";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">新增套餐</h1>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <span class="fw-bold"><i class="fas fa-plus me-1 text-primary"></i>新增套餐基本資料</span>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary border-0">
                <i class="fas fa-arrow-left me-1"></i>返回列表
            </a>
        </div>
        <div class="card-body p-4">
            <form method="post" enctype="multipart/form-data" asp-action="Create" id="createForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="croppedImageData" name="CroppedImageData" />
                <input type="hidden" asp-for="DisplayOrder" />
                <input type="hidden" id="itemsJson" name="itemsJson" />

                <div class="row">
                    <!-- 左側資料區 -->
                    <div class="col-lg-8">
                        <div class="row g-4">
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-secondary">套餐名稱 <span class="text-danger">*</span></label>
                                <input asp-for="SetMealName" class="form-control form-control-lg border-light-subtle shadow-sm" placeholder="請輸入套餐名稱" />
                                <span asp-validation-for="SetMealName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-secondary">套餐定價 <span class="text-danger">*</span></label>
                                <div class="input-group input-group-lg shadow-sm">
                                    <span class="input-group-text bg-light border-light-subtle">$</span>
                                    <input asp-for="SetPrice" class="form-control border-light-subtle" placeholder="請輸入價格" />
                                </div>
                                <span asp-validation-for="SetPrice" class="text-danger small"></span>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold text-secondary">折扣類型 <span class="text-danger">*</span></label>
                                <select asp-for="DiscountType" asp-items="Model.DiscountTypeOptions"
                                        class="form-select form-select-lg border-light-subtle shadow-sm" onchange="updateDiscountLabel()"></select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold text-secondary" id="discountLabel">
                                    折扣值（%） <span class="text-danger">*</span>
                                </label>
                                <input asp-for="DiscountValue" class="form-control form-control-lg border-light-subtle shadow-sm" placeholder="0" min="0" step="0.01" />
                                <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-bold text-secondary"></label>
                                <input asp-for="StartDate" type="date" class="form-control form-control-lg border-light-subtle shadow-sm" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-bold text-secondary"></label>
                                <input asp-for="EndDate" type="date" class="form-control form-control-lg border-light-subtle shadow-sm" />
                                <span asp-validation-for="EndDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label fw-bold text-secondary">套餐描述</label>
                                <textarea asp-for="Description" class="form-control border-light-subtle shadow-sm" rows="4"
                                          placeholder="請輸入套餐描述（選填）"></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 d-flex gap-4">
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="IsActive" class="form-check-label fw-bold text-muted"></label>
                                </div>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsPopular" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="IsPopular" class="form-check-label fw-bold text-muted"></label>
                                </div>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsRecommended" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="IsRecommended" class="form-check-label fw-bold text-muted"></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 右側圖片區 -->
                    <div class="col-lg-4 border-start border-light-subtle">
                        <div class="ps-lg-4 text-center">
                            <label class="form-label fw-bold text-secondary d-block text-start mb-3">套餐圖片</label>

                            <div id="imageArea" class="position-relative border rounded-4 bg-light overflow-hidden shadow-sm d-flex align-items-center justify-content-center"
                                 style="aspect-ratio: 4/3; cursor: pointer;" onclick="document.getElementById('imageInput').click()">

                                <div id="placeholderContent" class="text-center">
                                    <i class="fas fa-cloud-upload-alt fa-3x text-primary mb-3"></i>
                                    <p class="text-secondary mb-1">點擊或拖曳圖片</p>
                                    <small class="text-muted">建議比例 4:3</small>
                                </div>

                                <img id="previewImg" src="" class="img-fluid" style="display:none; width:100%; height:100%; object-fit: cover;" />

                                <div id="editBadge" class="position-absolute bottom-0 end-0 p-3" style="display:none">
                                    <span class="badge bg-dark bg-opacity-75 p-2 rounded-circle shadow-sm">
                                        <i class="fas fa-pencil-alt"></i>
                                    </span>
                                </div>
                            </div>

                            <input type="file" id="imageInput" class="form-control d-none" accept="image/*"
                                   onchange="handleFileSelect(this)" />

                            <div class="mt-4 p-3 bg-light rounded-3 border-0 small text-start">
                                <h6 class="fw-bold text-primary mb-2 small"><i class="fas fa-info-circle me-1"></i>上傳說明</h6>
                                <ul class="text-muted mb-0 ps-3 lh-base">
                                    <li>支援 JPG, PNG 格式</li>
                                    <li>選擇後會自動開啟裁切功能</li>
                                    <li>裁切完畢後將顯示於上方區域</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                    <button type="button" class="btn btn-link text-secondary text-decoration-none px-4" onclick="location.href='@Url.Action("Index")'">取消</button>
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill">
                        儲存套餐資料
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 套餐餐點明細（選填） -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
            <span class="fw-bold"><i class="fas fa-list me-1 text-primary"></i>套餐包含餐點</span>
            <small class="text-muted ms-2">（選填，建立後也可在編輯頁面設定）</small>
        </div>
        <div class="card-body p-4">
            <div id="itemAlertBox"></div>
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div id="category-slots-container">
                        @foreach (var categoryVm in Model.CategoriesWithDishes)
                        {
                            <div class="card mb-3 shadow-sm category-slot" data-category-id="@categoryVm.CategoryId">
                                <div class="card-header d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #f0f7ff 0%, #ffffff 100%); border-bottom: 1px solid #e0e0e0;">
                                    <h5 class="mb-0 fw-bold text-dark">@categoryVm.CategoryName</h5>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input is-optional-toggle" type="checkbox" role="switch"
                                               id="isOptional-@categoryVm.CategoryId"
                                               onchange="toggleCategoryOptionalFields(@categoryVm.CategoryId)">
                                        <label class="form-check-label" for="isOptional-@categoryVm.CategoryId">是否為選擇性分類</label>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3 optional-settings mb-3" style="display:none;">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold text-secondary">群組編號</label>
                                            <input type="number" class="form-control category-group-no" value="1" min="1" />
                                            <small class="form-text text-muted">將「選擇性」餐點分組，顧客只能從同群組中選擇。</small>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold text-secondary">選取上限</label>
                                            <input type="number" class="form-control category-pick-limit" value="1" min="1" />
                                            <small class="form-text text-muted">顧客從此群組中，最多能選擇的餐點數量。</small>
                                        </div>
                                    </div>
                                    <div class="dish-selection-rows"></div>
                                    <button type="button" class="btn btn-outline-primary btn-sm add-dish-to-category mt-3"
                                            data-category-id="@categoryVm.CategoryId">
                                        <i class="fas fa-plus me-1"></i>新增餐點
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cropper Modal -->
<div class="modal fade" id="cropperModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-white border-bottom py-3">
                <h5 class="modal-title fw-bold text-dark"><i class="fas fa-crop-alt me-2 text-primary"></i>裁切圖片</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0 bg-light">
                <div class="img-container" style="height: 500px; width: 100%;">
                    <img id="cropperImage" src="" style="max-width: 100%;">
                </div>
            </div>
            <div class="modal-footer bg-white border-top-0 py-3">
                <button type="button" class="btn btn-outline-secondary border-0" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary px-5 shadow-sm rounded-pill" onclick="confirmCrop()">
                    確認裁切
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
    <style>
        #imageArea:hover {
            border-color: var(--bs-primary) !important;
            background-color: #f0f7ff !important;
        }

            #imageArea:hover #placeholderContent i {
                transform: translateY(-5px);
                transition: transform 0.3s ease;
            }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <script>
        let cropper = null;
        let originalFile = null;

        function updateDiscountLabel() {
            const type = document.getElementById("DiscountType").value;
            document.getElementById("discountLabel").innerHTML =
                type === "percent"
                    ? '折扣值（%） <span class="text-danger">*</span>'
                    : '折扣值（元） <span class="text-danger">*</span>';
        }

        function handleFileSelect(input) {
            if (!input.files || !input.files[0]) return;
            openCropper(input.files[0]);
        }

        function openCropper(file) {
            originalFile = file;
            const reader = new FileReader();
            reader.onload = e => {
                const img = document.getElementById("cropperImage");
                img.src = e.target.result;
                const modal = new bootstrap.Modal(document.getElementById("cropperModal"));
                modal.show();

                document.getElementById("cropperModal").addEventListener("shown.bs.modal", () => {
                    if (cropper) cropper.destroy();
                    cropper = new Cropper(img, {
                        aspectRatio: 4 / 3,
                        viewMode: 1,
                        autoCropArea: 1
                    });
                }, { once: true });
            };
            reader.readAsDataURL(originalFile);
        }

        function confirmCrop() {
            if (!cropper) return;
            const canvas = cropper.getCroppedCanvas({ width: 800, height: 600 });
            const base64 = canvas.toDataURL("image/jpeg", 0.9);

            document.getElementById("croppedImageData").value = base64;

            const previewImg = document.getElementById("previewImg");
            previewImg.src = base64;
            previewImg.style.display = "block";
            document.getElementById("placeholderContent").style.display = "none";
            document.getElementById("editBadge").style.display = "block";

            bootstrap.Modal.getInstance(document.getElementById("cropperModal")).hide();
            cropper.destroy();
            cropper = null;
        }

        const area = document.getElementById('imageArea');
        area.addEventListener('dragover', (e) => { e.preventDefault(); area.classList.add('border-primary'); });
        area.addEventListener('dragleave', () => { area.classList.remove('border-primary'); });
        area.addEventListener('drop', (e) => {
            e.preventDefault();
            area.classList.remove('border-primary');
            if (e.dataTransfer.files && e.dataTransfer.files[0]) openCropper(e.dataTransfer.files[0]);
        });

        // ===== 套餐包含餐點 =====
        const categoriesWithDishes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.CategoriesWithDishes.Select(c => new {
                categoryId   = c.CategoryId,
                categoryName = c.CategoryName,
                dishesInThisCategory = c.DishesInThisCategory.Select(d => new {
                    value = d.Value,
                    text  = d.Text
                }).ToList()
            }).ToList()
        ));

        function getCategorySelectOptions(categoryId) {
            const cat = categoriesWithDishes.find(c => c.categoryId == categoryId);
            if (!cat || !cat.dishesInThisCategory) return '';
            let html = '<option value="" data-price="0">請選擇餐點</option>';
            cat.dishesInThisCategory.forEach(dish => {
                const m = dish.text.match(/\$(\d+(\.\d+)?)/);
                const price = m ? m[1] : 0;
                html += `<option value="${dish.value}" data-price="${price}">${dish.text}</option>`;
            });
            return html;
        }

        function renderDishSelectionRow(categoryId, initialItem = null) {
            const opts         = getCategorySelectOptions(categoryId);
            const dishId       = initialItem ? initialItem.dishId       : '';
            const quantity     = initialItem ? initialItem.quantity      : 1;
            const displayOrder = initialItem ? initialItem.displayOrder  : 1;
            return `
                <div class="row g-3 mb-2 dish-selection-row align-items-end" data-dish-id="${dishId}">
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-secondary">餐點</label>
                        <select class="form-select dish-id-select">${opts}</select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary">數量</label>
                        <input type="number" class="form-control dish-quantity" value="${quantity}" min="1" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary">順序</label>
                        <input type="number" class="form-control dish-display-order" value="${displayOrder}" min="1" />
                    </div>
                    <div class="col-md-3 text-end">
                        <button type="button" class="btn btn-outline-danger btn-sm remove-dish-from-category">移除</button>
                    </div>
                </div>`;
        }

        function toggleCategoryOptionalFields(categoryId) {
            const slot    = document.querySelector(`.category-slot[data-category-id="${categoryId}"]`);
            const toggle  = slot.querySelector('.is-optional-toggle');
            const setting = slot.querySelector('.optional-settings');
            setting.style.display = toggle.checked ? '' : 'none';
        }

        function collectItems() {
            const items = [];
            document.querySelectorAll('.category-slot').forEach(slot => {
                const isOptional = slot.querySelector('.is-optional-toggle').checked;
                const groupNo    = isOptional ? parseInt(slot.querySelector('.category-group-no').value)   : null;
                const pickLimit  = isOptional ? parseInt(slot.querySelector('.category-pick-limit').value) : null;
                slot.querySelectorAll('.dish-selection-row').forEach(row => {
                    const dishId       = parseInt(row.querySelector('.dish-id-select').value);
                    const quantity     = parseInt(row.querySelector('.dish-quantity').value);
                    const displayOrder = parseInt(row.querySelector('.dish-display-order').value);
                    if (!isNaN(dishId) && dishId > 0) {
                        items.push({
                            DishId: dishId,
                            Quantity: quantity,
                            IsOptional: isOptional,
                            OptionGroupNo: isOptional ? groupNo    : null,
                            PickLimit:     isOptional ? pickLimit  : null,
                            DisplayOrder: displayOrder
                        });
                    }
                });
            });
            return items;
        }

        document.addEventListener('DOMContentLoaded', function () {
            // 新增餐點按鈕
            document.querySelectorAll('.add-dish-to-category').forEach(btn => {
                btn.addEventListener('click', function () {
                    const catId     = this.dataset.categoryId;
                    const slot      = document.querySelector(`.category-slot[data-category-id="${catId}"]`);
                    const container = slot.querySelector('.dish-selection-rows');
                    container.insertAdjacentHTML('beforeend', renderDishSelectionRow(catId));
                });
            });

            // 移除餐點（事件委派）
            document.getElementById('category-slots-container').addEventListener('click', function (e) {
                if (e.target.classList.contains('remove-dish-from-category')) {
                    e.target.closest('.dish-selection-row').remove();
                }
            });

            // 表單提交前收集餐點，寫入 hidden input
            document.getElementById('createForm').addEventListener('submit', function () {
                document.getElementById('itemsJson').value = JSON.stringify(collectItems());
            });
        });
    </script>
}
