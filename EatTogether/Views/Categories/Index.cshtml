@model IEnumerable<EatTogether.Models.ViewModels.CategoryViewModel>
@{
    ViewData["Title"] = "分類管理";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">分類管理</h1>

    <!-- 統計卡片 -->
    <div style="display:flex; gap:16px; margin-bottom:1.5rem;">

        <div style="flex:1; background:#3b82f6; color:white; border-radius:10px;
                padding:16px 20px; display:flex; align-items:center;
                justify-content:space-between; cursor:pointer;"
             onclick="filterByStatus('')" title="點擊顯示所有分類">
            <div>
                <div style="font-size:11px; font-weight:600; opacity:0.75;
                        text-transform:uppercase; letter-spacing:.05em;">總分類數</div>
                <div style="font-size:2rem; font-weight:700; margin-top:4px;">@Model.Count()</div>
            </div>
            <i class="fas fa-tags fa-2x" style="opacity:0.4;"></i>
        </div>

        <div style="flex:1; background:#22c55e; color:white; border-radius:10px;
                padding:16px 20px; display:flex; align-items:center;
                justify-content:space-between; cursor:pointer;"
             onclick="filterByStatus('上架')" title="點擊篩選上架中分類">
            <div>
                <div style="font-size:11px; font-weight:600; opacity:0.75;
                        text-transform:uppercase; letter-spacing:.05em;">上架中</div>
                <div style="font-size:2rem; font-weight:700; margin-top:4px;">@Model.Count(c => c.IsActive)</div>
            </div>
            <i class="fas fa-check-circle fa-2x" style="opacity:0.4;"></i>
        </div>

        <div style="flex:1; background:#9ca3af; color:white; border-radius:10px;
                padding:16px 20px; display:flex; align-items:center;
                justify-content:space-between; cursor:pointer;"
             onclick="filterByStatus('下架')" title="點擊篩選已下架分類">
            <div>
                <div style="font-size:11px; font-weight:600; opacity:0.75;
                        text-transform:uppercase; letter-spacing:.05em;">已下架</div>
                <div style="font-size:2rem; font-weight:700; margin-top:4px;">@Model.Count(c => !c.IsActive)</div>
            </div>
            <i class="fas fa-ban fa-2x" style="opacity:0.4;"></i>
        </div>

    </div>

    <div id="alertBox"></div>

    <!-- 搜尋與篩選區 -->
    <div style="display:flex; align-items:center; gap:8px; margin-bottom:0.75rem; padding:0.75rem; background:#f9fafb; border-radius:8px; border:1px solid #e5e7eb;">
        <div style="display:flex; align-items:center; flex:1; gap:8px; background:#fff; border:1px solid #e5e7eb; border-radius:6px; padding:5px 10px; min-width:0;">
            <i class="fas fa-search text-muted" style="font-size:0.85rem; flex-shrink:0;"></i>
            <input type="text" id="searchInput" class="form-control form-control-sm border-0 p-0 shadow-none"
                   placeholder="搜尋分類名稱..." oninput="filterCards()" />
        </div>
        <select id="statusFilter" class="form-select form-select-sm" onchange="filterCards()" style="width:auto; min-width:90px; flex-shrink:0;">
            <option value="">所有狀態</option>
            <option value="上架">上架中</option>
            <option value="下架">已下架</option>
        </select>
        <button id="toggleSortBtn" class="btn btn-outline-secondary btn-sm" onclick="toggleSortMode()" style="flex-shrink:0; white-space:nowrap;">
            <i class="fas fa-arrows-alt me-1"></i>調整排序
        </button>
        <button type="button" class="btn btn-primary btn-sm" style="flex-shrink:0; white-space:nowrap;"
                data-bs-toggle="modal" data-bs-target="#createCategoryModal">
            <i class="fas fa-plus me-1"></i>新增分類
        </button>
    </div>

    <!-- 批次操作列 -->
    <div id="batchBar" class="alert alert-info border-0 shadow-sm d-none mb-3 d-flex align-items-center gap-3 flex-wrap" role="alert">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="selectAllCheck" onchange="toggleSelectAll(this.checked)">
            <label class="form-check-label fw-bold" for="selectAllCheck">全選</label>
        </div>
        <span class="text-muted">已選 <strong id="selectedCount">0</strong> 筆</span>
        <div class="ms-auto d-flex gap-2 flex-wrap">
            <button class="btn btn-sm btn-outline-success rounded-pill px-3" onclick="batchEnable()">
                <i class="fas fa-check-circle me-1"></i>批次上架
            </button>
            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="batchDisable()">
                <i class="fas fa-power-off me-1"></i>批次下架
            </button>
            <button class="btn btn-sm btn-danger rounded-pill px-3" onclick="batchDelete()">
                <i class="fas fa-trash me-1"></i>批次刪除
            </button>
            <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="exitBatchMode()">取消</button>
        </div>
    </div>

    <!-- 排序模式提示列 -->
    <div id="sortModeBar" class="alert alert-warning border-0 shadow-sm d-none mb-3 d-flex align-items-center gap-3" role="alert">
        <i class="fas fa-info-circle fa-lg"></i>
        <div><strong>排序模式已開啟</strong>：請拖曳列調整順序，完成後點擊右側儲存按鈕。</div>
        <div class="ms-auto d-flex gap-2">
            <button class="btn btn-sm btn-primary rounded-pill px-4 shadow-sm" onclick="saveOrder()">
                <i class="fas fa-save me-1"></i>儲存排序
            </button>
            <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="toggleSortMode()">取消</button>
        </div>
    </div>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body p-0">

            <!-- 操作模式切換按鈕 -->
            <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom bg-gray-50">
                <small class="text-muted">
                    <i class="fas fa-info-circle me-1"></i>
                    <span>點擊列表可查看分類詳情；點擊「批次操作」可多選大量變更</span>
                </small>
                <button id="batchModeBtn" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="enterBatchMode()">
                    <i class="fas fa-tasks me-1"></i>批次操作
                </button>
            </div>

            <!-- Master-Detail 左右分割 -->
            <div style="display:flex; min-height:600px;">

                <!-- ===== 左側：列表面板 ===== -->
                <div style="width:42%; border-right:1px solid #e5e7eb; display:flex; flex-direction:column; min-width:0;">

                    <div style="overflow-x:auto; flex:1;">
                        <table style="width:100%; table-layout:fixed; border-collapse:collapse;" class="text-sm text-left">
                            <colgroup>
                                <col style="width:28px;" />
                                <col style="width:28px;" />
                                <col style="width:68px;" />
                                <col />
                                <col style="width:52px;" />
                                <col style="width:95px;" />
                            </colgroup>
                            <thead>
                                <tr style="background:#f9fafb; border-bottom:1px solid #e5e7eb;">
                                    <th style="padding:8px 6px;"></th>
                                    <th style="padding:8px 6px;"></th>
                                    <th style="padding:8px 10px; font-size:11px; color:#6b7280; font-weight:500;">縮圖</th>
                                    <th style="padding:8px 10px; font-size:11px; color:#6b7280; font-weight:500;">分類名稱</th>
                                    <th style="padding:8px 10px; font-size:11px; color:#6b7280; font-weight:500; text-align:center;">餐點</th>
                                    <th style="padding:8px 10px; font-size:11px; color:#6b7280; font-weight:500; text-align:center;">狀態</th>
                                </tr>
                            </thead>
                            <tbody id="category-card-container">
                                @foreach (var item in Model)
                                {
                                    <tr class="category-card cat-row"
                                        data-id="@item.Id"
                                        data-name="@item.CategoryName.ToLower()"
                                        data-full-name="@item.CategoryName"
                                        data-order="@item.DisplayOrder"
                                        data-is-active="@item.IsActive.ToString().ToLower()"
                                        data-image="@(item.ImageUrl ?? "")"
                                        data-parent-name="@(item.ParentCategoryName ?? "")"
                                        data-parent-id="@(item.ParentCategoryId?.ToString() ?? "")"
                                        data-status="@(item.IsActive ? "上架" : "下架")"
                                        onclick="selectItem(this)">

                                        <!-- 拖曳把手 -->
                                        <td style="padding:8px 6px; text-align:center;">
                                            <div class="drag-handle text-gray-400" style="cursor:move;">
                                                <i class="fas fa-grip-vertical text-xs"></i>
                                            </div>
                                        </td>

                                        <!-- 批次勾選框 -->
                                        <td style="padding:8px 6px; text-align:center;">
                                            <div class="batch-check">
                                                <input class="card-checkbox form-check-input" type="checkbox"
                                                       data-id="@item.Id" onchange="updateSelectedCount()">
                                            </div>
                                        </td>

                                        <!-- 縮圖 -->
                                        <td style="padding:8px 10px;">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl"
                                                     style="width:44px; height:44px; object-fit:cover; border-radius:6px;"
                                                     alt="@item.CategoryName"
                                                     onerror="this.src='/images/no-image.png'; this.onerror=null;" />
                                            }
                                            else
                                            {
                                                <div style="width:44px; height:44px; border-radius:6px; background:#f3f4f6; display:flex; align-items:center; justify-content:center; color:#d1d5db;">
                                                    <i class="fas fa-tags text-xs"></i>
                                                </div>
                                            }
                                        </td>

                                        <!-- 名稱 + 上層分類 -->
                                        <td style="padding:8px 10px; max-width:160px;">
                                            <div style="font-weight:600; font-size:13px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@item.CategoryName</div>
                                            @if (!string.IsNullOrEmpty(item.ParentCategoryName))
                                            {
                                                <div style="font-size:11px; color:#9ca3af; margin-top:2px;">
                                                    <i class="fas fa-level-up-alt" style="font-size:10px; margin-right:3px;"></i>@item.ParentCategoryName
                                                </div>
                                            }
                                        </td>

                                        <!-- 餐點數量 -->
                                        <td style="padding:8px 10px; text-align:center;">
                                            <span id="dish-count-@item.Id" style="font-size:12px; color:#6b7280;">—</span>
                                        </td>

                                        <!-- 狀態 badge -->
                                        <td style="padding:8px 10px; text-align:center;">
                                            <span class="badge rounded-pill @(item.IsActive ? "bg-success-subtle text-success border-success" : "bg-secondary-subtle text-secondary border-secondary") border px-2"
                                                  id="active-badge-@item.Id" style="font-size:0.65rem; cursor:pointer;"
                                                  onclick="event.stopPropagation(); toggleCategoryActive(@item.Id)">
                                                @(item.IsActive ? "上架" : "下架")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-tags fa-2x mb-2 opacity-25"></i>
                            <p class="text-sm">目前尚無分類資料</p>
                        </div>
                    }

                    <!-- 分頁控制 -->
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:8px 12px; border-top:1px solid #f3f4f6; background:#f9fafb;">
                        <div class="text-xs text-gray-500" id="pageInfo"></div>
                        <nav>
                            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                        </nav>
                    </div>
                </div>

                <!-- ===== 右側：詳情面板 ===== -->
                <div style="width:58%; overflow-y:auto;">
                    <div style="position:sticky; top:0; max-height:calc(100vh - 220px); overflow-y:auto;">

                        <!-- 空白提示（預設顯示） -->
                        <div id="detailEmpty"
                             style="display:flex; flex-direction:column; align-items:center;
                                    justify-content:center; height:100%; min-height:500px;
                                    color:#9ca3af;">
                            <i class="fas fa-tags" style="font-size:2rem; margin-bottom:12px; opacity:0.3;"></i>
                            <p style="font-size:14px; margin:0;">請從左側選取一個分類</p>
                            <p style="font-size:12px; margin:4px 0 0; color:#d1d5db;">點擊任一列即可查看詳情</p>
                        </div>

                        <!-- 詳情內容（預設隱藏） -->
                        <div id="detailContent" style="display:none; padding:1.25rem;">

                            <!-- 縮圖 + 名稱 + badges -->
                            <div style="display:flex; gap:16px; align-items:flex-start; margin-bottom:16px;">
                                <img id="detailImg" src="" alt=""
                                     style="width:120px; height:120px; object-fit:cover; border-radius:10px; flex-shrink:0; display:none;"
                                     onerror="this.style.display='none'; document.getElementById('detailNoImg').style.display='flex';" />
                                <div id="detailNoImg"
                                     style="width:120px; height:120px; border-radius:10px; background:#f3f4f6;
                                            display:flex; align-items:center; justify-content:center; color:#d1d5db; flex-shrink:0;">
                                    <i class="fas fa-tags fa-2x"></i>
                                </div>
                                <div style="flex:1; min-width:0;">
                                    <h2 id="detailName" style="font-size:1.25rem; font-weight:700; margin-bottom:8px;"></h2>
                                    <div id="detailBadges" style="display:flex; gap:6px; flex-wrap:wrap;"></div>
                                </div>
                            </div>

                            <!-- 資訊卡格 2x2 -->
                            <div class="mb-3" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                                <div class="bg-gray-50 rounded-lg p-3">
                                    <div class="text-xs text-gray-400 mb-1">排序</div>
                                    <div class="font-medium text-gray-700" id="detail-order">—</div>
                                </div>
                                <div class="bg-gray-50 rounded-lg p-3">
                                    <div class="text-xs text-gray-400 mb-1">餐點數量</div>
                                    <div class="font-medium text-gray-700" id="detail-dish-count">—</div>
                                </div>
                                <div class="bg-gray-50 rounded-lg p-3">
                                    <div class="text-xs text-gray-400 mb-1">上層分類</div>
                                    <div class="font-medium text-gray-700" id="detail-parent">—</div>
                                </div>
                                <div class="bg-gray-50 rounded-lg p-3">
                                    <div class="text-xs text-gray-400 mb-1">建立時間</div>
                                    <div class="font-medium text-gray-700" id="detail-created">—</div>
                                </div>
                            </div>

                            <!-- 上架 Toggle -->
                            <div class="bg-gray-50 rounded-lg mb-3" style="display:flex; align-items:center; justify-content:space-between; padding:1rem;">
                                <div>
                                    <div class="font-semibold text-gray-700 text-sm">上架狀態</div>
                                    <div id="detailActiveLabel" class="text-xs text-gray-500 mt-0.5"></div>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="detailActiveToggle" onchange="detailCategoryToggleActive()">
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>

                            <!-- 操作按鈕 -->
                            <div style="display:flex; gap:12px;">
                                <button id="detailEditBtn" class="btn btn-warning fw-bold shadow-sm" style="flex:1;" onclick="openEditModalFromDetail()">
                                    <i class="fas fa-edit me-1"></i>編輯分類
                                </button>
                                <button id="detailDisableBtn" class="btn btn-outline-danger px-4" onclick="detailDisableAction()">
                                    <i class="fas fa-power-off me-1"></i><span id="detailDisableText">下架</span>
                                </button>
                            </div>

                            <!-- 餐點列表 -->
                            <div class="mt-3 bg-gray-50 rounded-lg p-3">
                                <div class="fw-semibold mb-2" style="font-size:13px; color:#374151;">
                                    <i class="fas fa-utensils me-1 text-primary"></i>餐點列表
                                </div>
                                <div id="detail-dish-list" style="max-height:220px; overflow-y:auto;"></div>
                            </div>

                        </div>
                    </div>
                </div>

            </div><!-- end master-detail -->

        </div>
    </div>
</div>

<!-- ===== 查看分類餐點 Modal ===== -->
<div class="modal fade" id="viewCategoryDishesModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-utensils me-2 text-primary"></i>
                    <span id="viewCategoryName"></span> 的餐點內容
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="catDetailImageWrap" class="mb-4 d-none">
                    <img id="catDetailImage" src="" alt="分類圖片"
                         class="w-100 rounded-3 shadow-sm"
                         style="max-height:200px; object-fit:cover;"
                         onerror="this.closest('#catDetailImageWrap').classList.add('d-none')" />
                </div>
                <div id="catDetailMeta" class="mb-3 p-3 bg-light rounded-3 small text-center"></div>
                <div id="viewCategoryDishesList"></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     新增分類 Modal
═══════════════════════════════════════ -->
<div class="modal fade" id="createCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="fas fa-plus me-2"></i>新增分類</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="mb-3">
                            <label class="form-label fw-bold">分類名稱 <span class="text-danger">*</span></label>
                            <input type="text" id="create_CategoryName" class="form-control shadow-sm" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">上層分類</label>
                            <select id="create_ParentCategoryId" class="form-select shadow-sm">
                                @foreach (var opt in ViewBag.ParentCategoryOptions)
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">排序</label>
                            <input type="number" id="create_DisplayOrder" class="form-control shadow-sm" value="0" min="0" max="999">
                        </div>
                        <div class="mb-3">
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" id="create_IsActive" checked>
                                <label class="form-check-label fw-bold text-muted" for="create_IsActive">是否啟用</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5 border-start border-light-subtle">
                        <label class="form-label fw-bold d-block mb-2">分類圖片</label>
                        <div id="create_imageArea"
                             class="border rounded-4 bg-light overflow-hidden shadow-sm d-flex align-items-center justify-content-center mb-2 position-relative"
                             style="aspect-ratio:4/3; cursor:pointer;">
                            <div id="create_placeholder" class="text-center">
                                <i class="fas fa-cloud-upload-alt fa-2x text-primary mb-2"></i>
                                <p class="text-secondary small mb-0">點擊或拖曳上傳圖片</p>
                                <small class="text-muted">建議比例 4:3</small>
                            </div>
                            <img id="create_previewImg" src="" class="w-100 h-100 d-none" style="object-fit:cover;"
                                 onerror="this.classList.add('d-none'); document.getElementById('create_placeholder').classList.remove('d-none')" />
                            <div id="create_editBadge" class="position-absolute bottom-0 end-0 p-2 d-none">
                                <span class="badge bg-dark bg-opacity-75 p-2 rounded-circle shadow-sm">
                                    <i class="fas fa-pencil-alt"></i>
                                </span>
                            </div>
                        </div>
                        <input type="file" id="create_imageInput" class="d-none" accept="image/*"
                               onchange="handleFileSelect(this, 'create')" />
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 rounded-pill mt-1"
                                id="create_clearBtn" style="display:none;" onclick="clearImage('create')">
                            <i class="fas fa-times me-1"></i>移除圖片
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-warning px-4 rounded-pill" onclick="submitCreate()">
                    <i class="fas fa-plus me-1"></i>確認新增
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     編輯分類 Modal
═══════════════════════════════════════ -->
<div class="modal fade" id="editCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i>編輯分類</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit_Id">
                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="mb-3">
                            <label class="form-label fw-bold">分類名稱 <span class="text-danger">*</span></label>
                            <input type="text" id="edit_CategoryName" class="form-control shadow-sm" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">上層分類</label>
                            <select id="edit_ParentCategoryId" class="form-select shadow-sm">
                                @foreach (var opt in ViewBag.ParentCategoryOptions)
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">排序</label>
                            <input type="number" id="edit_DisplayOrder" class="form-control shadow-sm" min="1" max="999">
                        </div>
                        <div class="mb-3">
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" id="edit_IsActive">
                                <label class="form-check-label fw-bold text-muted" for="edit_IsActive">是否啟用</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5 border-start border-light-subtle">
                        <label class="form-label fw-bold d-block mb-2">分類圖片</label>
                        <div id="edit_imageArea"
                             class="border rounded-4 bg-light overflow-hidden shadow-sm d-flex align-items-center justify-content-center mb-2 position-relative"
                             style="aspect-ratio:4/3; cursor:pointer;"
                             onclick="document.getElementById('edit_imageInput').click()">
                            <div id="edit_placeholder" class="text-center">
                                <i class="fas fa-cloud-upload-alt fa-2x text-primary mb-2"></i>
                                <p class="text-secondary small mb-0">點擊或拖曳上傳圖片</p>
                                <small class="text-muted">建議比例 4:3</small>
                            </div>
                            <img id="edit_previewImg" src="" class="w-100 h-100 d-none" style="object-fit:cover;"
                                 onerror="this.classList.add('d-none'); document.getElementById('edit_placeholder').classList.remove('d-none')" />
                            <div id="edit_editBadge" class="position-absolute bottom-0 end-0 p-2 d-none">
                                <span class="badge bg-dark bg-opacity-75 p-2 rounded-circle shadow-sm">
                                    <i class="fas fa-pencil-alt"></i>
                                </span>
                            </div>
                        </div>
                        <input type="file" id="edit_imageInput" class="d-none" accept="image/*"
                               onchange="handleFileSelect(this, 'edit')" />
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 rounded-pill mt-1"
                                id="edit_clearBtn" style="display:none;" onclick="clearImage('edit')">
                            <i class="fas fa-times me-1"></i>移除圖片
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-warning px-4 rounded-pill" onclick="submitEdit()">
                    <i class="fas fa-save me-1"></i>儲存變更
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     Cropper Modal（共用）
═══════════════════════════════════════ -->
<div class="modal fade" id="cropperModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-white border-bottom py-3">
                <h5 class="modal-title fw-bold"><i class="fas fa-crop-alt me-2 text-primary"></i>裁切圖片</h5>
                <button type="button" class="btn-close" onclick="cancelCrop()"></button>
            </div>
            <div class="modal-body p-0 bg-light">
                <div style="height:420px; width:100%;">
                    <img id="cropperImage" src="" style="max-width:100%;">
                </div>
            </div>
            <div class="modal-footer bg-white border-0 py-3">
                <button type="button" class="btn btn-outline-secondary border-0" onclick="cancelCrop()">取消</button>
                <button type="button" class="btn btn-primary px-5 shadow-sm rounded-pill" onclick="confirmCrop()">確認裁切</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
    <style>
        .stat-card {
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

        /* 列表 row */
        .cat-row {
            border-left: 2px solid transparent;
            cursor: pointer;
            transition: background 0.1s, border-color 0.1s;
        }
        .cat-row:hover { background-color: #f9fafb; }
        .cat-row.active-row {
            border-left: 2px solid #3b82f6 !important;
            background-color: #eff6ff !important;
        }

        /* 拖曳把手 & 批次勾選：預設隱藏 */
        .drag-handle { display: none; }
        .batch-check { display: none; }

        /* 批次模式 */
        #category-card-container.batch-mode .batch-check { display: block !important; }
        #category-card-container.batch-mode .category-card { cursor: pointer; }
        #category-card-container.batch-mode .category-card.selected {
            background-color: rgba(13,110,253,.06) !important;
            outline: 2px solid #0d6efd;
            outline-offset: -2px;
        }
        .card-checkbox { width: 1.1em; height: 1.1em; cursor: pointer; }

        /* 排序模式 */
        #category-card-container.sort-mode .drag-handle { display: block !important; }
        #category-card-container.sort-mode .category-card { border-left: 2px dashed #ffc107 !important; }
        .sortable-ghost { opacity: 0.4; background: #fff3cd !important; }
        .sortable-chosen { box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.15) !important; }

        /* 分頁 */
        .page-link { cursor: pointer; color: #495057; border-radius: 4px !important; margin: 0 2px; }
        .pagination .page-item.active .page-link { background-color: #0d6efd; border-color: #0d6efd; color: #fff; }

        .badge { font-weight: 600; font-size: 0.68rem; }

        /* 純 CSS Toggle Switch */
        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 48px;
            height: 26px;
            flex-shrink: 0;
        }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .toggle-slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: #d1d5db;
            border-radius: 26px;
            transition: background-color 0.25s;
        }
        .toggle-slider::before {
            content: "";
            position: absolute;
            width: 20px;
            height: 20px;
            left: 3px;
            bottom: 3px;
            background-color: #fff;
            border-radius: 50%;
            transition: transform 0.25s;
            box-shadow: 0 1px 3px rgba(0,0,0,.2);
        }
        .toggle-switch input:checked + .toggle-slider { background-color: #22c55e; }
        .toggle-switch input:checked + .toggle-slider::before { transform: translateX(22px); }

        #create_imageArea:hover, #edit_imageArea:hover {
            border-color: var(--bs-primary) !important;
            background-color: #f0f7ff !important;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <script>
        const PAGE_SIZE = 12;
        let currentPage   = 1;
        let filteredCards = [];
        let sortableInstance = null;
        let isSortMode  = false;
        let isBatchMode = false;
        let selectedCategoryId = null;

        const allCategories = @Html.Raw(ViewBag.CategoriesJson);

        document.addEventListener("DOMContentLoaded", () => {
            // 填入餐點數量（僅上架中），設為可點擊
            allCategories.forEach(cat => {
                const el = document.getElementById(`dish-count-${cat.id}`);
                if (el) {
                    el.textContent = cat.dishCount;
                    el.style.cursor = 'pointer';
                    el.style.color = '#3b82f6';
                    el.style.textDecoration = 'underline';
                    el.onclick = (e) => { e.stopPropagation(); showDishesModal(cat.id); };
                }
            });

            filteredCards = Array.from(document.querySelectorAll(".category-card"));
            filteredCards.sort((a, b) => parseInt(a.dataset.order) - parseInt(b.dataset.order));
            renderPage();
        });

        /* ===== Master-Detail: 選取分類 ===== */
        function selectItem(row) {
            if (isBatchMode) return;

            document.querySelectorAll('.cat-row').forEach(r => r.classList.remove('active-row'));
            row.classList.add('active-row');

            selectedCategoryId = parseInt(row.dataset.id);
            const d = row.dataset;
            const isActive = d.isActive === 'true';

            // 圖片
            const img   = document.getElementById('detailImg');
            const noImg = document.getElementById('detailNoImg');
            if (d.image) {
                img.src = d.image;
                img.style.display = 'block';
                noImg.style.display = 'none';
            } else {
                img.style.display = 'none';
                noImg.style.display = 'flex';
            }

            // 名稱
            document.getElementById('detailName').textContent = d.fullName;

            // 排序 / 上層分類
            document.getElementById('detail-order').textContent  = '# ' + d.order;
            document.getElementById('detail-parent').textContent = d.parentName || '無';
            document.getElementById('detail-created').textContent = '—';

            // 餐點數量（從 allCategories）
            const cat = allCategories.find(c => c.id === selectedCategoryId);
            document.getElementById('detail-dish-count').textContent = cat ? cat.dishCount + ' 道' : '—';

            // 餐點列表
            const dishListEl = document.getElementById('detail-dish-list');
            if (cat && cat.dishes && cat.dishes.length > 0) {
                dishListEl.innerHTML = cat.dishes.map(d => `
                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom" style="font-size:12px;">
                        <div>
                            <span class="badge me-1 rounded-pill border ${d.isActive ? 'bg-success-subtle text-success border-success' : 'bg-secondary-subtle text-secondary border-secondary'}" style="font-size:0.6rem;">${d.isActive ? '上架' : '下架'}</span>
                            <span class="fw-semibold">${d.dishName}</span>
                        </div>
                        <span class="text-muted">$${d.price}</span>
                    </div>`).join('');
            } else {
                dishListEl.innerHTML = '<p class="text-muted text-center py-2 small">此分類尚無餐點</p>';
            }

            // 上架 Toggle
            const toggle = document.getElementById('detailActiveToggle');
            toggle.checked = isActive;
            document.getElementById('detailActiveLabel').textContent = isActive ? '目前上架中' : '目前已下架';

            // 下架/上架 按鈕
            document.getElementById('detailDisableText').textContent = isActive ? '下架' : '上架';
            document.getElementById('detailDisableBtn').className = isActive
                ? 'btn btn-outline-danger px-4'
                : 'btn btn-outline-success px-4';

            // Badges（上層分類）
            const badgesEl = document.getElementById('detailBadges');
            badgesEl.innerHTML = '';
            if (d.parentName) {
                badgesEl.innerHTML = `<span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary px-2"><i class="fas fa-level-up-alt me-1"></i>${d.parentName}</span>`;
            }

            document.getElementById('detailEmpty').style.display   = 'none';
            document.getElementById('detailContent').style.display = 'block';
        }

        function openEditModalFromDetail() {
            if (!selectedCategoryId) return;
            const row = document.querySelector(`.cat-row[data-id="${selectedCategoryId}"]`);
            if (!row) return;
            openEditModal(
                selectedCategoryId,
                row.dataset.fullName,
                row.dataset.parentId || '',
                parseInt(row.dataset.order),
                row.dataset.isActive === 'true',
                row.dataset.image || ''
            );
        }

        function detailCategoryToggleActive() {
            if (!selectedCategoryId) return;
            const toggle = document.getElementById('detailActiveToggle');
            if (toggle.checked) enableCategory(selectedCategoryId);
            else disableCategory(selectedCategoryId);
        }

        function detailDisableAction() {
            if (!selectedCategoryId) return;
            const toggle = document.getElementById('detailActiveToggle');
            if (toggle.checked) disableCategory(selectedCategoryId);
            else enableCategory(selectedCategoryId);
        }

        function toggleCategoryActive(id) {
            const badge = document.getElementById('active-badge-' + id);
            const isActive = badge && badge.textContent.trim() === '上架';
            if (isActive) disableCategory(id);
            else enableCategory(id);
        }

        /* ===== 篩選 ===== */
        function filterCards() {
            const search = document.getElementById("searchInput").value.toLowerCase();
            const status = document.getElementById("statusFilter").value;

            filteredCards = Array.from(document.querySelectorAll(".category-card")).filter(card => {
                const matchSearch = !search || card.dataset.name.includes(search);
                const matchStatus = !status || card.dataset.status === status;
                return matchSearch && matchStatus;
            });
            filteredCards.sort((a, b) => parseInt(b.dataset.id) - parseInt(a.dataset.id));
            currentPage = 1;
            renderPage();
        }

        function filterByStatus(status) {
            document.getElementById("statusFilter").value = status;
            filterCards();
            document.getElementById("category-card-container").scrollIntoView({ behavior: 'smooth', block: 'start' });
            showAlert("info", `已篩選：${status || "所有"} 分類`);
        }

        function clearFilter() {
            document.getElementById("searchInput").value = "";
            document.getElementById("statusFilter").value = "";
            filterCards();
        }

        /* ===== 分頁 ===== */
        function renderPage() {
            const allCards = Array.from(document.querySelectorAll(".category-card"));
            allCards.forEach(c => c.style.display = "none");

            const total      = filteredCards.length;
            const totalPages = Math.ceil(total / PAGE_SIZE) || 1;
            if (currentPage > totalPages) currentPage = totalPages;

            const start = (currentPage - 1) * PAGE_SIZE;
            const end   = start + PAGE_SIZE;
            const container = document.getElementById("category-card-container");
            filteredCards.slice(start, end).forEach(c => {
                c.style.display = "";
                container.appendChild(c);
            });

            document.getElementById("pageInfo").textContent =
                `${total} 筆，顯示 ${Math.min(start + 1, total)}–${Math.min(end, total)}`;

            renderPaginationButtons("pagination", totalPages);

            const paginationContainer = document.getElementById("pagination")?.parentElement?.parentElement;
            if (paginationContainer) {
                paginationContainer.classList.toggle("d-none", totalPages <= 1);
            }
        }

        function renderPaginationButtons(elementId, totalPages) {
            const container = document.getElementById(elementId);
            container.innerHTML = "";

            const prevLi = document.createElement("li");
            prevLi.className = `page-item ${currentPage === 1 ? "disabled" : ""}`;
            prevLi.innerHTML = `<a class="page-link shadow-none" onclick="goToPage(${currentPage - 1})"><i class="fas fa-chevron-left"></i></a>`;
            container.appendChild(prevLi);

            for (let i = 1; i <= totalPages; i++) {
                const li = document.createElement("li");
                li.className = `page-item ${i === currentPage ? "active" : ""}`;
                li.innerHTML = `<a class="page-link shadow-none" onclick="goToPage(${i})">${i}</a>`;
                container.appendChild(li);
            }

            const nextLi = document.createElement("li");
            nextLi.className = `page-item ${currentPage === totalPages ? "disabled" : ""}`;
            nextLi.innerHTML = `<a class="page-link shadow-none" onclick="goToPage(${currentPage + 1})"><i class="fas fa-chevron-right"></i></a>`;
            container.appendChild(nextLi);
        }

        function goToPage(page) {
            const totalPages = Math.ceil(filteredCards.length / PAGE_SIZE) || 1;
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            renderPage();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        /* ===== 排序拖曳 ===== */
        function toggleSortMode() {
            if (isBatchMode) exitBatchMode();
            isSortMode = !isSortMode;
            const container = document.getElementById("category-card-container");
            const bar = document.getElementById("sortModeBar");
            const btn = document.getElementById("toggleSortBtn");

            if (isSortMode) {
                container.classList.add("sort-mode");
                bar.classList.remove("d-none");
                btn.classList.replace("btn-outline-secondary", "btn-warning");
                btn.innerHTML = '<i class="fas fa-times me-1"></i>取消排序';
                sortableInstance = Sortable.create(container, {
                    animation: 180,
                    ghostClass: "sortable-ghost",
                    chosenClass: "sortable-chosen",
                    handle: ".drag-handle",
                    draggable: ".category-card",
                    onEnd() {
                        document.querySelectorAll(".category-card").forEach((c, i) => c.dataset.order = i + 1);
                    }
                });
            } else {
                container.classList.remove("sort-mode");
                bar.classList.add("d-none");
                btn.classList.replace("btn-warning", "btn-outline-secondary");
                btn.innerHTML = '<i class="fas fa-arrows-alt me-1"></i>調整排序';
                if (sortableInstance) { sortableInstance.destroy(); sortableInstance = null; }
            }
        }

        async function saveOrder() {
            const ids = Array.from(document.querySelectorAll(".category-card")).map(c => parseInt(c.dataset.id));
            try {
                const res = await fetch("/Categories/UpdateOrder", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ orderedIds: ids })
                });
                if (res.ok) { showAlert("success", "排序已儲存 ✓"); setTimeout(() => location.reload(), 1000); }
                else showAlert("danger", "儲存失敗，請稍後再試");
            } catch { showAlert("danger", "發生錯誤，請稍後再試"); }
        }

        /* ===== 批次操作 ===== */
        function enterBatchMode() {
            if (isSortMode) toggleSortMode();
            isBatchMode = true;
            document.getElementById("category-card-container").classList.add("batch-mode");
            document.getElementById("batchBar").classList.remove("d-none");
            document.getElementById("batchModeBtn").classList.add("d-none");
            document.querySelectorAll(".category-card").forEach(card => card.addEventListener("click", onCardClick));
        }

        function exitBatchMode() {
            isBatchMode = false;
            document.getElementById("category-card-container").classList.remove("batch-mode");
            document.getElementById("batchBar").classList.add("d-none");
            document.getElementById("batchModeBtn").classList.remove("d-none");
            document.getElementById("selectAllCheck").checked = false;
            document.querySelectorAll(".card-checkbox").forEach(cb => cb.checked = false);
            document.querySelectorAll(".category-card.selected").forEach(c => c.classList.remove("selected"));
            document.getElementById("selectedCount").textContent = "0";
            document.querySelectorAll(".category-card").forEach(card => card.removeEventListener("click", onCardClick));
        }

        function onCardClick(e) {
            if (e.target.closest("a, button")) return;
            const cb = this.querySelector(".card-checkbox");
            cb.checked = !cb.checked;
            this.classList.toggle("selected", cb.checked);
            updateSelectedCount();
        }

        function toggleSelectAll(checked) {
            document.querySelectorAll(".category-card").forEach(card => {
                if (card.style.display === "none") return;
                const cb = card.querySelector(".card-checkbox");
                cb.checked = checked;
                card.classList.toggle("selected", checked);
            });
            updateSelectedCount();
        }

        function updateSelectedCount() {
            const count = document.querySelectorAll(".card-checkbox:checked").length;
            document.getElementById("selectedCount").textContent = count;
            const visibleCbs = Array.from(document.querySelectorAll(".category-card:not([style*='display: none']) .card-checkbox"));
            document.getElementById("selectAllCheck").checked = visibleCbs.length > 0 && visibleCbs.every(cb => cb.checked);
        }

        function getSelectedIds() {
            return Array.from(document.querySelectorAll(".card-checkbox:checked")).map(cb => parseInt(cb.dataset.id));
        }

        async function batchOperation(url, confirmMsg) {
            const ids = getSelectedIds();
            if (ids.length === 0) { showAlert("warning", "請先勾選項目"); return; }
            if (!confirm(confirmMsg)) return;
            const res = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ ids })
            });
            if (res.ok) { showAlert("success", "操作成功"); setTimeout(() => location.reload(), 1000); }
            else showAlert("danger", "操作失敗，請稍後再試");
        }

        function batchEnable()  { batchOperation("/Categories/BatchEnable",  "確定要上架所選分類嗎？"); }
        function batchDisable() { batchOperation("/Categories/BatchDisable", "確定要下架所選分類嗎？"); }
        function batchDelete()  { batchOperation("/Categories/BatchDelete",  "⚠️ 確定要永久刪除嗎？此操作無法還原！"); }

        /* ===== 單筆操作 ===== */
        async function disableCategory(id) {
            if (!confirm("確定要下架嗎？")) return;
            const res = await fetch(`/Categories/Disable/${id}`, { method: "POST" });
            if (res.ok) { showAlert("success", "已下架"); setTimeout(() => location.reload(), 1000); }
            else showAlert("danger", "操作失敗");
        }

        async function enableCategory(id) {
            if (!confirm("確定要上架嗎？")) return;
            const res = await fetch(`/Categories/Enable/${id}`, { method: "POST" });
            if (res.ok) { showAlert("success", "已上架"); setTimeout(() => location.reload(), 1000); }
            else showAlert("danger", "操作失敗");
        }

        /* ===== 餐點 Modal ===== */
        function showDishesModal(categoryId) {
            const cat = allCategories.find(c => c.id === categoryId);
            if (!cat) return;

            document.getElementById('viewCategoryName').textContent = cat.categoryName;

            const imgWrap = document.getElementById('catDetailImageWrap');
            const img     = document.getElementById('catDetailImage');
            if (cat.imageUrl) { img.src = cat.imageUrl; imgWrap.classList.remove('d-none'); }
            else imgWrap.classList.add('d-none');

            const total  = cat.dishes ? cat.dishes.length : 0;
            document.getElementById('catDetailMeta').innerHTML =
                `共 <strong>${total}</strong> 道餐點，其中 <strong>${cat.dishCount}</strong> 道上架中`;

            const listEl = document.getElementById('viewCategoryDishesList');
            if (total === 0) {
                listEl.innerHTML = '<p class="text-muted text-center py-3">此分類尚無餐點</p>';
            } else {
                listEl.innerHTML = cat.dishes.map(d => `
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <span class="badge me-2 rounded-pill border ${d.isActive ? 'bg-success-subtle text-success border-success' : 'bg-secondary-subtle text-secondary border-secondary'}" style="font-size:0.65rem;">${d.isActive ? '上架' : '下架'}</span>
                            <span class="fw-semibold" style="font-size:14px;">${d.dishName}</span>
                        </div>
                        <span class="text-muted fw-semibold">$${d.price}</span>
                    </div>`).join('');
            }

            new bootstrap.Modal(document.getElementById('viewCategoryDishesModal')).show();
        }

        /* ===== Alert ===== */
        function showAlert(type, message) {
            const box = document.getElementById("alertBox");
            box.innerHTML = `
                <div class="alert alert-${type} alert-dismissible border-0 shadow-sm fade show" role="alert">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`;
            setTimeout(() => {
                const el = box.querySelector(".alert");
                if (el) { el.classList.remove("show"); setTimeout(() => box.innerHTML = "", 400); }
            }, 3000);
        }

        /* ===== 圖片裁切（新增 / 編輯共用）===== */
        let cropper       = null;
        let activePanelId = null;
        let croppedBase64 = { create: null, edit: null };

        ['create', 'edit'].forEach(panel => {
            const area = document.getElementById(`${panel}_imageArea`);
            if (!area) return;
            area.addEventListener('dragover', e => { e.preventDefault(); area.classList.add('border-primary'); });
            area.addEventListener('dragleave', () => area.classList.remove('border-primary'));
            area.addEventListener('drop', e => {
                e.preventDefault();
                area.classList.remove('border-primary');
                if (e.dataTransfer.files[0]) {
                    const reader = new FileReader();
                    reader.onload = evt => openCropperWithUrl(evt.target.result, panel);
                    reader.readAsDataURL(e.dataTransfer.files[0]);
                }
            });
        });

        function editOrUploadCategoryImage() {
            const previewImg = document.getElementById("edit_previewImg");
            if (!previewImg.classList.contains('d-none') && previewImg.src.startsWith('data:image')) {
                openCropperWithUrl(previewImg.src, 'edit');
            } else {
                document.getElementById('edit_imageInput').click();
            }
        }

        document.getElementById('edit_imageArea').onclick = editOrUploadCategoryImage;

        function handleFileSelect(input, panel) {
            if (!input.files || !input.files[0]) return;
            const reader = new FileReader();
            reader.onload = e => openCropperWithUrl(e.target.result, panel);
            reader.readAsDataURL(input.files[0]);
            input.value = "";
        }

        function openCropperWithUrl(url, panel) {
            activePanelId = panel;
            const img = document.getElementById("cropperImage");
            img.src = url;
            const cropModal = new bootstrap.Modal(document.getElementById("cropperModal"));
            cropModal.show();
            document.getElementById("cropperModal").addEventListener("shown.bs.modal", () => {
                if (cropper) cropper.destroy();
                cropper = new Cropper(img, { aspectRatio: 4/3, viewMode: 1, autoCropArea: 1 });
            }, { once: true });
        }

        function confirmCrop() {
            if (!cropper) return;
            const base64 = cropper.getCroppedCanvas({ width: 800, height: 600 }).toDataURL("image/jpeg", 0.9);
            croppedBase64[activePanelId] = base64;

            const previewImg  = document.getElementById(`${activePanelId}_previewImg`);
            const placeholder = document.getElementById(`${activePanelId}_placeholder`);
            const editBadge   = document.getElementById(`${activePanelId}_editBadge`);
            const clearBtn    = document.getElementById(`${activePanelId}_clearBtn`);

            previewImg.src = base64;
            previewImg.classList.remove("d-none");
            placeholder.classList.add("d-none");
            editBadge.classList.remove("d-none");
            clearBtn.style.display = "";

            bootstrap.Modal.getInstance(document.getElementById("cropperModal")).hide();
            if (cropper) { cropper.destroy(); cropper = null; }
        }

        function cancelCrop() {
            const cropModalEl = document.getElementById("cropperModal");
            if (cropModalEl) {
                const modalInstance = bootstrap.Modal.getInstance(cropModalEl);
                if (modalInstance) modalInstance.hide();
            }
            if (cropper) { cropper.destroy(); cropper = null; }
        }

        function clearImage(panel) {
            croppedBase64[panel] = null;
            const previewImg = document.getElementById(`${panel}_previewImg`);
            previewImg.src = "";
            previewImg.classList.add("d-none");
            document.getElementById(`${panel}_placeholder`).classList.remove("d-none");
            document.getElementById(`${panel}_editBadge`).classList.add("d-none");
            document.getElementById(`${panel}_clearBtn`).style.display = "none";
        }

        /* ===== 新增 Modal ===== */
        document.getElementById("createCategoryModal").addEventListener("hidden.bs.modal", () => {
            clearImage('create');
            document.getElementById("create_CategoryName").value = "";
            document.getElementById("create_DisplayOrder").value = "0";
        });

        async function submitCreate() {
            const name = document.getElementById("create_CategoryName").value.trim();
            if (!name) { showAlert("warning", "請輸入分類名稱"); return; }

            let imageUrl = null;
            if (croppedBase64.create) {
                imageUrl = await uploadImage(croppedBase64.create, name);
                if (!imageUrl) return;
            }

            const res = await fetch("/Categories/Create", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    CategoryName:     name,
                    ParentCategoryId: document.getElementById("create_ParentCategoryId").value
                                        ? parseInt(document.getElementById("create_ParentCategoryId").value) : null,
                    DisplayOrder:     parseInt(document.getElementById("create_DisplayOrder").value),
                    IsActive:         document.getElementById("create_IsActive").checked,
                    ImageUrl:         imageUrl
                })
            });
            if (res.ok) { location.reload(); }
            else showAlert("danger", "新增失敗，請稍後再試");
        }

        /* ===== 編輯 Modal ===== */
        function openEditModal(id, name, parentId, order, isActive, imageUrl) {
            document.getElementById("edit_Id").value               = id;
            document.getElementById("edit_CategoryName").value     = name;
            document.getElementById("edit_ParentCategoryId").value = parentId || "";
            document.getElementById("edit_DisplayOrder").value     = order;
            document.getElementById("edit_IsActive").checked       = isActive;
            croppedBase64.edit = null;

            const previewImg  = document.getElementById("edit_previewImg");
            const placeholder = document.getElementById("edit_placeholder");
            const editBadge   = document.getElementById("edit_editBadge");
            const clearBtn    = document.getElementById("edit_clearBtn");

            if (imageUrl && imageUrl.trim() !== '') {
                previewImg.src = imageUrl;
                previewImg.classList.remove("d-none");
                placeholder.classList.add("d-none");
                editBadge.classList.remove("d-none");
                clearBtn.style.display = "";
            } else {
                clearImage('edit');
            }

            new bootstrap.Modal(document.getElementById("editCategoryModal")).show();
        }

        async function submitEdit() {
            const id   = document.getElementById("edit_Id").value;
            const name = document.getElementById("edit_CategoryName").value.trim();
            if (!name) { showAlert("warning", "請輸入分類名稱"); return; }

            const previewImg = document.getElementById("edit_previewImg");
            let imageUrl = (previewImg.classList.contains("d-none") || !previewImg.src) ? null : previewImg.src;

            if (croppedBase64.edit) {
                imageUrl = await uploadImage(croppedBase64.edit, name);
                if (!imageUrl) return;
            }

            if (imageUrl && imageUrl.startsWith("http")) {
                try { imageUrl = new URL(imageUrl).pathname; }
                catch(e) { console.error("URL 解析失敗:", e); }
            }

            const res = await fetch(`/Categories/Edit/${id}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    Id:               parseInt(id),
                    CategoryName:     name,
                    ParentCategoryId: document.getElementById("edit_ParentCategoryId").value
                                        ? parseInt(document.getElementById("edit_ParentCategoryId").value) : null,
                    DisplayOrder:     parseInt(document.getElementById("edit_DisplayOrder").value),
                    IsActive:         document.getElementById("edit_IsActive").checked,
                    ImageUrl:         imageUrl
                })
            });
            if (res.ok) { location.reload(); }
            else showAlert("danger", "儲存失敗，請稍後再試");
        }

        /* ===== 圖片上傳 API ===== */
        async function uploadImage(base64Data, categoryName) {
            try {
                const res = await fetch("/Categories/UploadImage", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ Base64Data: base64Data, CategoryName: categoryName })
                });
                if (!res.ok) {
                    const err = await res.json();
                    showAlert("danger", "圖片上傳失敗: " + (err.message || "未知錯誤"));
                    return null;
                }
                return (await res.json()).imageUrl;
            } catch (e) {
                showAlert("danger", "圖片上傳發生錯誤: " + e.message);
                return null;
            }
        }
    </script>
}
